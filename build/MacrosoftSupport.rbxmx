		},
	}),
	P({
		id = "polite_pushover",
		name = "Painfully Polite Caller",
		tier = "Easy",
		blurb = "Too well mannered to hang up on anybody, ever.",
		ageRange = { 25, 65 },
		techRange = { 2, 5 },
		base = { trust = 28, suspicion = 8, patience = 95 },
		mods = { trustMul = 1.2, suspicionMul = 0.8, patienceDrain = 0.4 },
		likes = { professional = 1.4, empathy = 1.4, reassuring = 1.3 },
		dislikes = { aggressive = 2.5, absurd = 1.3 },
		quirks = {},
		reward = 0.95,
		voice = {
			greet = { "Oh, hello, sorry — yes?", "Sorry to be a bother, but who's calling?" },
			question = { "Sorry, could I just ask — is that normal?", "I don't mean to be difficult, but..." },
			believe = { "Oh gosh, thank you for letting me know.", "That's so kind of you to check." },
			nervous = { "Oh dear, sorry, I'm a bit lost.", "Sorry, I'm getting flustered." },
			angry = { "That was — well, that was quite rude, sorry.", "I'd rather you didn't shout, sorry." },
			laugh = { "Haha, sorry, that's quite good.", "Oh, ha, yes." },
			hangup = { "I'm terribly sorry, I have to go. Sorry!", "Sorry — my partner says to hang up. Sorry!" },
			accuse = { "Sorry — this isn't a scam, is it? Sorry.", "I hate to ask, but is this legitimate?" },
			pretend = { "Yes, sorry, doing that now.", "Of course, one moment, sorry." },
			waste = { "Sorry, the cat's on the keyboard.", "Sorry, one second, someone's at the door." },
		},
	}),

	----------------------------------------------------------------------------
	-- NORMAL TIER
	----------------------------------------------------------------------------
	P({
		id = "busy_parent",
		name = "Busy Parent",
		tier = "Normal",
		blurb = "Three children in the background and forty seconds of patience.",
		ageRange = { 28, 48 },
		techRange = { 3, 6 },
		base = { trust = 15, suspicion = 18, patience = 45 },
		mods = { trustMul = 1.0, suspicionMul = 1.1, patienceDrain = 1.6 },
