<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="Folder" referent="RBX86">
		<Properties>
			<string name="Name">MacrosoftSupport</string>
		</Properties>
		<Item class="Folder" referent="RBX58">
			<Properties>
				<string name="Name">MacrosoftShared</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX45">
				<Properties>
					<string name="Name">Achievements</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Achievements
-- Each achievement has a `check(data, context)` predicate. AchievementManager
-- runs every unearned achievement after each call and after each purchase.
--
-- context fields (may be nil outside of a call):
--   outcome        "success" | "hangup" | "exposed" | "bored" | "abandoned"
--   stage          stage index the call ended on
--   npc            the generated NPC table
--   trust, suspicion, patience, duration
--   perfect        boolean, no choice increased suspicion
--   reward         credits awarded

local Operation = require(game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared").Operation)

local Achievements = {}

Achievements.List = {
	{
		id = "hello_sir",
		name = "Hello Sir",
		blurb = "Complete your first call, either way.",
		reward = 100,
		check = function(data)
			return (data.stats.successfulCalls + data.stats.failedCalls) >= 1
		end,
	},
	{
		id = "do_not_redeem",
		name = "DO NOT REDEEM",
		blurb = "Lose a call during the final stage.",
		reward = 250,
		check = function(_, ctx)
			return ctx ~= nil and ctx.outcome ~= "success" and ctx.stage ~= nil and ctx.stage >= 7
		end,
	},
	{
		id = "professional_time_waster",
		name = "Professional Time Waster",
		blurb = "Spend ten minutes on one call and walk away with nothing.",
		reward = 400,
		check = function(_, ctx)
			return ctx ~= nil and ctx.outcome ~= "success" and (ctx.duration or 0) >= 600
		end,
	},
	{
		id = "wrong_number",
		name = "Wrong Number",
		blurb = "Accidentally call another fictional call centre.",
		reward = 300,
		check = function(_, ctx)
			return ctx ~= nil and ctx.npc ~= nil and ctx.npc.personalityId == "rival_centre"
		end,
	},
	{
		id = "cybersecurity_expert",
		name = "Cybersecurity Expert",
		blurb = "Get exposed within the first two stages by a tech-savvy caller.",
		reward = 250,
		check = function(_, ctx)
			return ctx ~= nil
				and ctx.outcome == "exposed"
				and (ctx.stage or 99) <= 2
				and ctx.npc ~= nil
				and ctx.npc.techKnowledge >= 7
		end,
	},
	{
		id = "first_blood",
		name = "Sir, You Have Won",
		blurb = "Complete your first successful call.",
		reward = 200,
		check = function(data)
			return data.stats.successfulCalls >= 1
		end,
	},
	{
		id = "flawless",
		name = "Laminated Perfection",
		blurb = "Finish a call without a single choice raising suspicion.",
		reward = 500,
		check = function(_, ctx)
			return ctx ~= nil and ctx.outcome == "success" and ctx.perfect == true
		end,
	},
	{
		id = "speed_demon",
		name = "Two Minutes Flat",
		blurb = "Succeed on a call in under 120 seconds.",
		reward = 400,
		check = function(_, ctx)
			return ctx ~= nil and ctx.outcome == "success" and (ctx.duration or 999) <= 120
		end,
	},
	{
		id = "nightmare_fuel",
		name = "Against All Odds",
		blurb = "Succeed on Nightmare difficulty.",
		reward = 2500,
		check = function(_, ctx)
			return ctx ~= nil and ctx.outcome == "success" and ctx.difficulty == "Nightmare"
		end,
	},
	{
		id = "police_line",
		name = "You've Called A Police Station",
		blurb = "Discover the one number you should not have dialled.",
		reward = 500,
		check = function(_, ctx)
			return ctx ~= nil and ctx.npc ~= nil and ctx.npc.personalityId == "police_desk"
		end,
	},
	{
		id = "baited",
		name = "Content Creator",
		blurb = "Get strung along by a scambaiter for the entire call.",
		reward = 600,
		check = function(_, ctx)
			return ctx ~= nil and ctx.npc ~= nil and ctx.npc.personalityId == "scambaiter" and ctx.outcome ~= "success"
		end,
	},
	{
		id = "shouted_down",
		name = "JUST DO WHAT I SAY",
		blurb = "Lose a call by shouting at a caller.",
		reward = 150,
		check = function(_, ctx)
			return ctx ~= nil and ctx.outcome ~= "success" and (ctx.aggressiveChoices or 0) >= 3
		end,
	},
	{
		id = "veteran",
		name = "Employee Of The Month",
		blurb = "Complete 50 successful calls.",
		reward = 3000,
		check = function(data)
			return data.stats.successfulCalls >= 50
		end,
	},
	{
		id = "millionaire",
		name = "Suspicious Wealth",
		blurb = "Earn 100,000 Credits in total.",
		reward = 5000,
		check = function(data)
			return data.stats.lifetimeEarnings >= 100000
		end,
	},
	{
		id = "fully_furnished",
		name = "Interior Designer",
		blurb = "Own eight desk upgrades.",
		reward = 2000,
		check = function(data)
			local n = 0
			for _, owned in pairs(data.upgrades) do
				if owned then
					n += 1
				end
			end
			return n >= 8
		end,
	},
	{
		id = "ceo",
		name = "Scam Empire CEO",
		blurb = "Reach the highest rank.",
		reward = 10000,
		check = function(data)
			return data.rankIndex >= 9
		end,
	},
	{
		id = "grandson",
		name = "The Grandson Problem",
		blurb = "Lose a call to a relative walking into the room.",
		reward = 200,
		check = function(_, ctx)
			return ctx ~= nil and ctx.outcome ~= "success" and ctx.lastEventId == "grandson_arrives"
		end,
	},
	{
		id = "manager_please",
		name = "Let Me Speak To Your Manager",
		blurb = "Survive a caller demanding your supervisor.",
		reward = 350,
		check = function(_, ctx)
			return ctx ~= nil and ctx.outcome == "success" and ctx.survivedEvents ~= nil and ctx.survivedEvents["ask_for_manager"] == true
		end,
	},
	{
		id = "unlucky",
		name = "Statistically Improbable",
		blurb = "Fail ten calls in a row.",
		reward = 500,
		check = function(data)
			return (data.stats.failStreak or 0) >= 10
		end,
	},
	{
		id = "act_natural",
		name = "Everybody Act Natural",
		blurb = "Survive a police raid without losing anything.",
		reward = 1500,
		check = function(data)
			return (data.operation and data.operation.raidsSurvived or 0) >= 1
		end,
	},
	{
		id = "door_off_hinges",
		name = "That Door Was Load-Bearing",
		blurb = "Lose a raid. It happens to everyone once.",
		reward = 500,
		check = function(data)
			return (data.operation and data.operation.raidsLost or 0) >= 1
		end,
	},
	{
		id = "middle_management",
		name = "Middle Management",
		blurb = "Have twenty people on the payroll at once.",
		reward = 2000,
		check = function(data)
			local total = 0
			for _, count in pairs(data.operation and data.operation.staff or {}) do
				total += count
			end
			return total >= 20
		end,
	},
	{
		id = "sleeps_at_the_office",
		name = "It Runs Itself",
		blurb = "Earn 1,000,000 Credits in passive income.",
		reward = 5000,
		check = function(data)
			return (data.stats.passiveEarned or 0) >= 1000000
		end,
	},
	{
		id = "gone_legitimate",
		name = "Almost Legitimate",
		blurb = "Own every security upgrade at once.",
		reward = 4000,
		check = function(data)
			local security = data.operation and data.operation.security or {}
			local owned = 0
			for _, has in pairs(security) do
				if has then
					owned += 1
				end
			end
			return owned >= #Operation.Security
		end,
	},
	{
		id = "the_franchise",
		name = "Franchise Owner",
		blurb = "Run the top method tier.",
		reward = 10000,
		check = function(data)
			return data.operation ~= nil and data.operation.method == "franchise"
		end,
	},
	{
		id = "hold_music",
		name = "Hold Music Connoisseur",
		blurb = "Get put on hold five times across your career.",
		reward = 300,
		check = function(data)
			return (data.stats.timesOnHold or 0) >= 5
		end,
	},
}

Achievements.ById = {}
for _, a in ipairs(Achievements.List) do
	Achievements.ById[a.id] = a
end

return Achievements
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX46">
				<Properties>
					<string name="Name">Config</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Config
-- Central tuning module for Macrosoft Support (satirical call-centre game).
-- Everything here is fictional. No real company, product or process is referenced.

local Config = {}

Config.Version = "1.5.1"
Config.GameName = "Macrosoft Support: Call Centre Simulator"

Config.Currency = {
	Name = "Call Centre Credits",
	Short = "Credits",
	Symbol = "\u{20A1}", -- fictional credit symbol
}

Config.Call = {
	MaxTrust = 100,
	MaxSuspicion = 100,
	MaxPatience = 100,
	StartProgress = 0,
	-- Trust required at the final stage for the fictional call to succeed.
	TrustToSucceed = 65,
	-- Suspicion at which the NPC always hangs up.
	HangUpSuspicion = 100,
	-- Patience drains over time; at 0 the NPC gets bored and leaves.
	PatienceTickSeconds = 4,
	-- Hard ceiling so a call cannot run forever.
	MaxCallSeconds = 900,
	-- Fast-completion bonus window.
	FastCallSeconds = 120,
	-- How many situations the player must clear per stage before advancing.
	ProgressPerStage = 100,
	-- Maximum number of dialogue choices shown at once.
	MaxChoices = 4,

	-- Global balance knobs applied by NPCPersonalitySystem after personality and
	-- difficulty multipliers. Suspicion is scaled because a full call runs for
	-- roughly 14-18 exchanges and raw per-choice values would always reach 100.
	SuspicionScale = 0.45,
	-- Personality and difficulty suspicion multipliers are combined with a
	-- softening exponent so the hardest callers stay hard without becoming
	-- arithmetically unwinnable (0.7 => a raw 2.1x lands as 1.67x).
	SuspicionMultiplierSoftening = 0.7,
	TrustScale = 1.0,
	-- A line that lands really well calms the caller down a little.
	ReassureTrust = 9,
	ReassureAmount = 3.5,
}

Config.Stages = {
	{ id = 1, key = "Introduction", label = "Introduction" },
	{ id = 2, key = "Problem", label = "The Fictional Problem" },
	{ id = 3, key = "Trust", label = "Building Rapport" },
	{ id = 4, key = "Deflect", label = "Managing Suspicion" },
	{ id = 5, key = "Instructions", label = "Fictional Instructions" },
	{ id = 6, key = "Cards", label = "MegaMart Cards" },
	{ id = 7, key = "Final", label = "Final Decision" },
	{ id = 8, key = "Resolution", label = "Resolution" },
}

Config.StageCount = 7 -- stage 8 is the resolution screen, not playable

Config.DataStore = {
	Key = "MacrosoftCallCentre_PlayerData_v1",
	LeaderboardKey = "MacrosoftCallCentre_Leaderboard_v1",
	AutosaveSeconds = 120,
	MaxRetries = 4,
	RetryBaseDelay = 2,
	-- Set true in Studio if you have not enabled API services yet.
	StudioFallbackToMemory = true,
}

Config.Rewards = {
	TierBase = {
		Easy = { min = 50, max = 100 },
		Normal = { min = 100, max = 250 },
		Hard = { min = 250, max = 500 },
		Expert = { min = 500, max = 800 },
		Nightmare = { min = 1000, max = 1000 },
	},
	Bonuses = {
		LowSuspicion = { threshold = 20, mult = 0.30, label = "Cool Under Pressure" },
		HighTrust = { threshold = 85, mult = 0.25, label = "Trusted Advisor" },
		FastCall = { mult = 0.20, label = "Quick Talker" },
		PerfectRun = { mult = 0.50, label = "Flawless Script" },
		HardNPC = { mult = 0.15, label = "Tough Customer" },
		-- Consecutive wins. Capped so a streak is a reason to keep playing
		-- rather than the only thing that matters.
		Streak = { perCall = 0.08, max = 0.6, label = "Streak" },
	},
	-- Consolation credits for a failed call so progression never fully stalls.
	FailureConsolation = { min = 5, max = 20 },
}

Config.Events = {
	-- Base chance per situation that a random event fires instead of normal dialogue.
	BaseChance = 0.12,
	-- Minimum situations between two random events.
	Cooldown = 2,
}

Config.UI = {
	Theme = {
		Background = Color3.fromRGB(18, 20, 28),
		Panel = Color3.fromRGB(28, 31, 42),
		PanelLight = Color3.fromRGB(38, 42, 56),
		Accent = Color3.fromRGB(28, 189, 208),
		AccentDark = Color3.fromRGB(52, 96, 190),
		Trust = Color3.fromRGB(88, 214, 141),
		Suspicion = Color3.fromRGB(231, 91, 91),
		Patience = Color3.fromRGB(240, 189, 87),
		Text = Color3.fromRGB(238, 241, 248),
		SubText = Color3.fromRGB(158, 166, 184),
		Success = Color3.fromRGB(88, 214, 141),
		Danger = Color3.fromRGB(231, 91, 91),
		Gold = Color3.fromRGB(244, 203, 96),
	},
	TypewriterSpeed = 0.018, -- seconds per character
	TweenTime = 0.25,
}

-- Lighting and post-processing. Pulled out here because getting an indoor
-- Roblox room to read well is pure trial and error, and you should be able to
-- tune it in one file (or live -- see docs/TESTING.md) rather than hunting
-- through EnvironmentBuilder.
--
-- Two rules learned the hard way:
--   * Ambient does the work indoors. PointLights are accent only; a grid of
--     them at high brightness just washes everything to white.
--   * A Neon part renders at its own colour with full emission, so a near-white
--     Neon screen blooms into a shapeless blob. Neon wants a MID colour.
Config.Environment = {
	Ambient = Color3.fromRGB(120, 107, 139),
	OutdoorAmbient = Color3.fromRGB(94, 98, 116),
	Brightness = 2,
	ClockTime = 17.4,
	FogEnd = 500,

	-- Ceiling fixtures: all of them glow, a sparse grid actually casts light.
	CeilingLightColour = Color3.fromRGB(255, 218, 167),
	CeilingLightBrightness = 0.5,
	CeilingLightRange = 26,

	-- Monitors. Mid-blue, not white: this is what stops the blobbing.
	ScreenColour = Color3.fromRGB(58, 112, 178),
	-- Wall trim strips, dimmed so they read as trim and not as lasers.
	StripColourA = Color3.fromRGB(25, 199, 220),
	StripColourB = Color3.fromRGB(218, 57, 153),

	Bloom = { Intensity = 0.22, Size = 10, Threshold = 2 },
	Colour = { Saturation = 0.12, Contrast = 0.04, Brightness = 0.015 },
}

Config.Workstation = {
	-- Where the player's desk sits in the world (EnvironmentBuilder uses this).
	Origin = CFrame.new(0, 0, 0),
}

return Config
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX47">
				<Properties>
					<string name="Name">DialogueLibrary</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- DialogueLibrary
-- Every dialogue situation in the game, grouped by call stage.
--
-- IMPORTANT: all of this is deliberate nonsense. The "instructions" the player
-- gives are fictional (wizard windows, moon keys, imaginary store cards) so the
-- script cannot be lifted out of the game and used on a real person. Keep it
-- that way when adding content.
--
-- Situation fields:
--   id            unique string
--   stage         1..7 (see Config.Stages)
--   weight        relative pick weight (default 1)
--   prompt        array of NPC line variants
--   minLevel      minimum dialogue level (rank-gated situations)
--   personalities optional array of personality ids this situation is limited to
--   excludes      optional array of personality ids that never see it
--
-- Choice fields:
--   text      button label
--   tags      array of tag strings (see Personalities)
--   trust     base trust delta
--   suspicion base suspicion delta
--   patience  base patience delta
--   progress  stage progress delta (100 completes a stage)
--   minLevel  dialogue level required to select it (locked buttons below that)
--   note      short outcome hint shown after selection

local DialogueLibrary = {}

local S = {}

local function add(situation)
	table.insert(S, situation)
end

--------------------------------------------------------------------------------
-- STAGE 1 — INTRODUCTION
--------------------------------------------------------------------------------

add({
	id = "intro_why_calling",
	stage = 1,
	weight = 4,
	prompt = {
		"Why is Macrosoft calling me?",
		"Macrosoft? What do you want?",
		"Hang on — Macrosoft? Like the computer people?",
	},
	choices = {
		{ text = "We detected a serious problem with your computer.", tags = { "professional", "urgency" }, trust = 9, suspicion = 4, patience = 0, progress = 50 },
		{ text = "Your computer called us. It sounded upset.", tags = { "absurd", "humour" }, trust = 3, suspicion = 12, patience = 4, progress = 45 },
		{ text = "I'm actually not sure. Let me check my notes.", tags = { "honest" }, trust = 2, suspicion = 9, patience = -3, progress = 35 },
		{ text = "JUST LISTEN TO ME, SIR.", tags = { "aggressive" }, trust = -8, suspicion = 22, patience = -12, progress = 20 },
	},
})

add({
	id = "intro_who_is_this",
	stage = 1,
	weight = 4,
	prompt = {
		"Who is this exactly?",
		"Sorry, what was your name again?",
		"Right. And you are...?",
	},
	choices = {
		{ text = "My name is Kevin, I'm a senior technician at Macrosoft.", tags = { "professional", "authority" }, trust = 10, suspicion = 3, patience = 2, progress = 50 },
		{ text = "You can call me... Steve. Steve is fine. Steve.", tags = { "absurd", "humour" }, trust = 3, suspicion = 11, patience = 3, progress = 45 },
		{ text = "That's not important right now, sir.", tags = { "deflect", "authority" }, trust = -2, suspicion = 16, patience = -4, progress = 40 },
		{ text = "Honestly? I've had four names today.", tags = { "honest", "humour" }, trust = 4, suspicion = 14, patience = 6, progress = 40 },
	},
})

add({
	id = "intro_how_number",
	stage = 1,
	weight = 3,
	prompt = {
		"How did you get my number?",
		"Where did you get this number from?",
		"This is an unlisted number, actually.",
	},
	choices = {
		{ text = "It's registered to your Macrosoft licence, sir.", tags = { "professional", "technical" }, trust = 9, suspicion = 5, patience = 0, progress = 50 },
		{ text = "The computer gave it to us when it reported the fault.", tags = { "technical", "absurd" }, trust = 5, suspicion = 10, patience = 0, progress = 45 },
		{ text = "A friend of yours gave it to me. A close friend.", tags = { "absurd" }, trust = -3, suspicion = 20, patience = -5, progress = 35 },
		{ text = "I'd rather not say, sir.", tags = { "deflect" }, trust = -4, suspicion = 18, patience = -4, progress = 35 },
	},
})

add({
	id = "intro_bad_time",
	stage = 1,
	weight = 3,
	prompt = {
		"This is a really bad time.",
		"I'm in the middle of something.",
		"Can you call back later?",
	},
	choices = {
		{ text = "I understand completely — this will take two minutes.", tags = { "empathy", "reassuring" }, trust = 11, suspicion = 1, patience = 8, progress = 50 },
		{ text = "Sir, this cannot wait. Your files are at risk RIGHT NOW.", tags = { "urgency" }, trust = 5, suspicion = 12, patience = -6, progress = 50 },
		{ text = "Of course. What time suits you? ...Now? Perfect.", tags = { "humour", "professional" }, trust = 7, suspicion = 6, patience = 4, progress = 45 },
		{ text = "No. Stay on the line.", tags = { "aggressive", "authority" }, trust = -10, suspicion = 24, patience = -14, progress = 25 },
	},
})

add({
	id = "intro_already_called",
	stage = 1,
	weight = 2,
	prompt = {
		"You people called me last week as well.",
		"Didn't someone from your company already ring about this?",
		"Is this the same thing as last time?",
	},
	choices = {
		{ text = "Yes — and the problem has come back worse, I'm afraid.", tags = { "professional", "urgency" }, trust = 10, suspicion = 5, patience = 0, progress = 50 },
		{ text = "That was a different department. They're useless.", tags = { "humour", "deflect" }, trust = 6, suspicion = 9, patience = 3, progress = 45 },
		{ text = "No, that was definitely somebody else pretending to be us.", tags = { "honest", "reassuring" }, trust = 4, suspicion = 13, patience = 2, progress = 40 },
		{ text = "Sir, I have no record of a previous call, so it did not happen.", tags = { "authority" }, trust = -3, suspicion = 17, patience = -6, progress = 35 },
	},
})

add({
	id = "intro_hello_hello",
	stage = 1,
	weight = 2,
	prompt = {
		"Hello? Hello? I can't hear you very well.",
		"You sound like you're in a wind tunnel.",
		"There's an awful lot of noise on your end.",
	},
	choices = {
		{ text = "Apologies sir — our office is very busy today.", tags = { "professional", "reassuring" }, trust = 8, suspicion = 4, patience = 3, progress = 50 },
		{ text = "That's our new air conditioning. Very powerful.", tags = { "humour", "absurd" }, trust = 5, suspicion = 8, patience = 5, progress = 45 },
		{ text = "It's a large support centre, sir. Hundreds of technicians.", tags = { "professional", "authority" }, trust = 7, suspicion = 7, patience = 0, progress = 45 },
		{ text = "CAN YOU HEAR ME NOW? CAN YOU?", tags = { "aggressive" }, trust = -7, suspicion = 20, patience = -12, progress = 25 },
	},
})

add({
	id = "intro_expert_credentials",
	stage = 1,
	weight = 2,
	minLevel = 2,
	prompt = {
		"Give me your employee number and I'll verify it.",
		"What's your direct line? I'll call you back.",
		"Which office are you calling from?",
	},
	choices = {
		{ text = "Technician ID 44-B, Northern Support Hub. I'll hold while you check.", tags = { "professional", "technical" }, trust = 14, suspicion = 2, patience = 3, progress = 55, minLevel = 2 },
		{ text = "I'd love to give you that but our lines are outbound only, sir.", tags = { "professional", "deflect" }, trust = 6, suspicion = 10, patience = 0, progress = 45 },
		{ text = "Employee number... seven. Just seven.", tags = { "absurd" }, trust = 1, suspicion = 16, patience = 2, progress = 35 },
		{ text = "You don't need that. Let's move on.", tags = { "deflect", "authority" }, trust = -6, suspicion = 21, patience = -6, progress = 30 },
	},
})

add({
	id = "intro_streamer_hello",
	stage = 1,
	weight = 3,
	personalities = { "scambaiter", "prank_caller", "tech_teen", "bored_student" },
	prompt = {
		"Before we start — can you say hello to my friends?",
		"Quick thing: can you spell your name for the group chat?",
		"Sorry, can you repeat that into the good microphone?",
	},
	choices = {
		{ text = "Sir, I am not going to do that. Let's continue.", tags = { "professional" }, trust = 4, suspicion = 8, patience = -2, progress = 45 },
		{ text = "Hello, friends of the sir. It's Kevin.", tags = { "humour", "absurd" }, trust = 10, suspicion = 6, patience = 10, progress = 50 },
		{ text = "Are you recording this?", tags = { "honest" }, trust = 2, suspicion = 14, patience = 0, progress = 35 },
		{ text = "NO MORE GAMES, SIR.", tags = { "aggressive" }, trust = -9, suspicion = 22, patience = -10, progress = 20 },
	},
})

--------------------------------------------------------------------------------
-- STAGE 2 — THE FICTIONAL PROBLEM
--------------------------------------------------------------------------------

add({
	id = "problem_what_problem",
	stage = 2,
	weight = 4,
	prompt = {
		"What sort of problem are we talking about?",
		"What's actually wrong with it?",
