		mods = { trustMul = 0.72, suspicionMul = 1.08, patienceDrain = 0.25 },
		likes = { humour = 2.2, absurd = 2.1, flattery = 1.6, smalltalk = 1.3 },
		dislikes = { professional = 2.0, technical = 2.2, authority = 2.2, urgency = 1.8 },
