			accuse = { "Young man, this is a fraud.", "I recognise this from the parish newsletter." },
			pretend = { "I am doing as instructed. Continue.", "Very well. It is open." },
			waste = { "One moment — I'm writing this down verbatim.", "Slow down, I'm taking notes." },
		},
	}),
	P({
		id = "night_shift",
		name = "Night Shift Worker",
		tier = "Normal",
		blurb = "You woke them up. This is going badly already.",
		ageRange = { 24, 50 },
		techRange = { 3, 6 },
		base = { trust = 10, suspicion = 25, patience = 35 },
		mods = { trustMul = 0.9, suspicionMul = 1.2, patienceDrain = 1.8 },
		likes = { empathy = 1.6, honest = 1.4, reassuring = 1.2 },
		dislikes = { smalltalk = 1.9, urgency = 1.5, flattery = 1.5 },
		quirks = {},
