			laugh = { "Is that meant to be a joke?", "Ha. Sure." },
			hangup = { "I'm going to call my brother-in-law instead.", "No. No, I'm done. Bye." },
			accuse = { "This feels like one of those scams.", "I've seen this on the news." },
