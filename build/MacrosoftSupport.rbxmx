		dislikes = { smalltalk = 1.8, absurd = 1.5, patience = 1.3 },
		quirks = {},
		reward = 1.1,
		voice = {
			greet = { "Make it quick, I've got a toddler on the stairs.", "Yes? Hello? MAX, PUT THAT DOWN." },
			question = { "Is this going to take long?", "Right, and why does that matter?" },
			believe = { "Fine. Okay. What do I need to do?", "Alright, you've got two minutes." },
			nervous = { "Wait, is my laptop actually broken?", "Great. That's all I needed today." },
			angry = { "Do not shout at me. I have children for that.", "Absolutely not. Goodbye." },
			laugh = { "Ha. No.", "Very funny. Genuinely, no time." },
			hangup = { "Nope, dinner's on fire. Bye.", "Yeah, I'm hanging up." },
			accuse = { "This is a scam, isn't it.", "I've had four of these calls this week." },
			pretend = { "Yeah, yeah, it's open.", "Sure. Doing it. Mm-hm." },
			waste = { "Hang on — MAX. MAX. Sorry.", "One second, school just rang." },
		},
	}),
	P({
		id = "angry_customer",
		name = "Angry Customer",
