			"Sir, my supervisor says you must buy the cards.",
		},
		choices = {
			{ text = "Sir, I called YOU. Please open YOUR blue window.", tags = { "absurd", "humour" }, trust = 14, suspicion = 6, patience = 12, progress = 50 },
			{ text = "Are we... are we both doing this right now?", tags = { "honest", "humour" }, trust = 16, suspicion = 4, patience = 14, progress = 50 },
			{ text = "Let's both hang up at the same time. Three, two...", tags = { "humour", "honest" }, trust = 12, suspicion = 8, patience = 10, progress = 45 },
			{ text = "NO, SIR. YOU BUY THE CARDS.", tags = { "aggressive", "absurd" }, trust = -10, suspicion = 26, patience = -10, progress = 25 },
		},
	},
}

RandomEvents.ById = {}
for _, ev in ipairs(RandomEvents.List) do
	RandomEvents.ById[ev.id] = ev
end

function RandomEvents.count(): number
	return #RandomEvents.List
end

return RandomEvents
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX55">
				<Properties>
					<string name="Name">Ranks</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Ranks
-- Career progression. Ranks are earned from lifetime earnings and successful calls.

local Ranks = {}

Ranks.List = {
	{
		index = 1, id = "intern", name = "Intern",
		lifetime = 0, calls = 0,
		perks = { "Easy and Normal difficulty", "Basic dialogue options" },
		dialogueLevel = 1,
		rewardMul = 1.0,
	},
	{
		index = 2, id = "junior", name = "Junior Caller",
		lifetime = 1500, calls = 5,
		perks = { "Unlocks the Break Room", "+5% call rewards" },
		dialogueLevel = 1,
		rewardMul = 1.05,
	},
	{
		index = 3, id = "caller", name = "Caller",
		lifetime = 5000, calls = 15,
		perks = { "Unlocks Hard difficulty", "Unlocks advanced dialogue options" },
		dialogueLevel = 2,
		rewardMul = 1.10,
	},
	{
		index = 4, id = "senior", name = "Senior Caller",
		lifetime = 14000, calls = 30,
		perks = { "Unlocks the Senior Floor desks", "New NPC types" },
		dialogueLevel = 2,
		rewardMul = 1.15,
	},
	{
		index = 5, id = "leader", name = "Team Leader",
		lifetime = 32000, calls = 55,
		perks = { "Unlocks Expert difficulty", "Unlocks expert dialogue options" },
		dialogueLevel = 3,
		rewardMul = 1.22,
	},
	{
		index = 6, id = "floor", name = "Floor Manager",
		lifetime = 70000, calls = 90,
		perks = { "Unlocks the Manager's Office", "Cosmetic: clipboard" },
		dialogueLevel = 3,
		rewardMul = 1.30,
	},
	{
		index = 7, id = "operations", name = "Operations Manager",
		lifetime = 140000, calls = 140,
		perks = { "Unlocks Nightmare difficulty", "Unlocks legendary upgrades" },
		dialogueLevel = 4,
		rewardMul = 1.40,
	},
	{
		index = 8, id = "boss", name = "Call Centre Boss",
		lifetime = 300000, calls = 220,
		perks = { "Unlocks the Executive Floor", "Cosmetic: gold nameplate" },
		dialogueLevel = 4,
		rewardMul = 1.55,
	},
	{
		index = 9, id = "ceo", name = "Scam Empire CEO",
		lifetime = 750000, calls = 350,
		perks = { "Unlocks the Penthouse", "Cosmetic: absurd throne", "+80% call rewards" },
		dialogueLevel = 5,
		rewardMul = 1.80,
	},
}

Ranks.ById = {}
for _, rank in ipairs(Ranks.List) do
	Ranks.ById[rank.id] = rank
end

function Ranks.get(index: number)
	return Ranks.List[math.clamp(index, 1, #Ranks.List)]
end

-- Highest rank whose requirements the player meets.
function Ranks.evaluate(lifetimeEarnings: number, successfulCalls: number): number
	local best = 1
	for _, rank in ipairs(Ranks.List) do
		if lifetimeEarnings >= rank.lifetime and successfulCalls >= rank.calls then
			best = rank.index
		end
	end
	return best
end

function Ranks.next(index: number)
	return Ranks.List[index + 1]
end

return Ranks
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX56">
				<Properties>
					<string name="Name">Upgrades</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Upgrades
-- Purchasable desk upgrades. Effects are summed by UpgradeManager into a single
-- bonus table that CallManager reads at the start of every call.
--
-- Effect keys:
--   startTrust        flat trust the NPC begins with
--   startSuspicion    flat suspicion modifier (negative is good)
--   suspicionResist   multiplier applied to suspicion gains (0.95 = 5% less)
--   rewardMul         multiplier on call payouts
--   patienceBonus     flat patience added to every NPC
--   easyChance        added chance of rolling an easier personality tier
--   timeBonus         extra seconds before the fast-call bonus expires
--   eventResist       multiplier on random-event chance

local Upgrades = {}

Upgrades.List = {
	{
		id = "headset_cheap",
		name = "Cheap Headset",
		blurb = "The microphone crackles. Somehow this makes you sound official.",
		cost = 250,
		order = 1,
		requiresRank = 1,
		effects = { startTrust = 2 },
	},
	{
		id = "headset_pro",
		name = "Professional Headset",
		blurb = "Noise cancelling. The NPC can no longer hear forty other people lying.",
		cost = 1200,
		order = 2,
		requiresRank = 2,
		requires = "headset_cheap",
		effects = { startTrust = 5, suspicionResist = 0.96 },
	},
	{
		id = "computer_better",
		name = "Better Computer",
		blurb = "Boots in under nine minutes. Revolutionary.",
		cost = 2000,
		order = 3,
		requiresRank = 2,
		effects = { rewardMul = 0.05, timeBonus = 15 },
	},
	{
		id = "dialler_fast",
		name = "Faster Dialler",
		blurb = "Connects to a caller before you have finished panicking.",
		cost = 3200,
		order = 4,
		requiresRank = 3,
		effects = { timeBonus = 30, easyChance = 0.03 },
	},
	{
		id = "coffee_machine",
		name = "Coffee Machine",
		blurb = "You are now legally a different person.",
		cost = 4500,
		order = 5,
		requiresRank = 3,
		effects = { patienceBonus = 8, suspicionResist = 0.97 },
	},
	{
		id = "air_conditioning",
		name = "Air Conditioning",
		blurb = "Stops you sounding like you are calling from inside a kettle.",
		cost = 6500,
		order = 6,
		requiresRank = 3,
		effects = { suspicionResist = 0.94, patienceBonus = 5 },
	},
	{
		id = "chair_luxury",
		name = "Luxury Office Chair",
		blurb = "Lumbar support for a man with no moral support.",
		cost = 9000,
		order = 7,
		requiresRank = 4,
		effects = { patienceBonus = 10, startTrust = 3 },
	},
	{
		id = "monitors_multi",
		name = "Multiple Monitors",
		blurb = "Four screens. Three of them show a solitaire game.",
		cost = 13000,
		order = 8,
		requiresRank = 4,
		requires = "computer_better",
		effects = { rewardMul = 0.08, eventResist = 0.9 },
	},
	{
		id = "rgb_setup",
		name = "RGB Gaming Setup",
		blurb = "Adds no functional benefit. Adds every functional benefit.",
		cost = 18000,
		order = 9,
		requiresRank = 5,
		effects = { rewardMul = 0.06, startTrust = 4, easyChance = 0.04 },
	},
	{
		id = "desk_manager",
		name = "Manager's Desk",
		blurb = "Twice the width, half the legitimacy.",
		cost = 26000,
		order = 10,
		requiresRank = 6,
		effects = { startTrust = 6, suspicionResist = 0.92, rewardMul = 0.1 },
	},
	{
		id = "headset_golden",
		name = "Golden Headset",
		blurb = "Solid gold. Extremely heavy. Cannot be worn for more than ten minutes.",
		cost = 55000,
		order = 11,
		requiresRank = 7,
		requires = "headset_pro",
		effects = { startTrust = 10, rewardMul = 0.15, patienceBonus = 6 },
	},
	{
		id = "office_executive",
		name = "Executive Office",
		blurb = "Glass walls so everyone can watch you fail privately.",
		cost = 120000,
		order = 12,
		requiresRank = 8,
		requires = "desk_manager",
		effects = { startTrust = 8, suspicionResist = 0.88, rewardMul = 0.2, easyChance = 0.05 },
	},
	{
		id = "voice_changer",
		name = "Deluxe Voice Modulator",
		blurb = "Makes you sound like a man who owns a filing cabinet.",
		cost = 42000,
		order = 13,
		requiresRank = 7,
		effects = { suspicionResist = 0.9, startTrust = 5 },
	},
	{
		id = "call_script_binder",
		name = "Laminated Script Binder",
		blurb = "Entirely fictional. Mostly pictures of cats. Comforting anyway.",
		cost = 7500,
		order = 14,
		requiresRank = 4,
		effects = { startTrust = 4, eventResist = 0.92 },
	},
}

Upgrades.ById = {}
for _, up in ipairs(Upgrades.List) do
	Upgrades.ById[up.id] = up
end

Upgrades.DefaultBonuses = {
	startTrust = 0,
	startSuspicion = 0,
	suspicionResist = 1,
	rewardMul = 1,
	patienceBonus = 0,
	easyChance = 0,
	timeBonus = 0,
	eventResist = 1,
}

-- Sum a list of owned upgrade ids into one bonus table.
function Upgrades.aggregate(owned): { [string]: number }
	local bonuses = table.clone(Upgrades.DefaultBonuses)
	for id, isOwned in pairs(owned or {}) do
		if isOwned then
			local def = Upgrades.ById[id]
			if def then
				for key, value in pairs(def.effects) do
					if key == "suspicionResist" or key == "eventResist" then
						bonuses[key] *= value
					elseif key == "rewardMul" then
						bonuses[key] += value
					else
						bonuses[key] += value
					end
				end
			end
		end
	end
	return bonuses
end

-- Can this player buy it right now? Returns ok, reason.
function Upgrades.canPurchase(def, data): (boolean, string)
	if not def then
		return false, "Unknown upgrade."
	end
	if data.upgrades[def.id] then
		return false, "Already owned."
	end
	if def.requires and not data.upgrades[def.requires] then
		local prereq = Upgrades.ById[def.requires]
		return false, "Requires " .. (prereq and prereq.name or def.requires) .. "."
	end
	if data.rankIndex < (def.requiresRank or 1) then
		return false, "Rank too low."
	end
	if data.credits < def.cost then
		return false, "Not enough Credits."
	end
	return true, ""
end

return Upgrades
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX57">
				<Properties>
					<string name="Name">Util</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Util
-- Small shared helpers. No game logic lives here.

local Util = {}

local rng = Random.new(os.clock() * 1e6 % 2 ^ 31)

-- Reseeds the shared generator. Used by the headless simulator so a test run is
-- reproducible; never called by the game itself.
function Util.setSeed(seed: number)
	rng = Random.new(seed)
end

function Util.newRandom(seed: number?): Random
	if seed then
		return Random.new(seed)
	end
	return Random.new(rng:NextInteger(1, 2 ^ 30))
end

function Util.clamp(v: number, lo: number, hi: number): number
	if v < lo then
		return lo
	elseif v > hi then
		return hi
	end
	return v
end

function Util.round(v: number, places: number?): number
	local m = 10 ^ (places or 0)
	return math.floor(v * m + 0.5) / m
end

-- Pick a uniformly random element from an array.
function Util.pick(list, random: Random?)
	if #list == 0 then
		return nil
	end
	local r = random or rng
	return list[r:NextInteger(1, #list)]
end

-- Pick n distinct elements (returns fewer if the list is short).
function Util.pickMany(list, n: number, random: Random?)
	local r = random or rng
	local copy = table.clone(list)
	local out = {}
	for _ = 1, math.min(n, #copy) do
		local i = r:NextInteger(1, #copy)
		table.insert(out, copy[i])
		table.remove(copy, i)
	end
	return out
end

-- Weighted pick. `list` entries must expose a numeric `weight` (default 1).
function Util.weightedPick(list, random: Random?)
	local r = random or rng
	local total = 0
	for _, entry in ipairs(list) do
		total += entry.weight or 1
	end
	if total <= 0 then
		return nil
	end
	local roll = r:NextNumber() * total
	local acc = 0
	for _, entry in ipairs(list) do
		acc += entry.weight or 1
		if roll <= acc then
			return entry
		end
	end
	return list[#list]
end

function Util.shuffle(list, random: Random?)
	local r = random or rng
	for i = #list, 2, -1 do
		local j = r:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

function Util.deepCopy(value)
	if typeof(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in pairs(value) do
		out[k] = Util.deepCopy(v)
	end
	return out
end

function Util.contains(list, value): boolean
	for _, v in ipairs(list) do
		if v == value then
			return true
		end
	end
	return false
end

function Util.count(dict): number
	local n = 0
	for _ in pairs(dict) do
		n += 1
	end
	return n
end

function Util.formatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
end

function Util.formatNumber(n: number): string
	local formatted = tostring(math.floor(n))
	local k
	repeat
		formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
	until k == 0
	return formatted
end

-- Replace {tokens} in a string using a table of values.
function Util.interpolate(template: string, values): string
	return (string.gsub(template, "{(%w+)}", function(token)
		local v = values[token]
		if v == nil then
			return "{" .. token .. "}"
		end
		return tostring(v)
	end))
end

-- Merge `extra` into `base` (shallow), returning a new table.
function Util.merge(base, extra)
	local out = table.clone(base)
	for k, v in pairs(extra or {}) do
		out[k] = v
	end
	return out
end

return Util
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX79">
			<Properties>
				<string name="Name">MacrosoftServer</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX59">
				<Properties>
					<string name="Name">AchievementManager</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- AchievementManager
-- Runs every unearned achievement's predicate after calls and purchases.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared")
local Achievements = require(Shared.Achievements)

local PlayerDataManager = require(script.Parent.PlayerDataManager)

local AchievementManager = {}

AchievementManager.Unlocked = Instance.new("BindableEvent")

-- context may be nil (used for "career total" style achievements).
function AchievementManager.evaluate(player: Player, context)
	local data = PlayerDataManager.get(player)
	if not data then
		return {}
	end

	local newlyUnlocked = {}
	for _, achievement in ipairs(Achievements.List) do
		if not data.achievements[achievement.id] then
			local ok, result = pcall(achievement.check, data, context)
			if ok and result == true then
				if PlayerDataManager.grantAchievement(player, achievement.id) then
					table.insert(newlyUnlocked, achievement)
					if achievement.reward and achievement.reward > 0 then
						PlayerDataManager.addCredits(player, achievement.reward, false)
					end
				end
			elseif not ok then
				warn("[AchievementManager] check failed for " .. achievement.id .. ": " .. tostring(result))
			end
		end
	end

	for _, achievement in ipairs(newlyUnlocked) do
		AchievementManager.Unlocked:Fire(player, {
			id = achievement.id,
			name = achievement.name,
			blurb = achievement.blurb,
			reward = achievement.reward,
		})
	end

	return newlyUnlocked
end

function AchievementManager.catalog(player: Player)
	local data = PlayerDataManager.get(player)
	local out = {}
	for _, achievement in ipairs(Achievements.List) do
		table.insert(out, {
			id = achievement.id,
			name = achievement.name,
			blurb = achievement.blurb,
			reward = achievement.reward,
			unlocked = data ~= nil and data.achievements[achievement.id] == true,
		})
	end
	return out
end

return AchievementManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX60">
				<Properties>
					<string name="Name">CallManager</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- CallManager
-- The core state machine: one live call per player. Owns the meters, the stage
-- progression, the timer and every end condition.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Difficulty = require(Shared.Difficulty)
local Ranks = require(Shared.Ranks)
local Net = require(Shared.Net)
local Products = require(Shared.Products)
local Operation = require(Shared.Operation)

local PlayerDataManager = require(script.Parent.PlayerDataManager)
local NPCGenerator = require(script.Parent.NPCGenerator)
local NPCPersonalitySystem = require(script.Parent.NPCPersonalitySystem)
local DialogueManager = require(script.Parent.DialogueManager)
local RandomEventManager = require(script.Parent.RandomEventManager)
local RewardManager = require(script.Parent.RewardManager)
local AchievementManager = require(script.Parent.AchievementManager)
local HeatManager = require(script.Parent.HeatManager)

local CallManager = {}

local calls: { [number]: any } = {}
local contextValidator

-- Installed by the bootstrap. Tests can exercise accounting without world APIs.
function CallManager.setContextValidator(validate)
	contextValidator = validate
end

local function validContext(state)
	return PlayerDataManager.get(state.accountOwner or state.player) ~= nil
		and (not contextValidator or contextValidator(state.player, state.accountOwner or state.player))
end

CallManager.CallFinished = Instance.new("BindableEvent")

--------------------------------------------------------------------------------
-- Alias Licence: swaps the default technician name out of the player's own
-- dialogue. Cosmetic only -- it never changes what a line does.
--------------------------------------------------------------------------------

local DEFAULT_ALIAS = "Kevin"

local function spellOut(name: string): string
	local letters = {}
	for index = 1, #name do
		table.insert(letters, string.upper(string.sub(name, index, index)))
	end
	return table.concat(letters, "-")
end

local function applyAlias(text: string?, alias: string?): string?
	if not text or not alias then
		return text
	end
	local out = string.gsub(text, "K%-E%-V%-I%-N", spellOut(alias))
	out = string.gsub(out, DEFAULT_ALIAS, alias)
	return out
end

--------------------------------------------------------------------------------
-- View builders
--------------------------------------------------------------------------------

local function meterView(mode: string, value: number, maxValue: number)
	if mode == "hidden" then
		return { mode = "hidden", label = "???", ratio = 0 }
	elseif mode == "vague" then
		return { mode = "vague", label = Difficulty.band(value / maxValue * 100), ratio = 0 }
	end
	return { mode = "full", label = string.format("%d", math.floor(value + 0.5)), ratio = value / maxValue }
end

local function buildMeters(state)
	local level = Difficulty.get(state.difficultyKey)
	return {
		trust = meterView(level.trustDisplay, state.npc.trust, Config.Call.MaxTrust),
		suspicion = meterView(level.suspicionDisplay, state.npc.suspicion, Config.Call.MaxSuspicion),
		patience = meterView(level.patienceDisplay, state.npc.patience, Config.Call.MaxPatience),
	}
end

local function npcView(state)
	local npc = state.npc
	local level = Difficulty.get(state.difficultyKey)
	-- On higher difficulties the player gets less up-front information about
	-- who they are talking to and has to read the dialogue instead.
	local revealPersonality = level.order <= 2
	return {
		fullName = npc.fullName,
		initials = npc.initials,
		age = npc.age,
		town = npc.town,
		moodLabel = revealPersonality and npc.moodLabel or "Unknown",
		personalityName = revealPersonality and npc.personalityName or "Unknown caller",
		blurb = revealPersonality and npc.blurb or "You will have to work this one out yourself.",
		backstory = revealPersonality and npc.backstory or (npc.fullName .. ", " .. npc.age .. ", from " .. npc.town .. "."),
		tier = revealPersonality and npc.tier or "?",
		techKnowledge = revealPersonality and npc.techKnowledge or nil,
		portraitColour = npc.portraitColour,
	}
end

local function stageLabel(stage: number): string
	local entry = Config.Stages[math.clamp(stage, 1, #Config.Stages)]
	return entry and entry.label or "Call"
end

local function buildView(state, extra)
	local view = {
		npc = npcView(state),
		difficulty = state.difficultyKey,
		stage = state.stage,
		stageLabel = stageLabel(state.stage),
		stageCount = Config.StageCount,
		stageProgress = math.clamp(state.stageProgress / Config.Call.ProgressPerStage, 0, 1),
		meters = buildMeters(state),
		elapsed = state.elapsed,
		prompt = applyAlias(state.currentView and state.currentView.prompt or "", state.alias),
		choices = state.currentView and state.currentView.choices or {},
		eventTitle = state.currentView and state.currentView.eventTitle or nil,
		isEvent = state.currentView and state.currentView.isEvent or false,
		line = state.lastLine,
		reaction = state.lastReaction,
		feedback = state.lastFeedback,
	}
	if state.alias and view.choices then
		local personalised = {}
		for index, choice in ipairs(view.choices) do
			local copy = table.clone(choice)
			copy.text = applyAlias(copy.text, state.alias)
			personalised[index] = copy
		end
		view.choices = personalised
	end

	for key, value in pairs(extra or {}) do
		view[key] = value
	end
	return view
end

--------------------------------------------------------------------------------
-- Call lifecycle
--------------------------------------------------------------------------------

local function presentNext(state)
	local player = state.player
	if state.ended then
		return
	end

	-- Random interruption, or a normal situation for this stage.
	local view
	if RandomEventManager.shouldFire(state) then
		if state.skipNextEvent then
			-- Supervisor Takeover: the floor lead deals with this one.
			state.skipNextEvent = false
			state.eventCooldown = Config.Events.Cooldown
			Net.event("Notify"):FireClient(player, {
				title = "Supervisor Takeover",
				body = "Your floor lead handled that interruption.",
				kind = "success",
			})
		else
			local event = RandomEventManager.pick(state.npc, state)
			if event then
				state.usedEvents[event.id] = true
				state.currentSource = event
				state.currentIsEvent = true
				state.lastEventId = event.id
				state.eventCooldown = Config.Events.Cooldown
				if event.onHold then
					state.timesOnHold += 1
				end
				view = RandomEventManager.buildView(event, state)
			end
		end
	end

	if not view then
		local situation = DialogueManager.nextSituation(state.stage, state.npc, state)
		if not situation then
			-- No content left for the stage: push forward rather than stall.
			state.stageProgress = Config.Call.ProgressPerStage
			CallManager.advanceStage(state)
			return
		end
		state.usedSituations[situation.id] = true
		state.currentSource = situation
		state.currentIsEvent = false
		state.eventCooldown = math.max(0, state.eventCooldown - 1)
		view = DialogueManager.buildView(situation, state)
	end

	state.currentView = view
	Net.event("CallUpdated"):FireClient(player, buildView(state))
end

function CallManager.advanceStage(state)
	state.stageProgress = 0
	state.stage += 1
	if state.stage > Config.StageCount then
		CallManager.resolve(state)
		return
	end
	presentNext(state)
end

function CallManager.finish(state, outcome: string, closingLine: string?)
	if state.ended then
		return
	end
	if not validContext(state) then CallManager.cancel(state.player); return end
	state.ended = true
	local player = state.player
	local owner = state.accountOwner or player
	calls[player.UserId] = nil

	local duration = state.elapsed
	local result = {
		outcome = outcome,
		npc = state.npc,
		trust = state.npc.trust,
		suspicion = state.npc.suspicion,
		patience = state.npc.patience,
		duration = duration,
		perfect = state.perfect,
		difficultyKey = state.difficultyKey,
		bonuses = state.bonuses,
		timesOnHold = state.timesOnHold,
		stage = state.stage,
		aggressiveChoices = state.aggressiveChoices,
		lastEventId = state.lastEventId,
		survivedEvents = state.survivedEvents,
		difficulty = state.difficultyKey,
	}

	local reward, breakdown = RewardManager.award(owner, result)

	-- Every call leaves a trace. Ringing an actual police station leaves rather
	-- more of one.
	local profile = PlayerDataManager.get(owner)
	if profile and profile.operation then
		local heat = 0
		if state.npc.personalityId == "police_desk" then
			heat += Operation.Heat.PerPoliceCall
		end
		if outcome == "success" then
			heat += Operation.Heat.PerSuccessfulCall
		elseif outcome == "exposed" then
			heat += Operation.Heat.PerExposedCall
		end
		if heat > 0 then
			HeatManager.add(profile.operation, heat)
		end
	end

	local unlocked = AchievementManager.evaluate(owner, result)

	local achievementViews = {}
	for _, a in ipairs(unlocked) do
		table.insert(achievementViews, { id = a.id, name = a.name, blurb = a.blurb, reward = a.reward })
	end

	local titles = {
		success = "Call Complete",
		exposed = "You Were Rumbled",
		hangup = "They Hung Up",
		bored = "They Lost Interest",
		timeout = "The Line Went Dead",
		abandoned = "You Hung Up",
	}

	Net.event("CallEnded"):FireClient(player, {
		outcome = outcome,
		title = titles[outcome] or "Call Over",
		closingLine = closingLine or NPCPersonalitySystem.exitLine(state.npc, outcome),
		npc = npcView(state),
		revealedPersonality = state.npc.personalityName,
		revealedBlurb = state.npc.blurb,
		trust = math.floor(state.npc.trust),
		suspicion = math.floor(state.npc.suspicion),
		duration = duration,
		stage = math.min(state.stage, Config.StageCount),
		stageLabel = stageLabel(state.stage),
		reward = reward,
		breakdown = breakdown,
		achievements = achievementViews,
		perfect = state.perfect,
		accountOwnerUserId = owner.UserId,
		accountOwnerName = owner.DisplayName,
	})

	CallManager.CallFinished:Fire(owner, result, reward, player)
	PlayerDataManager.notify(owner)
end

function CallManager.resolve(state)
	local npc = state.npc
	local canSucceed = NPCPersonalitySystem.canSucceed(npc)
	local threshold = Config.Call.TrustToSucceed

	if canSucceed and npc.trust >= threshold and npc.suspicion < Config.Call.HangUpSuspicion then
		CallManager.finish(state, "success", NPCPersonalitySystem.exitLine(npc, "success"))
	elseif not canSucceed then
		CallManager.finish(state, "exposed", NPCPersonalitySystem.exitLine(npc, "exposed"))
	else
		CallManager.finish(state, "hangup", NPCPersonalitySystem.exitLine(npc, "hangup"))
	end
end

--------------------------------------------------------------------------------
-- Player actions
--------------------------------------------------------------------------------

function CallManager.start(player: Player, difficultyKey: string, accountOwner: Player?): (boolean, string)
	if calls[player.UserId] then
		return false, "You are already on a call."
	end
	local owner = accountOwner or player
	if contextValidator and not contextValidator(player, owner) then return false, "Office access is no longer valid." end
	local data = PlayerDataManager.get(owner)
	if not data then
		return false, "Your profile is still loading."
	end

	local level = Difficulty.get(difficultyKey)
	if data.rankIndex < level.minRankIndex then
		local needed = Ranks.get(level.minRankIndex)
		return false, level.label .. " difficulty unlocks at " .. needed.name .. "."
	end

	local bonuses = PlayerDataManager.getBonuses(owner)
	local rank = Ranks.get(data.rankIndex)

	-- Warm Lead is spent at connect time, before the caller is rolled.
	-- Guests never consume either player's paid inventory on a shared call.
	local warmLead = owner == player and PlayerDataManager.consumeItem(player, "warm_lead")
	local npc = NPCGenerator.generate(level.key, bonuses, nil, { warmLead = warmLead })

	local state = {
		player = player,
		accountOwner = owner,
		npc = npc,
		difficultyKey = level.key,
		bonuses = bonuses,
		dialogueLevel = rank.dialogueLevel,
		stage = 1,
		stageProgress = 0,
		elapsed = 0,
		startClock = os.clock(),
		usedSituations = {},
		usedEvents = {},
		tagHistory = {},
		survivedEvents = {},
		eventCooldown = 1,
		exposeRolled = false,
		skipNextEvent = false,
		alias = PlayerDataManager.getAlias(player),
		warmLead = warmLead,
		perfect = true,
		aggressiveChoices = 0,
		mistakes = 0,
		timesOnHold = 0,
		ended = false,
		lastLine = NPCPersonalitySystem.greeting(npc),
		lastReaction = "greet",
	}
	calls[player.UserId] = state

	if owner == player then PlayerDataManager.setDifficulty(player, level.key) end

	if warmLead then
		Net.event("Notify"):FireClient(player, {
			title = "Warm Lead Used",
			body = "Dialler picked you a friendlier caller.",
			kind = "success",
		})
	end

	Net.event("CallStarted"):FireClient(player, buildView(state, {
		greeting = state.lastLine,
	}))

	presentNext(state)
	return true, ""
end

function CallManager.choose(player: Player, index: number)
	local state = calls[player.UserId]
	if not state or state.ended then
		return
	end
	if not validContext(state) then CallManager.cancel(player); return end
	local source = state.currentSource
	if not source then
		return
	end
	local choice = source.choices[index]
	if not choice then
		return
	end
	if (choice.minLevel or 1) > state.dialogueLevel then
		Net.event("Notify"):FireClient(player, {
			title = "Locked",
			body = "That line unlocks at a higher rank.",
			kind = "warn",
		})
		return
	end

	local outcome = NPCPersonalitySystem.resolve(state.npc, choice, state)

	-- Apply meters.
	local npc = state.npc
	npc.trust = Util.clamp(npc.trust + outcome.deltas.trust, 0, Config.Call.MaxTrust)
	npc.suspicion = Util.clamp(npc.suspicion + outcome.deltas.suspicion, 0, Config.Call.MaxSuspicion)
	npc.patience = Util.clamp(npc.patience + outcome.deltas.patience, 0, Config.Call.MaxPatience)

	-- Bookkeeping used by rewards and achievements.
	for _, tag in ipairs(choice.tags or {}) do
		state.tagHistory[tag] = (state.tagHistory[tag] or 0) + 1
	end
	if outcome.aggressive then
		state.aggressiveChoices += 1
	end
	if outcome.deltas.suspicion > 0 then
		state.perfect = false
	end
	if outcome.mistake then
		state.mistakes += 1
	end
	if state.currentIsEvent then
		state.survivedEvents[source.id] = outcome.deltas.suspicion <= 12
	end

	state.lastLine = outcome.line
	state.lastReaction = outcome.category

	local level = Difficulty.get(state.difficultyKey)
	state.lastFeedback = (level.trustDisplay == "full" or level.suspicionDisplay == "full") and {
		trust = level.trustDisplay == "full" and outcome.deltas.trust or nil,
		suspicion = level.suspicionDisplay == "full" and outcome.deltas.suspicion or nil,
	} or nil

	-- End conditions checked in priority order.
	if npc.suspicion >= Config.Call.HangUpSuspicion then
		Net.event("CallUpdated"):FireClient(player, buildView(state, { choices = {} }))
		task.wait(0.6)
		CallManager.finish(state, "exposed", NPCPersonalitySystem.exitLine(npc, "exposed"))
		return
	end
	if npc.patience <= 0 then
		Net.event("CallUpdated"):FireClient(player, buildView(state, { choices = {} }))
		task.wait(0.6)
		CallManager.finish(state, "bored", NPCPersonalitySystem.exitLine(npc, "bored"))
		return
	end

	-- Progress the stage.
	state.stageProgress += math.max(0, choice.progress or 0)
	if state.stageProgress >= Config.Call.ProgressPerStage then
		Net.event("CallUpdated"):FireClient(player, buildView(state, { choices = {} }))
		task.wait(0.35)
		CallManager.advanceStage(state)
		return
	end

	presentNext(state)
end

-- Consumables bought with Robux and spent from the call screen. Returns ok and
-- a message for the client toast.
function CallManager.useItem(player: Player, productId: string): (boolean, string)
	local product = Products.ProductById[productId]
	if not product or not product.usableInCall then
		return false, "That cannot be used on a call."
	end
	local state = calls[player.UserId]
	if not state or state.ended then
		return false, "You are not on a call."
	end
	if not validContext(state) then CallManager.cancel(player); return false, "Office access ended." end
	if state.accountOwner ~= player then return false, "Only the host can use paid consumables in this office." end
	if (PlayerDataManager.get(player) == nil) then
		return false, "Your profile is still loading."
	end
	if not PlayerDataManager.consumeItem(player, productId) then
		return false, "You have none left."
	end

	local message = product.name .. " used."
	if product.use.patience then
		state.npc.patience = Util.clamp(state.npc.patience + product.use.patience, 0, Config.Call.MaxPatience)
		message = string.format("Patience restored by %d.", product.use.patience)
	end
	if product.use.skipNextEvent then
		state.skipNextEvent = true
		message = "Your supervisor will take the next interruption."
	end

	Net.event("CallUpdated"):FireClient(player, buildView(state))
	return true, message
end

function CallManager.hangUp(player: Player)
	local state = calls[player.UserId]
	if not state or state.ended then
		return
	end
	CallManager.finish(state, "abandoned", "Line disconnected.")
end

function CallManager.getState(player: Player)
	return calls[player.UserId]
end

-- Session transitions never pay consolation or record a completed call.
function CallManager.cancel(player: Player)
	local state = calls[player.UserId]
	if not state then return end
	state.ended = true
	calls[player.UserId] = nil
	Net.event("CallCancelled"):FireClient(player)
end

--------------------------------------------------------------------------------
-- Timer / patience drain
--------------------------------------------------------------------------------

function CallManager.beginRuntime()
	task.spawn(function()
		local accumulator = 0
		while true do
			local dt = task.wait(1)
			accumulator += dt
			for userId, state in pairs(calls) do
				if not state.ended then
					if not validContext(state) then CallManager.cancel(state.player); continue end
					state.elapsed = os.clock() - state.startClock

					-- Patience drains with time as well as with choices.
					if accumulator >= Config.Call.PatienceTickSeconds then
						state.npc.patience = math.max(0, state.npc.patience - 1)
					end

					if state.npc.patience <= 0 then
						CallManager.finish(state, "bored", NPCPersonalitySystem.exitLine(state.npc, "bored"))
					elseif state.elapsed >= Config.Call.MaxCallSeconds then
						CallManager.finish(state, "timeout", "The line goes dead.")
					end
				end
			end
			if accumulator >= Config.Call.PatienceTickSeconds then
				accumulator = 0
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local state = calls[player.UserId]
		if state then
			state.ended = true
			calls[player.UserId] = nil
		end
	end)
end

return CallManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX61">
				<Properties>
					<string name="Name">CosmeticsManager</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- CosmeticsManager
-- Applies the cosmetic Game Passes to a player's character: the overhead title
-- and the Platinum Headset. Nothing here touches gameplay values.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared")
local Products = require(Shared.Products)

local PlayerDataManager = require(script.Parent.PlayerDataManager)

local CosmeticsManager = {}

local TAG_NAME = "MacrosoftTitle"
local HEADSET_NAME = "MacrosoftPlatinumHeadset"

-- DataChanged fires on every credit tick, so cosmetics are only rebuilt when
-- what they depend on actually changed.
local lastSignature: { [number]: string } = {}

local function clearCosmetics(character: Model)
	local head = character:FindFirstChild("Head")
	if head then
		local existingTag = head:FindFirstChild(TAG_NAME)
		if existingTag then
			existingTag:Destroy()
		end
	end
	local existingHeadset = character:FindFirstChild(HEADSET_NAME)
	if existingHeadset then
		existingHeadset:Destroy()
	end
end

local function applyTitle(character: Model, text: string, colour: Color3)
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = TAG_NAME
	billboard.Size = UDim2.fromOffset(240, 34)
	billboard.StudsOffset = Vector3.new(0, 2.6, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 80
	billboard.Parent = head

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 16
	label.Text = text
	label.TextColor3 = colour
	label.TextStrokeTransparency = 0.4
	label.Parent = billboard
end

local function applyHeadset(character: Model)
	local head = character:FindFirstChild("Head")
	local humanoid = character:FindFirstChildWhichIsA("Humanoid")
	if not head or not head:IsA("BasePart") or not humanoid then
		return
	end
	local headHatAttachment = head:FindFirstChild("HatAttachment")
	if not headHatAttachment or not headHatAttachment:IsA("Attachment") then
		return
	end

	local accessory = Instance.new("Accessory")
	accessory.Name = HEADSET_NAME
	accessory.AccessoryType = Enum.AccessoryType.Hat

	-- HatAttachment exists on standard R6 and R15 heads. Matching it from the
	-- Handle lets Humanoid:AddAccessory create the normal AccessoryWeld instead
	-- of pinning loose geometry directly to the character's head.
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.2, 0.2, 0.2)
	handle.Transparency = 1
	handle.CanCollide = false
	handle.CanTouch = false
	handle.CanQuery = false
	handle.Massless = true
	handle.Anchored = false
	handle.CFrame = CFrame.new()
	handle.Parent = accessory

	local attachment = Instance.new("Attachment")
	attachment.Name = "HatAttachment"
	-- Copy the avatar's exact attachment transform. That puts the invisible
	-- Handle at the head centre without assuming one fixed hat offset.
	attachment.CFrame = headHatAttachment.CFrame
	attachment.Parent = handle

	local platinum = Color3.fromRGB(219, 225, 235)
	local platinumDark = Color3.fromRGB(142, 151, 166)
	local cushion = Color3.fromRGB(20, 23, 30)
	local cushionEdge = Color3.fromRGB(43, 48, 59)

	local function detail(className: string, name: string, size: Vector3, colour: Color3, material, offset: CFrame, shape)
		local part = Instance.new(className)
		part.Name = name
		part.Size = size
		part.Color = colour
		part.Material = material
		if shape then
			part.Shape = shape
		end
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Massless = true
		part.Anchored = false
		part.CFrame = handle.CFrame * offset
		part.Parent = accessory

		local weld = Instance.new("WeldConstraint")
		weld.Name = "HeadsetWeld"
		weld.Part0 = handle
		weld.Part1 = part
		weld.Parent = part
		return part
	end

	-- A padded seven-piece arc follows the top of a standard avatar head.
	-- Overlapping cylinders read as one smooth band rather than a square halo.
	local bandSegments = {
		{ -1.02, 0.05, 72, 0.40 },
		{ -0.86, 0.34, 50, 0.44 },
		{ -0.52, 0.58, 24, 0.48 },
		{ 0, 0.67, 0, 0.60 },
		{ 0.52, 0.58, -24, 0.48 },
		{ 0.86, 0.34, -50, 0.44 },
		{ 1.02, 0.05, -72, 0.40 },
	}
	for index, segment in ipairs(bandSegments) do
		local offset = CFrame.new(segment[1], segment[2], 0.05) * CFrame.Angles(0, 0, math.rad(segment[3]))
		detail("Part", "PaddedBand" .. index, Vector3.new(segment[4], 0.24, 0.24), cushion, Enum.Material.SmoothPlastic, offset, Enum.PartType.Cylinder)
		local railOffset = CFrame.new(segment[1], segment[2] + 0.13, 0.05) * CFrame.Angles(0, 0, math.rad(segment[3]))
		detail("Part", "PlatinumRail" .. index, Vector3.new(segment[4], 0.065, 0.065), platinum, Enum.Material.Metal, railOffset, Enum.PartType.Cylinder)
	end

	-- Metal yokes bridge the band and the earcups without covering the padding.
	for _, side in ipairs({ -1, 1 }) do
		detail(
			"Part",
			side < 0 and "LeftYoke" or "RightYoke",
			Vector3.new(0.42, 0.09, 0.09),
			platinum,
			Enum.Material.Metal,
			CFrame.new(side * 1.08, 0.08, 0.05) * CFrame.Angles(0, 0, math.rad(90)),
			Enum.PartType.Cylinder
		)
	end

	local function earcup(side: number, label: string)
		-- Circular outer shells, inset trim and thick inward-facing cushions make
		-- the silhouette unmistakably over-ear from the front and side.
		detail("Part", label .. "Earcup", Vector3.new(0.30, 0.82, 0.82), platinum, Enum.Material.Metal, CFrame.new(side * 1.12, -0.16, 0.05), Enum.PartType.Cylinder)
		detail("Part", label .. "Trim", Vector3.new(0.06, 0.68, 0.68), platinumDark, Enum.Material.Metal, CFrame.new(side * 1.29, -0.16, 0.05), Enum.PartType.Cylinder)
		detail("Part", label .. "Cushion", Vector3.new(0.20, 0.72, 0.72), cushion, Enum.Material.SmoothPlastic, CFrame.new(side * 0.94, -0.16, 0.05), Enum.PartType.Cylinder)
		detail("Part", label .. "CushionInset", Vector3.new(0.025, 0.48, 0.48), cushionEdge, Enum.Material.SmoothPlastic, CFrame.new(side * 0.825, -0.16, 0.05), Enum.PartType.Cylinder)
	end
	earcup(-1, "Left")
	earcup(1, "Right")

	-- A restrained diamond mark on the outside cup gives the pass a recognisable
	-- premium detail without turning the headset into a glowing costume prop.
	detail("Part", "PlatinumMark", Vector3.new(0.035, 0.18, 0.18), Color3.fromRGB(242, 246, 255), Enum.Material.Metal, CFrame.new(-1.335, -0.16, 0.05) * CFrame.Angles(math.rad(45), 0, 0), Enum.PartType.Block)

	-- The boom stays entirely on the left side, then turns inward near its tip;
	-- it finishes forward of the cheek rather than clipping through the face.
	detail("Part", "MicrophoneJoint", Vector3.new(0.18, 0.18, 0.18), platinumDark, Enum.Material.Metal, CFrame.new(-1.30, -0.28, -0.16), Enum.PartType.Ball)
	detail("Part", "MicrophoneBoom", Vector3.new(0.82, 0.07, 0.07), platinumDark, Enum.Material.Metal, CFrame.new(-1.25, -0.36, -0.55) * CFrame.Angles(0, math.rad(90), math.rad(-8)), Enum.PartType.Cylinder)
	detail("Part", "MicrophoneStem", Vector3.new(0.34, 0.065, 0.065), platinumDark, Enum.Material.Metal, CFrame.new(-1.03, -0.45, -0.91), Enum.PartType.Cylinder)
	detail("Part", "MicrophoneCapsule", Vector3.new(0.20, 0.13, 0.13), cushion, Enum.Material.SmoothPlastic, CFrame.new(-0.79, -0.45, -0.91), Enum.PartType.Ball)

	humanoid:AddAccessory(accessory)
end

local Ranks = require(Shared.Ranks)

function CosmeticsManager.apply(player: Player, force: boolean?)
	local character = player.Character
	if not character then
		return
	end

	local rank = ""
	local data = PlayerDataManager.get(player)
	if data then
		rank = Ranks.get(data.rankIndex).name
	end

	local signature = string.format(
		"%s|%s|%s",
		rank,
		tostring(PlayerDataManager.ownsPass(player, "employee_of_month")),
		tostring(PlayerDataManager.ownsPass(player, "platinum_headset"))
	)
	if not force and lastSignature[player.UserId] == signature then
		return
	end
	lastSignature[player.UserId] = signature

	clearCosmetics(character)

	if PlayerDataManager.ownsPass(player, "employee_of_month") then
		local pass = Products.PassById.employee_of_month
		applyTitle(character, pass.title.text, pass.title.colour)
	elseif rank ~= "" then
		applyTitle(character, rank, Color3.fromRGB(190, 198, 214))
	end

	if PlayerDataManager.ownsPass(player, "platinum_headset") then
		applyHeadset(character)
	end
end

function CosmeticsManager.start()
	local function hook(player: Player)
		player.CharacterAppearanceLoaded:Connect(function()
			task.wait(0.2)
			-- A fresh character has no cosmetics, so force a rebuild.
			CosmeticsManager.apply(player, true)
		end)
		if player.Character then
			CosmeticsManager.apply(player, true)
		end
	end

	Players.PlayerAdded:Connect(hook)
	for _, player in ipairs(Players:GetPlayers()) do
		hook(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		lastSignature[player.UserId] = nil
	end)

	-- Re-apply when ownership or rank changes.
	PlayerDataManager.DataChanged.Event:Connect(function(player)
		if player.Character then
			CosmeticsManager.apply(player)
		end
	end)
end

return CosmeticsManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX62">
				<Properties>
					<string name="Name">DialogueManager</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- DialogueManager
-- Chooses which situation the NPC raises next and shapes the choice list the
-- client is allowed to see.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local DialogueLibrary = require(Shared.DialogueLibrary)

local DialogueManager = {}

local function eligible(situation, npc, callState): boolean
	if situation.minLevel and callState.dialogueLevel < situation.minLevel then
		return false
	end
	if situation.personalities and not Util.contains(situation.personalities, npc.personalityId) then
		return false
	end
	if situation.excludes and Util.contains(situation.excludes, npc.personalityId) then
		return false
	end
	if callState.usedSituations[situation.id] then
		return false
	end
	return true
end

-- Returns a situation table, or nil if the stage is exhausted.
function DialogueManager.nextSituation(stage: number, npc, callState)
	local random = Util.newRandom()
	local candidates = {}
	for _, situation in ipairs(DialogueLibrary.forStage(stage)) do
		if eligible(situation, npc, callState) then
			local weight = situation.weight or 1
			-- Personality-specific situations are strongly favoured when they fit.
			if situation.personalities then
				weight *= 3
			end
			table.insert(candidates, { situation = situation, weight = weight })
		end
	end

	if #candidates == 0 then
		-- Allow repeats rather than stalling the call.
		for _, situation in ipairs(DialogueLibrary.forStage(stage)) do
			if not situation.personalities or Util.contains(situation.personalities, npc.personalityId) then
				table.insert(candidates, { situation = situation, weight = situation.weight or 1 })
			end
		end
	end
	if #candidates == 0 then
		return nil
	end

	local picked = Util.weightedPick(candidates, random)
	return picked and picked.situation or nil
end

-- Build the view the client renders: prompt variant + up to four choices with
-- rank-locked options greyed out rather than hidden.
function DialogueManager.buildView(situation, callState)
	local random = Util.newRandom()
	local prompt = Util.pick(situation.prompt, random)

	local choices = {}
	for index, choice in ipairs(situation.choices) do
		local locked = (choice.minLevel or 1) > callState.dialogueLevel
		table.insert(choices, {
			index = index,
			text = choice.text,
			locked = locked,
			lockReason = locked and ("Unlocks at dialogue level " .. tostring(choice.minLevel)) or nil,
		})
		if #choices >= Config.Call.MaxChoices then
			break
		end
	end

	-- Situations are authored best-line-first, which made "always click the top
	-- one" a winning strategy. The displayed order is shuffled; `index` still
	-- points at the real choice, so nothing downstream cares.
	Util.shuffle(choices, random)

	return {
		situationId = situation.id,
		prompt = prompt,
		choices = choices,
	}
end

function DialogueManager.getChoice(situation, index: number)
	return situation.choices[index]
end

function DialogueManager.situationCount(): number
	return DialogueLibrary.count()
end

return DialogueManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX63">
				<Properties>
					<string name="Name">EnvironmentBuilder</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- EnvironmentBuilder
-- Builds the whole call centre out of parts at runtime, so nothing has to be
-- placed by hand in Studio. Everything it creates lives under
-- workspace/CallCentre and is rebuilt cleanly on each server start.

local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local EnvironmentBuilder = {}

local ROOT_NAME = "CallCentre"
local employees = {}

EnvironmentBuilder._connection = nil

local THEME = {
	Floor = Color3.fromRGB(58, 62, 74),
	Carpet = Color3.fromRGB(42, 47, 64),
	-- Mid-tone walls. The old near-white ones plus 25 point lights washed the
	-- whole room out to a flat white.
	Wall = Color3.fromRGB(66, 47, 107),
	WallTrim = Color3.fromRGB(52, 57, 74),
	Desk = Color3.fromRGB(124, 96, 70),
	DeskLegs = Color3.fromRGB(70, 74, 86),
	Monitor = Color3.fromRGB(32, 34, 42),
	Screen = Config.Environment.ScreenColour,
	Chair = Color3.fromRGB(38, 42, 54),
	Glass = Color3.fromRGB(180, 220, 235),
	Accent = Color3.fromRGB(38, 220, 231),
}

local function part(props): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		p[key] = value
	end
	return p
end

local function label(parent: BasePart, text: string, face: Enum.NormalId, colour: Color3?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.CanvasSize = Vector2.new(400, 150)
	gui.LightInfluence = 0
	gui.Parent = parent

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.fromScale(1, 1)
	textLabel.BackgroundTransparency = 1
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextScaled = true
	textLabel.Text = text
	textLabel.TextColor3 = colour or Color3.fromRGB(255, 255, 255)
	textLabel.Parent = gui
	return textLabel
end

--------------------------------------------------------------------------------
-- Props
--------------------------------------------------------------------------------

local function buildDesk(parent: Instance, cframe: CFrame, name: string)
	local model = Instance.new("Model")
	model.Name = name

	local top = part({
		Size = Vector3.new(7, 0.3, 3.5),
		CFrame = cframe * CFrame.new(0, 3, 0),
		Color = THEME.Desk,
		Material = Enum.Material.Wood,
		Parent = model,
	})

	for _, offset in ipairs({ Vector3.new(-3.2, 0, -1.4), Vector3.new(3.2, 0, -1.4), Vector3.new(-3.2, 0, 1.4), Vector3.new(3.2, 0, 1.4) }) do
		part({
			Size = Vector3.new(0.25, 3, 0.25),
			CFrame = cframe * CFrame.new(offset.X, 1.5, offset.Z),
			Color = THEME.DeskLegs,
			Parent = model,
		})
	end

	-- Monitor and a glowing screen.
	part({
		Size = Vector3.new(2.6, 1.7, 0.2),
		CFrame = cframe * CFrame.new(0, 4.1, -0.8),
		Color = THEME.Monitor,
		Parent = model,
	})
	local screen = part({
		Size = Vector3.new(2.3, 1.4, 0.1),
		CFrame = cframe * CFrame.new(0, 4.1, -0.68),
		Color = THEME.Screen,
		Material = Enum.Material.Neon,
		Parent = model,
	})
	screen.Name = "Screen"
	part({
		Size = Vector3.new(0.6, 0.6, 0.4),
		CFrame = cframe * CFrame.new(0, 3.3, -0.8),
		Color = THEME.Monitor,
		Parent = model,
	})

	-- Keyboard, mug, headset hook.
	part({
		Size = Vector3.new(2.2, 0.12, 0.8),
		CFrame = cframe * CFrame.new(0, 3.2, 0.5),
		Color = Color3.fromRGB(40, 42, 50),
		Parent = model,
	})
	part({
		Size = Vector3.new(0.5, 0.6, 0.5),
		CFrame = cframe * CFrame.new(2.3, 3.45, 0.4),
		Color = Color3.fromRGB(230, 230, 230),
		Shape = Enum.PartType.Cylinder,
		Parent = model,
	})

	-- Chair.
	part({
		Size = Vector3.new(2, 0.3, 2),
		CFrame = cframe * CFrame.new(0, 2, 3),
		Color = THEME.Chair,
		Parent = model,
	})
	part({
		Size = Vector3.new(2, 2.2, 0.3),
		CFrame = cframe * CFrame.new(0, 3, 3.9),
		Color = THEME.Chair,
		Parent = model,
	})
	part({
		Size = Vector3.new(0.3, 2, 0.3),
		CFrame = cframe * CFrame.new(0, 1, 3),
		Color = Color3.fromRGB(60, 64, 76),
		Parent = model,
	})

	model.PrimaryPart = top
	model.Parent = parent
	return model
end

-- Very simple blocky employee. Animated by EnvironmentBuilder's heartbeat loop.
local function buildEmployee(parent: Instance, cframe: CFrame, name: string)
	local model = Instance.new("Model")
	model.Name = "Employee_" .. name

	local shirtColour = Color3.fromHSV(Util.newRandom():NextNumber(), 0.7, 0.95)

	local torso = part({
		Size = Vector3.new(2, 2, 1),
		CFrame = cframe * CFrame.new(0, 3, 0),
		Color = shirtColour,
		Parent = model,
	})
	torso.Name = "Torso"

	local head = part({
		Size = Vector3.new(1.2, 1.2, 1.2),
		CFrame = cframe * CFrame.new(0, 4.6, 0),
		Color = Color3.fromRGB(234, 200, 170),
		Parent = model,
	})
	head.Name = "Head"

	-- Headset.
	part({
		Size = Vector3.new(1.4, 0.2, 1.4),
		CFrame = cframe * CFrame.new(0, 5.2, 0),
		Color = Color3.fromRGB(28, 30, 38),
		Parent = model,
	})

	local leftArm = part({
		Size = Vector3.new(0.7, 1.8, 0.7),
		CFrame = cframe * CFrame.new(-1.35, 3, -0.3),
		Color = shirtColour,
		Parent = model,
	})
	leftArm.Name = "LeftArm"

	local rightArm = part({
		Size = Vector3.new(0.7, 1.8, 0.7),
		CFrame = cframe * CFrame.new(1.35, 3, -0.3),
		Color = shirtColour,
		Parent = model,
	})
	rightArm.Name = "RightArm"

	local legs = part({
		Size = Vector3.new(1.8, 2, 1),
		CFrame = cframe * CFrame.new(0, 1.5, 0.4),
		Color = Color3.fromRGB(52, 56, 68),
		Parent = model,
	})
	legs.Name = "Legs"

	-- Floating name / speech bubble.
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(220, 46)
	billboard.StudsOffset = Vector3.new(0, 2.2, 0)
	billboard.AlwaysOnTop = false
	billboard.Adornee = head
	billboard.Parent = head

	local bubble = Instance.new("TextLabel")
	bubble.Size = UDim2.fromScale(1, 1)
	bubble.BackgroundColor3 = Color3.fromRGB(24, 26, 34)
	bubble.BackgroundTransparency = 0.25
	bubble.TextColor3 = Color3.fromRGB(240, 240, 245)
	bubble.Font = Enum.Font.Gotham
	bubble.TextSize = 14
	bubble.Text = ""
	bubble.Visible = false
	bubble.Parent = billboard
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = bubble

	model.PrimaryPart = torso
	model.Parent = parent

	table.insert(employees, {
		model = model,
		torso = torso,
		head = head,
		leftArm = leftArm,
		rightArm = rightArm,
		baseCFrame = cframe,
		bubble = bubble,
		state = "typing",
		stateTimer = Util.newRandom():NextNumber(2, 8),
		phase = Util.newRandom():NextNumber(0, 10),
	})

	return model
end

local function buildRoomShell(parent: Instance)
	part({
		Size = Vector3.new(140, 1, 120),
		CFrame = CFrame.new(0, -0.5, 0),
		Color = THEME.Carpet,
		Material = Enum.Material.Fabric,
		Parent = parent,
		Name = "Floor",
	})
	part({
		Size = Vector3.new(140, 1, 120),
		CFrame = CFrame.new(0, 24, 0),
		Color = Color3.fromRGB(236, 236, 240),
		Parent = parent,
		Name = "Ceiling",
	})

	local walls = {
		{ Vector3.new(140, 24, 2), CFrame.new(0, 12, -60) },
		{ Vector3.new(140, 24, 2), CFrame.new(0, 12, 60) },
		{ Vector3.new(2, 24, 120), CFrame.new(-70, 12, 0) },
		{ Vector3.new(2, 24, 120), CFrame.new(70, 12, 0) },
	}
	for index, wall in ipairs(walls) do
		part({
			Size = wall[1],
			CFrame = wall[2],
			Color = THEME.Wall,
			Parent = parent,
			Name = "Wall" .. index,
		})
	end

	-- Ceiling lights. Every fixture glows (Neon costs nothing), but only a
	-- sparse grid of them actually casts light -- 25 overlapping PointLights at
	-- brightness 1.2 is what blew the room out to white.
	for x = -50, 50, 25 do
		for z = -40, 40, 20 do
			local lightPart = part({
				Size = Vector3.new(8, 0.3, 4),
				CFrame = CFrame.new(x, 23.4, z),
				Color = Config.Environment.CeilingLightColour,
				Material = Enum.Material.Neon,
				Parent = parent,
			})
			if (x + 50) % 50 == 0 and (z + 40) % 40 == 0 then
				local light = Instance.new("PointLight")
				light.Brightness = Config.Environment.CeilingLightBrightness
				light.Range = Config.Environment.CeilingLightRange
				light.Color = Config.Environment.CeilingLightColour
				light.Parent = lightPart
			end
		end
	end

	-- Accent strips down the long walls, purely decorative.
	for _, z in ipairs({ -59, 59 }) do
		part({
			Size = Vector3.new(120, 0.5, 0.3),
			CFrame = CFrame.new(0, 17, z),
			Color = Config.Environment.StripColourA,
			Material = Enum.Material.Neon,
			Parent = parent,
			Name = "AccentStrip",
		})
	end
	for _, x in ipairs({ -69, 69 }) do
		part({
			Size = Vector3.new(0.3, 0.5, 110),
			CFrame = CFrame.new(x, 17, 0),
			Color = Config.Environment.StripColourB,
			Material = Enum.Material.Neon,
			Parent = parent,
			Name = "AccentStrip",
		})
	end
end

local function buildSignage(parent: Instance)
	local sign = part({
		Size = Vector3.new(34, 6, 0.5),
		CFrame = CFrame.new(0, 16, -58.5),
		Color = Color3.fromRGB(24, 28, 40),
		Parent = parent,
		Name = "MainSign",
	})
	label(sign, "MACROSOFT SUPPORT\n(not a real company)", Enum.NormalId.Front, THEME.Accent)

	local disclaimer = part({
		Size = Vector3.new(26, 4, 0.4),
		CFrame = CFrame.new(0, 8.5, -58.5),
		Color = Color3.fromRGB(38, 42, 56),
		Parent = parent,
		Name = "Disclaimer",
	})
	label(disclaimer, "A SATIRE. Everything here is fictional.\nNever do any of this to a real person.", Enum.NormalId.Front, Color3.fromRGB(240, 210, 120))
end

local function buildBreakRoom(parent: Instance)
	local room = Instance.new("Model")
	room.Name = "BreakRoom"

	part({ Size = Vector3.new(30, 12, 1), CFrame = CFrame.new(-50, 6, 20), Color = THEME.Wall, Parent = room })
	part({ Size = Vector3.new(1, 12, 40), CFrame = CFrame.new(-35, 6, 40), Color = THEME.Wall, Parent = room })

	-- Coffee machine.
	local machine = part({
		Size = Vector3.new(3, 5, 2),
		CFrame = CFrame.new(-60, 2.5, 30),
		Color = Color3.fromRGB(64, 68, 82),
		Parent = room,
		Name = "CoffeeMachine",
	})
	label(machine, "COFFEE", Enum.NormalId.Front, Color3.fromRGB(230, 180, 120))

	-- Tables.
	for _, pos in ipairs({ Vector3.new(-52, 0, 34), Vector3.new(-44, 0, 44) }) do
		part({ Size = Vector3.new(5, 0.3, 5), CFrame = CFrame.new(pos.X, 3, pos.Z), Color = THEME.Desk, Parent = room })
		part({ Size = Vector3.new(0.5, 3, 0.5), CFrame = CFrame.new(pos.X, 1.5, pos.Z), Color = THEME.DeskLegs, Parent = room })
	end

	local sign = part({ Size = Vector3.new(8, 2, 0.4), CFrame = CFrame.new(-50, 10, 19.5), Color = Color3.fromRGB(30, 34, 46), Parent = room })
	label(sign, "BREAK ROOM", Enum.NormalId.Front, THEME.Accent)

	room.Parent = parent
	return room
end

local function buildBossOffice(parent: Instance)
	local office = Instance.new("Model")
	office.Name = "BossOffice"

	for _, spec in ipairs({
		{ Vector3.new(28, 12, 1), CFrame.new(50, 6, 20) },
		{ Vector3.new(1, 12, 40), CFrame.new(36, 6, 40) },
	}) do
		local glass = part({ Size = spec[1], CFrame = spec[2], Color = THEME.Glass, Parent = office })
		glass.Transparency = 0.55
		glass.Material = Enum.Material.Glass
	end

	part({ Size = Vector3.new(9, 0.4, 4), CFrame = CFrame.new(52, 3.2, 38), Color = Color3.fromRGB(88, 58, 40), Material = Enum.Material.Wood, Parent = office, Name = "BossDesk" })
	part({ Size = Vector3.new(3, 0.3, 3), CFrame = CFrame.new(52, 2.2, 43), Color = Color3.fromRGB(120, 30, 40), Parent = office })
	part({ Size = Vector3.new(3, 3, 0.4), CFrame = CFrame.new(52, 3.6, 44.4), Color = Color3.fromRGB(120, 30, 40), Parent = office })

	local sign = part({ Size = Vector3.new(10, 2, 0.4), CFrame = CFrame.new(50, 10, 19.5), Color = Color3.fromRGB(30, 34, 46), Parent = office })
	label(sign, "MANAGER'S OFFICE", Enum.NormalId.Front, Color3.fromRGB(244, 203, 96))

	-- The Corner Office game pass unlocks this desk. The prompt is always here;
	-- the server refuses it for players who do not own the pass.
	local executive = buildDesk(office, CFrame.new(50, 0, 32), "ExecutiveWorkstation")
	local plate = part({
		Size = Vector3.new(5, 1, 0.3),
		CFrame = CFrame.new(50, 3.8, 33.5),
		Color = Color3.fromRGB(244, 203, 96),
		Parent = executive,
		Name = "Nameplate",
	})
	label(plate, "CORNER OFFICE", Enum.NormalId.Front, Color3.fromRGB(40, 32, 10))

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ExecutivePrompt"
	prompt.ActionText = "Start Call"
	prompt.ObjectText = "Corner Office"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = executive.PrimaryPart

	office.Parent = parent
	return office
end

local function buildShopKiosk(parent: Instance)
	local kiosk = Instance.new("Model")
	kiosk.Name = "UpgradeShop"

	local counter = part({
		Size = Vector3.new(12, 4, 3),
		CFrame = CFrame.new(-25, 2, -45),
		Color = Color3.fromRGB(46, 52, 70),
		Parent = kiosk,
		Name = "Counter",
	})
	label(counter, "DESK UPGRADES", Enum.NormalId.Front, THEME.Accent)
	local screen = part({ Size = Vector3.new(4, 2.5, 0.3), CFrame = CFrame.new(-25, 5.4, -45.5),
		Color = THEME.Screen, Material = Enum.Material.Neon, Parent = kiosk, Name = "ManagementComputer" })
	label(screen, "OFFICE\nMANAGEMENT", Enum.NormalId.Front, Color3.fromRGB(255, 220, 110))

	local board = part({
		Size = Vector3.new(14, 8, 0.4),
		CFrame = CFrame.new(-25, 9, -47),
		Color = Color3.fromRGB(28, 32, 44),
		Parent = kiosk,
	})
	label(board, "SPEND YOUR\nCALL CENTRE CREDITS", Enum.NormalId.Front, Color3.fromRGB(244, 203, 96))

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open Upgrade Shop"
	prompt.ObjectText = "Macrosoft Supplies"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Name = "ShopPrompt"
	prompt.Parent = counter

	kiosk.Parent = parent
	return kiosk, prompt
end

-- Board layout. The two career boards sit on the back wall either side of the
-- main sign; the five global difficulty boards run down the right-hand wall.
local LEADERBOARD_SPECS = {
	{ name = "LifetimeEarnings", title = "TOP LIFETIME EARNINGS", cframe = CFrame.new(25, 9, -58), size = Vector3.new(16, 12, 0.6), face = Enum.NormalId.Front },
	{ name = "SuccessfulCalls", title = "MOST SUCCESSFUL CALLS", cframe = CFrame.new(45, 9, -58), size = Vector3.new(16, 12, 0.6), face = Enum.NormalId.Front },
	{ name = "Board_Operation", title = "BIGGEST OPERATIONS", cframe = CFrame.new(-30, 9, -58), size = Vector3.new(16, 12, 0.6), face = Enum.NormalId.Front },
	{ name = "Board_Easy", title = "EASY - MOST WINS", cframe = CFrame.new(69, 9, -40), size = Vector3.new(0.6, 11, 15), face = Enum.NormalId.Left },
	{ name = "Board_Normal", title = "NORMAL - MOST WINS", cframe = CFrame.new(69, 9, -20), size = Vector3.new(0.6, 11, 15), face = Enum.NormalId.Left },
	{ name = "Board_Hard", title = "HARD - MOST WINS", cframe = CFrame.new(69, 9, 0), size = Vector3.new(0.6, 11, 15), face = Enum.NormalId.Left },
	{ name = "Board_Expert", title = "EXPERT - MOST WINS", cframe = CFrame.new(69, 9, 20), size = Vector3.new(0.6, 11, 15), face = Enum.NormalId.Left },
	{ name = "Board_Nightmare", title = "NIGHTMARE - MOST WINS", cframe = CFrame.new(69, 9, 40), size = Vector3.new(0.6, 11, 15), face = Enum.NormalId.Left },
}

local function buildLeaderboards(parent: Instance)
	local boards = Instance.new("Model")
	boards.Name = "Leaderboards"

	for _, spec in ipairs(LEADERBOARD_SPECS) do
		local board = part({
			Size = spec.size,
			CFrame = spec.cframe,
			Color = Color3.fromRGB(22, 26, 36),
			Parent = boards,
			Name = spec.name,
		})

		local gui = Instance.new("SurfaceGui")
		gui.Name = "Board"
		gui.Face = spec.face
		gui.CanvasSize = Vector2.new(500, 380)
		gui.LightInfluence = 0
		gui.Parent = board

		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, 0, 0, 40)
		title.BackgroundTransparency = 1
		title.Font = Enum.Font.GothamBold
		title.TextSize = 24
		title.TextColor3 = THEME.Accent
		title.Text = spec.title
		title.Parent = gui

		local list = Instance.new("TextLabel")
		list.Name = "Entries"
		list.Position = UDim2.new(0, 10, 0, 45)
		list.Size = UDim2.new(1, -20, 1, -100)
		list.BackgroundTransparency = 1
		list.Font = Enum.Font.Gotham
		list.TextSize = 18
		list.TextColor3 = Color3.fromRGB(230, 234, 244)
		list.TextXAlignment = Enum.TextXAlignment.Left
		list.TextYAlignment = Enum.TextYAlignment.Top
		list.Text = "Loading..."
		list.Parent = gui

		local own = Instance.new("TextLabel")
		own.Name = "YourRank"
		own.Position = UDim2.new(0, 10, 1, -45)
		own.Size = UDim2.new(1, -20, 0, 40)
		own.BackgroundColor3 = Color3.fromRGB(51, 40, 83)
		own.TextColor3 = Color3.fromRGB(255, 206, 86)
		own.Font = Enum.Font.GothamBold
		own.TextSize = 18
		own.TextWrapped = true
		own.Text = "Use this board to see YOUR global rank"
		own.Parent = gui
	end

	boards.Parent = parent
	return boards
end

--------------------------------------------------------------------------------
-- Raid visuals. A raid belongs to one player, but the whole server gets to
-- watch the car turn up outside, which is half the fun of it.
--------------------------------------------------------------------------------

local raidModel: Model? = nil
local raidLight: PointLight? = nil

function EnvironmentBuilder.showRaid(playerName: string, seconds: number)
	local root = Workspace:FindFirstChild(ROOT_NAME)
	if not root then
		return
	end
	if raidModel then
		raidModel:Destroy()
		raidModel = nil
	end

	local model = Instance.new("Model")
	model.Name = "PoliceRaid"

	part({
		Size = Vector3.new(6, 3, 12),
		CFrame = CFrame.new(-14, 1.6, -52),
		Color = Color3.fromRGB(235, 235, 240),
		Parent = model,
	})
	part({
		Size = Vector3.new(5.4, 2.2, 5),
		CFrame = CFrame.new(-14, 4.2, -51),
		Color = Color3.fromRGB(60, 64, 76),
		Transparency = 0.35,
		Parent = model,
	})
	part({
		Size = Vector3.new(6.2, 0.8, 3),
		CFrame = CFrame.new(-14, 1.6, -52),
		Color = Color3.fromRGB(40, 90, 200),
		Parent = model,
	})
	for _, offset in ipairs({ Vector3.new(-2.6, -1.2, -4), Vector3.new(2.6, -1.2, -4), Vector3.new(-2.6, -1.2, 4), Vector3.new(2.6, -1.2, 4) }) do
		part({
			Size = Vector3.new(1, 2, 2),
			CFrame = CFrame.new(-14 + offset.X, 1.6 + offset.Y, -52 + offset.Z),
			Color = Color3.fromRGB(24, 24, 28),
			Parent = model,
		})
	end

	local bar = part({
		Size = Vector3.new(4, 0.6, 1),
		CFrame = CFrame.new(-14, 5.6, -51),
		Color = Color3.fromRGB(200, 40, 40),
		Material = Enum.Material.Neon,
		Parent = model,
		Name = "LightBar",
	})
	local light = Instance.new("PointLight")
	light.Brightness = 6
	light.Range = 40
	light.Color = Color3.fromRGB(80, 120, 255)
	light.Parent = bar
	raidLight = light

	local sign = part({
		Size = Vector3.new(12, 3, 0.4),
		CFrame = CFrame.new(-14, 9, -52),
		Color = Color3.fromRGB(24, 26, 34),
		Parent = model,
	})
	label(sign, "RAID IN PROGRESS\n" .. playerName, Enum.NormalId.Front, Color3.fromRGB(240, 120, 120))

	model.Parent = root
	raidModel = model

	task.delay(seconds, function()
		if raidModel == model then
			model:Destroy()
			raidModel = nil
			raidLight = nil
		end
	end)
end

function EnvironmentBuilder.raidActive(): boolean
	return raidModel ~= nil
end

--------------------------------------------------------------------------------
-- Employee animation loop
--------------------------------------------------------------------------------

local EMPLOYEE_STATES = { "typing", "talking", "celebrating", "angry", "standing", "coffee" }

local CHATTER = {
	typing = { "...", "mm-hm", "one moment sir" },
	talking = { "Hello sir!", "Yes sir, the blue window.", "Sir, please listen.", "No sir, it is not a scam." },
	celebrating = { "YES!", "GOT ONE!", "SIR SAID YES!" },
	angry = { "DO NOT HANG UP", "SIR!", "HELLO? HELLO?" },
	standing = { "I need a minute.", "This job." },
	coffee = { "Coffee.", "Third one today." },
}

local function setEmployeeState(employee, state: string)
	employee.state = state
	employee.stateTimer = Util.newRandom():NextNumber(4, 12)
	local lines = CHATTER[state]
	if lines and Util.newRandom():NextNumber() < 0.7 then
		employee.bubble.Text = Util.pick(lines)
		employee.bubble.Visible = true
		task.delay(3, function()
			if employee.bubble and employee.bubble.Parent then
				employee.bubble.Visible = false
			end
		end)
	end
end

local animationElapsed = 0
local function animateEmployees(dt: number)
	animationElapsed += dt
	if animationElapsed < 0.15 then return end
	dt = animationElapsed
	animationElapsed = 0
	local now = os.clock()
	local viewers = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then table.insert(viewers, root.Position) end
	end

	if raidLight and raidLight.Parent then
		raidLight.Color = (math.floor(now * 3) % 2 == 0)
			and Color3.fromRGB(80, 120, 255)
			or Color3.fromRGB(255, 80, 80)
	end

	for _, employee in ipairs(employees) do
		if not employee.model.Parent or employee.model.Parent:GetAttribute("Paused") then
			employee.bubble.Visible = false
			continue
		end
		local visible = false
		for _, position in ipairs(viewers) do
			if (position - employee.baseCFrame.Position).Magnitude < 120 then visible = true; break end
		end
		if not visible then continue end
		employee.stateTimer -= dt
		if employee.stateTimer <= 0 then
			setEmployeeState(employee, Util.pick(EMPLOYEE_STATES))
		end

		local t = now + employee.phase
		local base = employee.baseCFrame
		local state = employee.state

		if state == "typing" then
			local wobble = math.sin(t * 9) * 0.12
			employee.leftArm.CFrame = base * CFrame.new(-1.35, 3 + wobble, -0.9) * CFrame.Angles(math.rad(-70), 0, 0)
			employee.rightArm.CFrame = base * CFrame.new(1.35, 3 - wobble, -0.9) * CFrame.Angles(math.rad(-70), 0, 0)
			employee.head.CFrame = base * CFrame.new(0, 4.6, -0.1) * CFrame.Angles(math.rad(-12), 0, 0)
			employee.torso.CFrame = base * CFrame.new(0, 3, 0)
		elseif state == "talking" then
			local nod = math.sin(t * 3) * 0.1
			employee.head.CFrame = base * CFrame.new(0, 4.6, 0) * CFrame.Angles(nod, math.sin(t * 1.7) * 0.25, 0)
			employee.rightArm.CFrame = base * CFrame.new(1.35, 3.2 + math.sin(t * 4) * 0.25, -0.5) * CFrame.Angles(math.rad(-40), 0, 0)
			employee.leftArm.CFrame = base * CFrame.new(-1.35, 3, -0.3)
			employee.torso.CFrame = base * CFrame.new(0, 3, 0)
		elseif state == "celebrating" then
			local jump = math.abs(math.sin(t * 6)) * 0.6
			employee.torso.CFrame = base * CFrame.new(0, 3 + jump, 0)
			employee.head.CFrame = base * CFrame.new(0, 4.6 + jump, 0)
			employee.leftArm.CFrame = base * CFrame.new(-1.35, 4 + jump, 0) * CFrame.Angles(math.rad(160), 0, 0)
			employee.rightArm.CFrame = base * CFrame.new(1.35, 4 + jump, 0) * CFrame.Angles(math.rad(160), 0, 0)
		elseif state == "angry" then
			local shake = math.sin(t * 22) * 0.08
			employee.torso.CFrame = base * CFrame.new(shake, 3, 0)
			employee.head.CFrame = base * CFrame.new(shake, 4.6, 0) * CFrame.Angles(math.rad(10), 0, 0)
			employee.leftArm.CFrame = base * CFrame.new(-1.35 + shake, 3.4, -0.6) * CFrame.Angles(math.rad(-90), 0, 0)
			employee.rightArm.CFrame = base * CFrame.new(1.35 + shake, 3.4, -0.6) * CFrame.Angles(math.rad(-90), 0, 0)
		elseif state == "standing" then
			employee.torso.CFrame = base * CFrame.new(0, 4.2, 1.5)
			employee.head.CFrame = base * CFrame.new(0, 5.8, 1.5)
			employee.leftArm.CFrame = base * CFrame.new(-1.35, 4.2, 1.5)
			employee.rightArm.CFrame = base * CFrame.new(1.35, 4.2, 1.5)
		else -- coffee
			local sip = math.sin(t * 2) * 0.3
			employee.torso.CFrame = base * CFrame.new(0, 3, 0)
			employee.head.CFrame = base * CFrame.new(0, 4.6, 0) * CFrame.Angles(math.rad(8 + sip * 10), 0, 0)
			employee.rightArm.CFrame = base * CFrame.new(0.6, 4.2 + sip, -0.3) * CFrame.Angles(math.rad(-120), 0, 0)
			employee.leftArm.CFrame = base * CFrame.new(-1.35, 3, -0.3)
		end
	end
end

--------------------------------------------------------------------------------

-- A default Roblox place ships with a Baseplate whose top face sits at y=0,
-- exactly where our floor goes, and a SpawnLocation that competes with ours for
-- where players appear. Clear only those two, by name and class, so installing
-- into a fresh place does not z-fight or spawn people in a wall.
local function clearDefaultPlaceParts()
	local removed = 0
	for _, child in ipairs(Workspace:GetChildren()) do
		if child.Name == "Baseplate" and child:IsA("BasePart") then
			child:Destroy()
			removed += 1
		elseif child:IsA("SpawnLocation") and child.Name ~= "CallCentreSpawn" then
			child:Destroy()
			removed += 1
		end
	end
	if removed > 0 then
		print(string.format("[Macrosoft] Removed %d default place part(s) that clash with the call centre.", removed))
	end
end

function EnvironmentBuilder.build()
	local existing = Workspace:FindFirstChild(ROOT_NAME)
	if existing then
		existing:Destroy()
	end
	clearDefaultPlaceParts()
	table.clear(employees)
	raidModel = nil
	raidLight = nil

	local root = Instance.new("Model")
	root.Name = ROOT_NAME

	buildRoomShell(root)
	buildSignage(root)

	local desks = Instance.new("Folder")
	desks.Name = "Desks"
	desks.Parent = root

	local staff = Instance.new("Folder")
	staff.Name = "Staff"
	staff.Parent = root

	-- Rows of desks. The front-left desk is the player's workstation.
	local deskIndex = 0
	for row = 0, 3 do
		for column = 0, 4 do
			deskIndex += 1
			local x = -40 + column * 18
			local z = -30 + row * 18
			local cframe = CFrame.new(x, 0, z)
			local desk = buildDesk(desks, cframe, "Desk_" .. deskIndex)

			if deskIndex == 1 then
				desk.Name = "PlayerWorkstation"
				local nameplate = part({
					Size = Vector3.new(4, 1, 0.3),
					CFrame = cframe * CFrame.new(0, 3.8, 1.5),
					Color = THEME.Accent,
					Parent = desk,
					Name = "Nameplate",
				})
				label(nameplate, "SHOWROOM", Enum.NormalId.Front)

				local prompt = Instance.new("ProximityPrompt")
				prompt.Name = "WorkstationPrompt"
				prompt.ActionText = "Visit Your Office Lift"
				prompt.ObjectText = "Demo Workstation"
				prompt.Enabled = false
				prompt.HoldDuration = 0
				prompt.MaxActivationDistance = 12
				prompt.RequiresLineOfSight = false
				prompt.Parent = desk.PrimaryPart
			else
				-- Every other desk gets a colleague.
				buildEmployee(staff, cframe * CFrame.new(0, 0, 3), tostring(deskIndex))
			end
		end
	end

	-- A manager who patrols the floor.
	-- Leave the arrival pad at (0, 4, 44) and its forward prompt approach clear.
	local managerCFrame = CFrame.new(16, 0, 44)
	local manager = buildEmployee(staff, managerCFrame, "Manager")
	manager.Name = "FloorManager"

	buildBreakRoom(root)
	local office = buildBossOffice(root)
	local _, shopPrompt = buildShopKiosk(root)
	buildLeaderboards(root)

	local executivePrompt = office:FindFirstChild("ExecutiveWorkstation")
	executivePrompt = executivePrompt and executivePrompt:FindFirstChildWhichIsA("ProximityPrompt", true) or nil

	local spawnPoint = Instance.new("SpawnLocation")
	spawnPoint.Size = Vector3.new(8, 1, 8)
	spawnPoint.CFrame = CFrame.new(-40, 0.5, -20)
	spawnPoint.Anchored = true
	spawnPoint.Neutral = true
	spawnPoint.Color = THEME.Accent
	spawnPoint.Material = Enum.Material.Neon
	spawnPoint.Name = "CallCentreSpawn"
	spawnPoint.Parent = root

	root.Parent = Workspace

	local env = Config.Environment
	Lighting.Ambient = env.Ambient
	Lighting.OutdoorAmbient = env.OutdoorAmbient
	Lighting.Brightness = env.Brightness
	Lighting.ClockTime = env.ClockTime
	Lighting.GlobalShadows = true
	Lighting.FogEnd = env.FogEnd

	local function ensureEffect(className: string, name: string, props)
		local existing = Lighting:FindFirstChild(name)
		if existing then
			existing:Destroy()
		end
		local effect = Instance.new(className)
		effect.Name = name
		for key, value in pairs(props) do
			effect[key] = value
		end
		effect.Parent = Lighting
		return effect
	end

	-- Gentle. Bloom exists to make the neon read as lit, not to smear it.
	ensureEffect("BloomEffect", "MacrosoftBloom", {
		Intensity = env.Bloom.Intensity,
		Size = env.Bloom.Size,
		Threshold = env.Bloom.Threshold,
	})
	ensureEffect("ColorCorrectionEffect", "MacrosoftColour", {
		Saturation = env.Colour.Saturation,
		Contrast = env.Colour.Contrast,
		Brightness = env.Colour.Brightness,
		TintColor = Color3.fromRGB(255, 252, 250),
	})

	-- Any leftovers from an older install would stack on top of these.
	for _, name in ipairs({ "MacrosoftRays" }) do
		local stale = Lighting:FindFirstChild(name)
		if stale then
			stale:Destroy()
		end
	end

	-- Animate colleagues.
	if not EnvironmentBuilder._connection then
		EnvironmentBuilder._connection = RunService.Heartbeat:Connect(animateEmployees)
	end

	return root, shopPrompt, executivePrompt
end

function EnvironmentBuilder.getRoot(): Instance?
	return Workspace:FindFirstChild(ROOT_NAME)
end

-- Used by LeaderboardManager to push text onto the wall boards.
function EnvironmentBuilder.setLeaderboard(boardName: string, text: string)
	local root = EnvironmentBuilder.getRoot()
	if not root then
		return
	end
	local boards = root:FindFirstChild("Leaderboards")
	local board = boards and boards:FindFirstChild(boardName)
	local gui = board and board:FindFirstChild("Board")
	local entries = gui and gui:FindFirstChild("Entries")
	if entries then
		entries.Text = text
	end
end

-- Shared construction primitives let personal offices use the established art
-- and animation system instead of introducing a second environment architecture.
EnvironmentBuilder.part = part
EnvironmentBuilder.label = label
EnvironmentBuilder.buildDesk = buildDesk
EnvironmentBuilder.buildEmployee = buildEmployee

function EnvironmentBuilder.removeEmployees(parent)
	for index = #employees, 1, -1 do
		if employees[index].model:IsDescendantOf(parent) then table.remove(employees, index) end
	end
end

return EnvironmentBuilder
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX64">
				<Properties>
					<string name="Name">HeatManager</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- HeatManager
-- The police pressure system. Heat rises with the size and sophistication of
-- the operation, falls with security and time, and at 100 the door goes in.
--
-- This module never reads global state: OperationManager hands it the player's
-- operation table and the summary it already computed, so the numbers on the
-- UI and the numbers in the simulation can never drift apart.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared")
local Operation = require(Shared.Operation)
local Util = require(Shared.Util)

local HeatManager = {}

HeatManager.Warned = Instance.new("BindableEvent") -- (player, warning)
HeatManager.Raided = Instance.new("BindableEvent") -- (player, outcome)

-- Which warning bands a player has already been shown this heat cycle.
local warnedAt: { [number]: { [number]: boolean } } = {}

function HeatManager.reset(player: Player)
	warnedAt[player.UserId] = nil
end

function HeatManager.isLayingLow(operation): boolean
	return (operation.layLowUntil or 0) > os.time()
end

function HeatManager.isShutDown(operation): boolean
	return (operation.shutdownUntil or 0) > os.time()
end

-- Adds heat from something that happened during a call.
function HeatManager.add(operation, amount: number)
	operation.heat = Util.clamp((operation.heat or 0) + amount, 0, Operation.Heat.Max)
end

function HeatManager.layLow(operation): (boolean, string)
	if HeatManager.isLayingLow(operation) then
		return false, "You are already lying low."
	end
	if HeatManager.isShutDown(operation) then
		return false, "The office is still shut."
	end
	operation.layLowUntil = os.time() + Operation.Heat.LayLowSeconds
	return true, string.format(
		"Everyone goes quiet for %d seconds. No income, but the heat drops fast.",
		Operation.Heat.LayLowSeconds
	)
end

-- Resolves a raid. Returns a table describing what happened, which the caller
-- forwards to the client and the achievement system.
function HeatManager.resolveRaid(player: Player, operation, summary, spendCredits)
	local random = Util.newRandom()
	local escaped = random:NextNumber() < summary.escapeChance

	if escaped then
		operation.heat = Operation.Raid.HeatAfterEscape
		operation.raidsSurvived += 1
		warnedAt[player.UserId] = nil
		local outcome = {
			escaped = true,
			title = "They Found Nothing",
			body = "Everyone stood very still next to a shredder for ten minutes. The coats left.",
			creditsLost = 0,
			staffLost = 0,
			escapeChance = summary.escapeChance,
		}
		HeatManager.Raided:Fire(player, outcome)
		return outcome
	end

	-- Failed raid: a fine, some staff scatter, and the floor shuts for a while.
	local fine = math.floor(spendCredits(Operation.Raid.CreditLossFraction))

	local staffLost = 0
	-- The noisy ones go first; they were always going to.
	local order = {}
	for _, employee in ipairs(Operation.Employees) do
		table.insert(order, employee)
	end
	table.sort(order, function(a, b)
		if a.suspicious ~= b.suspicious then
			return a.suspicious == true
		end
		return a.tier < b.tier
	end)

	local target = math.floor(summary.headcount * Operation.Raid.StaffLossFraction)
	for _, employee in ipairs(order) do
		if staffLost >= target then
			break
		end
		local held = operation.staff[employee.id] or 0
		if held > 0 then
			local take = math.min(held, target - staffLost)
			local left = held - take
			operation.staff[employee.id] = left > 0 and left or nil
			staffLost += take
		end
	end

	operation.heat = Operation.Raid.HeatAfterRaid
	operation.shutdownUntil = os.time() + Operation.Raid.ShutdownSeconds
	operation.raidsLost += 1
	warnedAt[player.UserId] = nil

	local outcome = {
		escaped = false,
		title = "Raided",
		body = string.format(
			"The door came off its hinges. %s Credits gone, %d staff out of a window, floor shut for %d seconds.",
			Util.formatNumber(fine),
			staffLost,
			Operation.Raid.ShutdownSeconds
		),
		creditsLost = fine,
		staffLost = staffLost,
		escapeChance = summary.escapeChance,
	}
	HeatManager.Raided:Fire(player, outcome)
	return outcome
end

-- One second of police pressure.
-- spendCredits(fraction) -> amount actually taken, supplied by OperationManager
-- so this module never touches the profile directly.
function HeatManager.tick(player: Player, operation, summary, dt: number, spendCredits)
	local layingLow = HeatManager.isLayingLow(operation)
	local shutDown = HeatManager.isShutDown(operation)

	local decay = summary.heatDecay
	local gain = summary.heatGain
	if layingLow then
		decay *= Operation.Heat.LayLowDecayMultiplier
		gain = 0
	end
	if shutDown then
		-- Nothing is running, so nothing is drawing attention.
		gain = 0
	end

	operation.heat = Util.clamp((operation.heat or 0) + (gain - decay) * dt, 0, Operation.Heat.Max)

	-- Warnings, once each per cycle.
	local seen = warnedAt[player.UserId]
	if not seen then
		seen = {}
		warnedAt[player.UserId] = seen
	end
	for index, warning in ipairs(Operation.Heat.Warnings) do
		if operation.heat >= warning.at and not seen[index] then
			seen[index] = true
			HeatManager.Warned:Fire(player, warning)
		elseif operation.heat < warning.at - 10 then
			-- Dropped well back below the band, so it can fire again later.
			seen[index] = nil
		end
	end

	if operation.heat >= Operation.Heat.Max then
		return HeatManager.resolveRaid(player, operation, summary, spendCredits)
	end
	return nil
end

return HeatManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX65">
				<Properties>
					<string name="Name">LeaderboardManager</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- LeaderboardManager
-- Pushes career totals into OrderedDataStores and renders them onto the two
-- wall boards built by EnvironmentBuilder. Entirely optional: if DataStores are
-- unavailable the boards simply show a friendly message.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Difficulty = require(Shared.Difficulty)
local Net = require(Shared.Net)

local PlayerDataManager = require(script.Parent.PlayerDataManager)
local EnvironmentBuilder = require(script.Parent.EnvironmentBuilder)
local TerminalAccess = require(script.Parent.TerminalAccess)
local LeaderboardRank = require(script.Parent.LeaderboardRank)

local LeaderboardManager = {}

-- Two career boards plus one global board per difficulty. The difficulty boards
-- count successful calls, never credits, so no paid reward multiplier can move
-- a player up them.
local BOARDS = {
	{
		name = "LifetimeEarnings",
		key = Config.DataStore.LeaderboardKey .. "_earnings",
		suffix = " Credits",
		value = function(stats)
			return stats.lifetimeEarnings or 0
		end,
	},
	{
		name = "SuccessfulCalls",
		key = Config.DataStore.LeaderboardKey .. "_calls",
		suffix = " calls",
		value = function(stats)
			return stats.successfulCalls or 0
		end,
	},
}

table.insert(BOARDS, {
	name = "Board_Operation",
	key = Config.DataStore.LeaderboardKey .. "_operation",
	suffix = " passive",
	value = function(stats)
		return stats.passiveEarned or 0
	end,
})

for _, difficultyKey in ipairs(Difficulty.Order) do
	table.insert(BOARDS, {
		name = "Board_" .. difficultyKey,
		key = Config.DataStore.LeaderboardKey .. "_diff_" .. string.lower(difficultyKey),
		suffix = " wins",
		difficulty = difficultyKey,
		value = function(stats)
			return (stats.successByDifficulty and stats.successByDifficulty[difficultyKey]) or 0
		end,
	})
end

-- Exposed so the headless tests can assert every difficulty has a board.
LeaderboardManager.Boards = BOARDS

local stores = {}
local rankBusy = {}
local rankCache = {}

local function getStore(key: string)
	if stores[key] ~= nil then
		return stores[key]
	end
	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore(key)
	end)
	stores[key] = ok and store or false
	if not ok then
		warn("[LeaderboardManager] OrderedDataStore unavailable: " .. tostring(store))
	end
	return stores[key]
end

function LeaderboardManager.publish(player: Player)
	local data = PlayerDataManager.get(player)
	if not data or data.loadFailed then
		return
	end
	for _, board in ipairs(BOARDS) do
		local store = getStore(board.key)
		if store then
			local value = math.floor(board.value(data.stats))
			if value > 0 then
				pcall(function()
					store:SetAsync(tostring(player.UserId), value)
				end)
			end
		end
	end
end

local function nameFor(userId: number): string
	local player = Players:GetPlayerByUserId(userId)
	if player then
		return player.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	return ok and name or ("User " .. tostring(userId))
end

function LeaderboardManager.refresh()
	for _, board in ipairs(BOARDS) do
		local store = getStore(board.key)
		if not store then
			EnvironmentBuilder.setLeaderboard(board.name, "Leaderboards need API access enabled\nin Game Settings > Security.")
		else
			local ok, pages = pcall(function()
				return store:GetSortedAsync(false, 10)
			end)
			if ok then
				local lines = {}
				local rank = 0
				local okPage, entries = pcall(function()
					return pages:GetCurrentPage()
				end)
				if okPage then
					for _, entry in ipairs(entries) do
						rank += 1
						table.insert(lines, string.format("%d. %s - %s%s", rank, nameFor(tonumber(entry.key) or 0), Util.formatNumber(entry.value), board.suffix))
					end
				end
				if #lines == 0 then
					table.insert(lines, "Nobody on the board yet.")
				end
				EnvironmentBuilder.setLeaderboard(board.name, table.concat(lines, "\n"))
			end
		end
	end
end

function LeaderboardManager.start()
	local boards = EnvironmentBuilder.getRoot():FindFirstChild("Leaderboards")
	for _, spec in ipairs(BOARDS) do
		local board = boards and boards:FindFirstChild(spec.name)
		if board then
			local prompt = Instance.new("ProximityPrompt")
			prompt.ActionText = "Show My Global Rank"
			prompt.ObjectText = spec.name
			prompt.MaxActivationDistance = 16
			prompt.RequiresLineOfSight = false
			prompt.Parent = board
			prompt.Triggered:Connect(function(player)
				local terminal = { anchor = board, distance = 18 }
				if rankBusy[player] or not TerminalAccess.near(player, terminal)
					or not TerminalAccess.throttle(player, "rank", 3) then return end
				local data = PlayerDataManager.get(player)
				if not data then return end
				local function send(text)
					if player.Parent then Net.event("LeaderboardRank"):FireClient(player, { board = spec.name, text = text }) end
				end
				local score = math.floor(spec.value(data.stats))
				local cache = rankCache[player] and rankCache[player][spec.name]
				if cache and cache.score == score and os.clock() - cache.time < 90 then send(cache.text); return end
				local store = getStore(spec.key)
				if not store or data.loadFailed or data.saveDisabled then send("Global rank needs DataStore access"); return end
				rankBusy[player] = true
				send("Finding YOUR global rank...")
				task.spawn(function()
					local deadline = os.clock() + 45
					local rank, text = LeaderboardRank.calculate(store, score, function()
						return player.Parent ~= nil and os.clock() < deadline and TerminalAccess.near(player, terminal)
					end)
					text ..= "  |  " .. Util.formatNumber(score) .. spec.suffix
					if player.Parent and rank then
						rankCache[player] = rankCache[player] or {}
						rankCache[player][spec.name] = { score = score, time = os.clock(), text = text }
					end
					send(text)
					rankBusy[player] = nil
				end)
			end)
		end
	end

	task.spawn(function()
		while true do
			for _, player in ipairs(Players:GetPlayers()) do LeaderboardManager.publish(player) end
			LeaderboardManager.refresh()
			task.wait(90)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		rankBusy[player] = nil
		rankCache[player] = nil
		LeaderboardManager.publish(player)
	end)

-- The loop above performs the initial refresh as well.
end

return LeaderboardManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX66">
				<Properties>
					<string name="Name">LeaderboardRank</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Competition rank: ties share a rank. No arbitrary Top-100/Top-1000 cutoff.
local LeaderboardRank = {}

function LeaderboardRank.calculate(store, score, keepGoing)
	if score <= 0 then return nil, "Unranked - earn your first score" end
	local ok, result = pcall(function()
		local pages = store:GetSortedAsync(false, 100, score + 1)
		local ahead = 0
		while true do
			if keepGoing and not keepGoing() then error("Rank lookup cancelled") end
			ahead += #pages:GetCurrentPage()
			if pages.IsFinished then return ahead + 1 end
			pages:AdvanceToNextPageAsync()
		end
	end)
	if not ok then return nil, "Rank unavailable - try again at this board" end
	return result, "YOUR GLOBAL RANK  #" .. tostring(result)
end

return LeaderboardRank
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX67">
				<Properties>
					<string name="Name">MacrosoftServer</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- MacrosoftServer (Script)
-- The single server entry point. Requires every manager, wires the remotes and
-- builds the world. Everything else is a ModuleScript.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("MacrosoftShared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Ranks = require(Shared.Ranks)
local Difficulty = require(Shared.Difficulty)
local Upgrades = require(Shared.Upgrades)
local DialogueLibrary = require(Shared.DialogueLibrary)
local RandomEvents = require(Shared.RandomEvents)
local Personalities = require(Shared.Personalities)
local Products = require(Shared.Products)
local Operation = require(Shared.Operation)

-- Remotes must exist before any client script requires Net.
Net.init()

local Modules = script.Parent
local PlayerDataManager = require(Modules.PlayerDataManager)
local CallManager = require(Modules.CallManager)
local UpgradeManager = require(Modules.UpgradeManager)
local AchievementManager = require(Modules.AchievementManager)
local EnvironmentBuilder = require(Modules.EnvironmentBuilder)
local LeaderboardManager = require(Modules.LeaderboardManager)
local MonetisationManager = require(Modules.MonetisationManager)
local CosmeticsManager = require(Modules.CosmeticsManager)
local OperationManager = require(Modules.OperationManager)
local HeatManager = require(Modules.HeatManager)
local TerminalAccess = require(Modules.TerminalAccess)
local OfficeManager = require(Modules.OfficeManager)

--------------------------------------------------------------------------------
-- World
--------------------------------------------------------------------------------

local _, shopPrompt, executivePrompt = EnvironmentBuilder.build()

local function openTerminal(player, terminal)
	if CallManager.getState(player) then return end
	if TerminalAccess.open(player, terminal) then
		Net.event("TerminalOpened"):FireClient(player, { kind = terminal.kind, anchor = terminal.anchor,
			isGuest = terminal.owner ~= nil and terminal.owner ~= player.UserId })
	end
end

OfficeManager.start(openTerminal)

-- Retain the showroom upgrade kiosk and the paid Corner Office workstation.
for _, entry in ipairs({
	{ prompt = shopPrompt, kind = "management" },
	{ prompt = executivePrompt, kind = "workstation", canUse = function(player)
		return MonetisationManager.owns(player, "corner_office")
	end },
}) do
	if entry.prompt then
		local terminal = { kind = entry.kind, anchor = entry.prompt.Parent, model = entry.prompt.Parent.Parent, canUse = entry.canUse }
		terminal.canAccess = function(player)
			return OfficeManager.sessionHost(player) == player and OfficeManager.canEnter(player, player.UserId)
		end
		entry.prompt.ActionText = "Use Computer"
		entry.prompt.Triggered:Connect(function(player)
			if TerminalAccess.throttle(player, "prompt", 0.4) then openTerminal(player, terminal) end
		end)
	end
end

local function closeTerminal(player)
	TerminalAccess.close(player)
	CallManager.cancel(player)
	Net.event("TerminalClosed"):FireClient(player)
end

OfficeManager.Travelling.Event:Connect(closeTerminal)
CallManager.setContextValidator(function(actor, owner)
	if OfficeManager.sessionHost(actor) ~= owner or not OfficeManager.canEnter(actor, owner.UserId) then return false end
	local current = TerminalAccess.current(actor)
	return current ~= nil and current.terminal.kind == "workstation" and TerminalAccess.valid(actor)
		and (current.terminal.owner == owner.UserId or (current.terminal.owner == nil and actor == owner))
end)

local function pushOfficeView(player)
	local host = OfficeManager.sessionHost(player)
	local view = host and PlayerDataManager.publicView(host)
	if not view then return end
	Net.event("OfficeDataUpdated"):FireClient(player, {
		hostUserId = host.UserId, hostName = host.DisplayName, credits = view.credits,
		rankIndex = view.rankIndex, rankName = view.rankName, saveDisabled = view.saveDisabled, saveNote = view.saveNote,
	})
	Net.event("OperationUpdated"):FireClient(player, OperationManager.view(host))
end

OfficeManager.SessionChanged.Event:Connect(function(player, view)
	Net.event("OfficeSessionUpdated"):FireClient(player, view)
	pushOfficeView(player)
end)

Net.event("OfficeAction").OnServerEvent:Connect(function(player, action, a, b)
	if not TerminalAccess.throttle(player, "officeAction", 0.3) or typeof(action) ~= "string" then return end
	local ok, message
	if action == "choose" and (a == "solo" or a == "coop") then
		ok, message = OfficeManager.chooseMode(player, a)
	elseif action == "invite" and TerminalAccess.finiteInteger(a, 1, 9007199254740991) then
		ok, message = OfficeManager.invite(player, a)
	elseif action == "respond" and typeof(a) == "string" and #a <= 32 and typeof(b) == "boolean" then
		ok, message = OfficeManager.respondInvite(player, a, b)
	elseif action == "revoke" and TerminalAccess.finiteInteger(a, 1, 9007199254740991) then
		ok, message = OfficeManager.revokeGuest(player, a)
	elseif action == "leave" then
		ok, message = OfficeManager.leaveSession(player)
	else return end
	Net.event("OfficeSessionUpdated"):FireClient(player, OfficeManager.sessionView(player))
	if message then Net.event("Notify"):FireClient(player, { title = "Office Access", body = message, kind = ok and "info" or "warn" }) end
end)

Net.event("CloseTerminal").OnServerEvent:Connect(closeTerminal)
Players.PlayerRemoving:Connect(function(player) TerminalAccess.remove(player) end)

task.spawn(function()
	while true do
		task.wait(0.5)
		for _, player in ipairs(Players:GetPlayers()) do
			if TerminalAccess.current(player) and not TerminalAccess.valid(player) then closeTerminal(player) end
		end
	end
end)

-- The live ticker. Everyone sees everyone else's big moments, which is most of
-- what makes a server feel alive.
local function broadcast(text: string, kind: string?)
	Net.event("Broadcast"):FireAllClients({ text = text, kind = kind })
end

--------------------------------------------------------------------------------
-- Managers
--------------------------------------------------------------------------------

PlayerDataManager.start()
CallManager.beginRuntime()
LeaderboardManager.start()
MonetisationManager.start()
CosmeticsManager.start()
OperationManager.start()

-- leaderstats so Credits and Rank appear on the Roblox player list.
local function setupLeaderstats(player: Player, view)
	local existing = player:FindFirstChild("leaderstats")
	if not existing then
		existing = Instance.new("Folder")
		existing.Name = "leaderstats"
		existing.Parent = player

		local credits = Instance.new("IntValue")
		credits.Name = "Credits"
		credits.Parent = existing

		local rank = Instance.new("StringValue")
		rank.Name = "Rank"
		rank.Parent = existing
	end
	if view then
		existing.Credits.Value = math.floor(view.credits)
		existing.Rank.Value = view.rankName
	end
end

PlayerDataManager.DataChanged.Event:Connect(function(player, view)
	setupLeaderstats(player, view)
	Net.event("DataUpdated"):FireClient(player, view)
	for _, viewer in ipairs(Players:GetPlayers()) do
		if OfficeManager.sessionHost(viewer) == player then pushOfficeView(viewer) end
	end
end)

Players.PlayerAdded:Connect(function(player)
	setupLeaderstats(player, nil)
end)

--------------------------------------------------------------------------------
-- Rank-up and achievement notifications
--------------------------------------------------------------------------------

local lastRank = {}

PlayerDataManager.DataChanged.Event:Connect(function(player, view)
	local previous = lastRank[player.UserId]
	if previous and view.rankIndex > previous then
		Net.event("RankChanged"):FireClient(player, {
			from = Ranks.get(previous).name,
			to = view.rankName,
			perks = view.rankPerks,
		})
		Net.event("Broadcast"):FireAllClients({
			text = player.DisplayName .. " got promoted to " .. view.rankName,
			kind = "gold",
		})
	end
	lastRank[player.UserId] = view.rankIndex
end)

Players.PlayerRemoving:Connect(function(player)
	lastRank[player.UserId] = nil
end)

AchievementManager.Unlocked.Event:Connect(function(player, achievement)
	Net.event("AchievementUnlocked"):FireClient(player, achievement)
end)

OperationManager.Changed.Event:Connect(function(player, view)
	OfficeManager.update(player, view)
	for _, viewer in ipairs(Players:GetPlayers()) do
		if OfficeManager.sessionHost(viewer) == player then Net.event("OperationUpdated"):FireClient(viewer, view) end
	end
end)

OperationManager.OfflineEarnings.Event:Connect(function(player, amount, seconds)
	Net.event("OfflineEarnings"):FireClient(player, {
		amount = amount,
		seconds = seconds,
		capped = seconds >= (OperationManager.summary(player) or {}).offlineCapSeconds,
	})
end)

HeatManager.Warned.Event:Connect(function(player, warning)
	for _, viewer in ipairs(Players:GetPlayers()) do
		if OfficeManager.sessionHost(viewer) == player then Net.event("HeatWarning"):FireClient(viewer, warning) end
	end
end)

OperationManager.Raided.Event:Connect(function(player, outcome)
	for _, viewer in ipairs(Players:GetPlayers()) do
		if OfficeManager.sessionHost(viewer) == player then
			Net.event("RaidAlert"):FireClient(viewer, outcome)
			Net.event("OperationUpdated"):FireClient(viewer, OperationManager.view(player))
		end
	end
	OfficeManager.update(player, OperationManager.view(player))
	-- Everyone gets to watch the car turn up.
	EnvironmentBuilder.showRaid(player.DisplayName, outcome.escaped and 12 or Operation.Raid.ShutdownSeconds)
	broadcast(
		outcome.escaped and (player.DisplayName .. " just talked their way out of a raid")
			or (player.DisplayName .. "'s floor just got raided"),
		outcome.escaped and "success" or "warn"
	)
	AchievementManager.evaluate(player, nil)
end)

MonetisationManager.Granted.Event:Connect(function(player, product, message)
	Net.event("Notify"):FireClient(player, {
		title = product.name,
		body = message,
		kind = "gold",
	})
end)

MonetisationManager.PassChanged.Event:Connect(function(player, pass)
	Net.event("Notify"):FireClient(player, {
		title = pass.name .. " unlocked",
		body = pass.blurb,
		kind = "gold",
	})
end)

UpgradeManager.Purchased.Event:Connect(function(player, def)
	Net.event("Notify"):FireClient(player, {
		title = "Upgrade Installed",
		body = def.name .. " - " .. def.blurb,
		kind = "success",
	})
end)

CallManager.CallFinished.Event:Connect(function(player, result, reward)
	LeaderboardManager.publish(player)
	-- Career-total achievements that do not depend on the call itself.
	AchievementManager.evaluate(player, nil)

	local data = PlayerDataManager.get(player)
	local streak = data and data.stats.successStreak or 0
	if result.outcome == "success" then
		broadcast(string.format(
			"%s talked %s (%d) into %s Credits",
			player.DisplayName,
			result.npc.firstName,
			result.npc.age,
			tostring(reward)
		), "success")
		if streak >= 3 then
			broadcast(string.format("%s is on a %d call streak", player.DisplayName, streak), "gold")
		end
	elseif result.npc.personalityId == "police_desk" then
		broadcast(player.DisplayName .. " just cold-called a police station", "warn")
	elseif result.outcome == "exposed" and result.stage and result.stage >= 6 then
		broadcast(string.format(
			"%s got rumbled by %s at the last hurdle",
			player.DisplayName,
			result.npc.firstName
		), "warn")
	end
end)

--------------------------------------------------------------------------------
-- Remote handlers
--------------------------------------------------------------------------------

Net.event("StartCall").OnServerEvent:Connect(function(player, difficultyKey)
	if not TerminalAccess.authorize(player, "StartCall") then return end
	if typeof(difficultyKey) ~= "string" then
		return
	end
	local level = Difficulty.Levels[difficultyKey]
	if not level then
		return
	end
	local owner = OfficeManager.sessionHost(player)
	if not owner then return end
	local ok, reason = CallManager.start(player, difficultyKey, owner)
	if not ok then
		Net.event("Notify"):FireClient(player, { title = "Cannot Start Call", body = reason, kind = "warn" })
	end
end)

Net.event("ChooseOption").OnServerEvent:Connect(function(player, index)
	if not TerminalAccess.authorize(player, "ChooseOption") or not TerminalAccess.finiteInteger(index, 1, 4) then
		return
	end
	CallManager.choose(player, math.floor(index))
end)

Net.event("HangUp").OnServerEvent:Connect(function(player)
	CallManager.hangUp(player)
end)

Net.event("PurchaseUpgrade").OnServerEvent:Connect(function(player, upgradeId)
	if not TerminalAccess.authorize(player, "PurchaseUpgrade") then return end
	if typeof(upgradeId) ~= "string" then
		return
	end
	local ok, message = UpgradeManager.purchase(player, upgradeId)
	Net.event("Notify"):FireClient(player, {
		title = ok and "Purchased" or "Purchase Failed",
		body = message,
		kind = ok and "success" or "warn",
	})
	if ok then
		AchievementManager.evaluate(player, nil)
	end
end)

Net.event("SetDifficulty").OnServerEvent:Connect(function(player, key)
	if not TerminalAccess.authorize(player, "SetDifficulty") then return end
	if typeof(key) ~= "string" or not Difficulty.Levels[key] then
		return
	end
	local owner = OfficeManager.sessionHost(player)
	local data = owner and PlayerDataManager.get(owner)
	local level = Difficulty.Levels[key]
	if data and data.rankIndex < level.minRankIndex then
		Net.event("Notify"):FireClient(player, {
			title = "Locked",
			body = level.label .. " unlocks at " .. Ranks.get(level.minRankIndex).name .. ".",
			kind = "warn",
		})
		return
	end
	if owner == player then PlayerDataManager.setDifficulty(player, key) end
end)

Net.event("PromptPurchase").OnServerEvent:Connect(function(player, kind, itemId)
	if not TerminalAccess.authorize(player, "PromptPurchase") then return end
	if typeof(kind) ~= "string" or typeof(itemId) ~= "string" then
		return
	end
	local ok, reason
	if kind == "pass" then
		ok, reason = MonetisationManager.promptPass(player, itemId)
	elseif kind == "product" then
		ok, reason = MonetisationManager.promptProduct(player, itemId)
	else
		return
	end
	if not ok then
		Net.event("Notify"):FireClient(player, { title = "Store", body = reason, kind = "warn" })
	end
end)

Net.event("UseItem").OnServerEvent:Connect(function(player, productId)
	if not TerminalAccess.authorize(player, "UseItem") then return end
	if typeof(productId) ~= "string" then
		return
	end
	local ok, message = CallManager.useItem(player, productId)
	Net.event("Notify"):FireClient(player, {
		title = ok and "Item Used" or "Cannot Use That",
		body = message,
		kind = ok and "success" or "warn",
	})
end)

Net.event("SetAlias").OnServerEvent:Connect(function(player, alias)
	if not TerminalAccess.throttle(player, "alias", 2) then return end
	if typeof(alias) ~= "string" then
		return
	end
	if not MonetisationManager.owns(player, "alias_licence") then
		Net.event("Notify"):FireClient(player, {
			title = "Alias Licence",
			body = "You need the Alias Licence to change your technician name.",
			kind = "warn",
		})
		return
	end

	alias = string.gsub(alias, "^%s+", "")
	alias = string.gsub(alias, "%s+$", "")
	if #alias < 2 or #alias > 16 or string.match(alias, "[^%a%s'%-]") then
		Net.event("Notify"):FireClient(player, {
			title = "Alias Rejected",
			body = "Two to sixteen letters, please.",
			kind = "warn",
		})
		return
	end

	-- Filter it even though only the buyer ever sees it -- it is user text.
	local ok, filtered = pcall(function()
		local result = TextService:FilterStringAsync(alias, player.UserId)
		return result:GetNonChatStringForBroadcastAsync()
	end)
	if not ok then
		Net.event("Notify"):FireClient(player, {
			title = "Alias Rejected",
			body = "Could not check that name. Try again.",
			kind = "warn",
		})
		return
	end

	PlayerDataManager.setAlias(player, filtered)
	Net.event("Notify"):FireClient(player, {
		title = "Alias Set",
		body = "You are now " .. filtered .. " from Macrosoft Technical.",
		kind = "success",
	})
end)

local OPERATION_ACTIONS = {
	setMethod = function(player, a)
		return OperationManager.setMethod(player, a)
	end,
	buyFacility = function(player, a)
		return OperationManager.buyFacility(player, a)
	end,
	buySecurity = function(player, a)
		return OperationManager.buySecurity(player, a)
	end,
	buyTradecraft = function(player, a)
		return OperationManager.buyTradecraft(player, a)
	end,
	hire = function(player, a, b)
		return OperationManager.hire(player, a, b)
	end,
	fire = function(player, a, b)
		return OperationManager.fire(player, a, b)
	end,
	layLow = function(player)
		return OperationManager.layLow(player)
	end,
	useItem = function(player, a)
		return OperationManager.useItem(player, a)
	end,
}

Net.event("OperationAction").OnServerEvent:Connect(function(player, action, a, b)
	if typeof(action) ~= "string" then
		return
	end
	local handler = OPERATION_ACTIONS[action]
	if not handler then
		return
	end
	if not TerminalAccess.authorize(player, action) then return end
	if a ~= nil and typeof(a) ~= "string" then
		return
	end
	if b ~= nil and not TerminalAccess.finiteInteger(b, 1, 25) then
		return
	end

	local ok, message = handler(player, a, b)
	if message and message ~= "" then
		Net.event("Notify"):FireClient(player, {
			title = ok and "Operation" or "Cannot Do That",
			body = message,
			kind = ok and "success" or "warn",
		})
	end
	if ok then
		AchievementManager.evaluate(player, nil)
	end
end)

Net.event("RequestData").OnServerEvent:Connect(function(player)
	if not TerminalAccess.throttle(player, "data", 1) then return end
	PlayerDataManager.notify(player)
end)

Net.func("GetData").OnServerInvoke = function(player)
	return PlayerDataManager.publicView(player)
end

Net.func("GetOperation").OnServerInvoke = function(player)
	return OperationManager.view(OfficeManager.sessionHost(player) or player)
end

Net.func("GetOfficeSession").OnServerInvoke = function(player)
	if not TerminalAccess.throttle(player, "officeRead", 0.5) then return nil end
	pushOfficeView(player)
	return OfficeManager.sessionView(player)
end

Net.func("GetStore").OnServerInvoke = function(player)
	return MonetisationManager.catalog(player)
end

Net.func("GetCatalog").OnServerInvoke = function(player)
	local difficulties = {}
	for _, key in ipairs(Difficulty.Order) do
		local level = Difficulty.Levels[key]
		table.insert(difficulties, {
			key = level.key,
			label = level.label,
			blurb = level.blurb,
			minRankIndex = level.minRankIndex,
			minRankName = Ranks.get(level.minRankIndex).name,
			rewardMul = level.rewardMul,
			order = level.order,
		})
	end

	local ranks = {}
	for _, rank in ipairs(Ranks.List) do
		table.insert(ranks, {
			index = rank.index,
			name = rank.name,
			lifetime = rank.lifetime,
			calls = rank.calls,
			perks = rank.perks,
		})
	end

	return {
		upgrades = UpgradeManager.catalog(player),
		achievements = AchievementManager.catalog(player),
		difficulties = difficulties,
		ranks = ranks,
		version = Config.Version,
		content = {
			personalities = Personalities.count(),
			situations = DialogueLibrary.count(),
			events = RandomEvents.count(),
			upgrades = #Upgrades.List,
		},
	}
end

local configuredProducts = 0
for _, def in ipairs(Products.GamePasses) do
	configuredProducts += Products.isConfigured(def) and 1 or 0
end
for _, def in ipairs(Products.DeveloperProducts) do
	configuredProducts += Products.isConfigured(def) and 1 or 0
end

print(string.format(
	"[Macrosoft] v%s online - %d personalities, %d dialogue situations, %d random events, %d upgrades.",
	Config.Version,
	Personalities.count(),
	DialogueLibrary.count(),
	RandomEvents.count(),
	#Upgrades.List
))
print(string.format(
	"[Macrosoft] Robux store: %d of %d items have an asset id set. Items without one show as unavailable.",
	configuredProducts,
	#Products.GamePasses + #Products.DeveloperProducts
))
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX68">
				<Properties>
					<string name="Name">MonetisationManager</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- MonetisationManager
-- Everything Robux touches. Owns game-pass ownership caching, the
-- ProcessReceipt callback for Developer Products, and the grants those
-- purchases hand out.
--
-- Two rules this module exists to enforce:
--   1. A Developer Product grant is written to the profile and SAVED before
--      PurchaseGranted is returned. Returning granted on an unsaved grant is how
--      players lose purchases when a server dies.
--   2. Grants are idempotent on PurchaseId, because Roblox will replay
--      ProcessReceipt until it gets an answer it likes.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared")
local Products = require(Shared.Products)

local PlayerDataManager = require(script.Parent.PlayerDataManager)
local OperationManager = require(script.Parent.OperationManager)

local MonetisationManager = {}

MonetisationManager.Granted = Instance.new("BindableEvent")
MonetisationManager.PassChanged = Instance.new("BindableEvent")

-- Cached so a call never blocks on a web request.
local passCache: { [number]: { [string]: boolean } } = {}

-- Product information comes from Roblox so Managed Pricing changes are shown
-- without a code release. Cache successful lookups briefly to avoid spending a
-- web request every time somebody opens the kiosk. Failures use the catalogue's
-- suggested price for a much shorter window before trying Roblox again.
local LIVE_PRICE_TTL = 300
local FALLBACK_PRICE_TTL = 30
local priceCache = {}

local function currentPrice(def, infoType): (number, boolean)
	if not Products.isConfigured(def) then
		return def.suggestedRobux, false
	end

	local cacheKey = tostring(def.assetId)
	local cached = priceCache[cacheKey]
	if cached and cached.expiresAt > os.clock() then
		return cached.robux, cached.isLive
	end

	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfoAsync(def.assetId, infoType)
	end)
	local livePrice = ok and type(info) == "table" and tonumber(info.PriceInRobux) or nil
	local isLive = livePrice ~= nil and livePrice >= 0
	local robux = isLive and math.floor(livePrice) or def.suggestedRobux
	priceCache[cacheKey] = {
		robux = robux,
		isLive = isLive,
		expiresAt = os.clock() + (isLive and LIVE_PRICE_TTL or FALLBACK_PRICE_TTL),
	}
	if not ok then
		warn("[MonetisationManager] price lookup failed for " .. def.id .. ": " .. tostring(info))
	end
	return robux, isLive
end

--------------------------------------------------------------------------------
-- Game passes
--------------------------------------------------------------------------------

function MonetisationManager.refreshPasses(player: Player)
	local owned = {}
	for _, pass in ipairs(Products.GamePasses) do
		if Products.isConfigured(pass) then
			local ok, result = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.assetId)
			end)
			if ok then
				owned[pass.id] = result == true
			else
				-- Keep whatever we already believed rather than revoking a pass
				-- because one web request failed.
				owned[pass.id] = passCache[player.UserId] and passCache[player.UserId][pass.id] or PlayerDataManager.ownsPass(player, pass.id)
				warn("[MonetisationManager] pass check failed for " .. pass.id .. ": " .. tostring(result))
			end
		end
	end
	passCache[player.UserId] = owned

	for passId, isOwned in pairs(owned) do
		local had = PlayerDataManager.ownsPass(player, passId)
		PlayerDataManager.setPassOwned(player, passId, isOwned)
		if isOwned and not had then
			MonetisationManager.PassChanged:Fire(player, Products.PassById[passId])
		end
	end
	return owned
end

function MonetisationManager.owns(player: Player, passId: string): boolean
	return PlayerDataManager.ownsPass(player, passId)
end

function MonetisationManager.promptPass(player: Player, passId: string): (boolean, string)
	local pass = Products.PassById[passId]
	if not pass then
		return false, "Unknown item."
	end
	if not Products.isConfigured(pass) then
		return false, pass.name .. " has not been set up yet (no asset id)."
	end
	if PlayerDataManager.ownsPass(player, passId) then
		return false, "You already own that."
	end
	local ok, err = pcall(function()
		MarketplaceService:PromptGamePassPurchase(player, pass.assetId)
	end)
	if not ok then
		return false, tostring(err)
	end
	return true, ""
end

function MonetisationManager.promptProduct(player: Player, productId: string): (boolean, string)
	local product = Products.ProductById[productId]
	if not product then
		return false, "Unknown item."
	end
	if not Products.isConfigured(product) then
		return false, product.name .. " has not been set up yet (no asset id)."
	end
	local ok, err = pcall(function()
		MarketplaceService:PromptProductPurchase(player, product.assetId)
	end)
	if not ok then
		return false, tostring(err)
	end
	return true, ""
end

--------------------------------------------------------------------------------
-- Developer products
--------------------------------------------------------------------------------

local function grant(player: Player, product): (boolean, string)
	local kind = product.grant.kind

	if kind == "credits" then
		PlayerDataManager.addCredits(player, product.grant.amount, false)
		return true, string.format("%d Credits added.", product.grant.amount)
	elseif kind == "boost" then
		PlayerDataManager.addBoost(player, product.grant.seconds, product.grant.multiplier)
		return true, string.format("Double Credits for %d minutes.", math.floor(product.grant.seconds / 60))
	elseif kind == "payslip" then
		local summary = OperationManager.summary(player)
		local seconds = product.grant.hours * 3600
		local amount = math.floor((summary and summary.netIncome or 0) * seconds)
		if amount <= 0 then
			-- Nothing to pay out yet; bank it as a consumable so the purchase is
			-- never simply eaten.
			PlayerDataManager.addItem(player, product.id, 1)
			return true, "You have no staff yet, so this is saved in your drawer for later."
		end
		OperationManager.creditPassive(player, amount)
		return true, string.format("%d hours of passive income collected.", product.grant.hours)
	elseif kind == "consumable" then
		PlayerDataManager.addItem(player, product.id, product.grant.amount or 1)
		return true, product.name .. " added to your desk drawer."
	end

	return false, "Unknown grant type."
end

-- Wired up by MacrosoftServer. Returns a ProductPurchaseDecision.
function MonetisationManager.processReceipt(receiptInfo)
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		-- They left mid-purchase. Do not consume it; Roblox retries when they
		-- next join a server.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local profile = PlayerDataManager.get(player)
	if not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if profile.loadFailed then
		-- Saving is disabled this session, so a grant would silently vanish.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local product = Products.productByAssetId(receiptInfo.ProductId)
	if not product then
		warn("[MonetisationManager] receipt for unknown product " .. tostring(receiptInfo.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local receiptId = tostring(receiptInfo.PurchaseId)
	if not PlayerDataManager.claimReceipt(player, receiptId) then
		-- Already granted in an earlier attempt.
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local ok, message = grant(player, product)
	if not ok then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Persist before confirming. If the save fails we hand the receipt back so
	-- Roblox retries rather than charging for something we did not keep.
	if not PlayerDataManager.save(player, false) then
		warn("[MonetisationManager] could not save grant for " .. player.Name .. "; asking Roblox to retry.")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	MonetisationManager.Granted:Fire(player, product, message)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

--------------------------------------------------------------------------------
-- Catalogue view for the store UI
--------------------------------------------------------------------------------

function MonetisationManager.catalog(player: Player)
	local data = PlayerDataManager.get(player)
	local passes = {}
	for _, pass in ipairs(Products.GamePasses) do
		local robux, priceIsLive = currentPrice(pass, Enum.InfoType.GamePass)
		table.insert(passes, {
			id = pass.id,
			assetId = pass.assetId,
			name = pass.name,
			blurb = pass.blurb,
			order = pass.order,
			robux = robux,
			priceIsLive = priceIsLive,
			configured = Products.isConfigured(pass),
			owned = data ~= nil and data.premium.passes[pass.id] == true,
			cosmetic = pass.cosmetic == true,
		})
	end
	table.sort(passes, function(a, b)
		return a.order < b.order
	end)

	local products = {}
	for _, product in ipairs(Products.DeveloperProducts) do
		local robux, priceIsLive = currentPrice(product, Enum.InfoType.Product)
		table.insert(products, {
			id = product.id,
			assetId = product.assetId,
			name = product.name,
			blurb = product.blurb,
			order = product.order,
			robux = robux,
			priceIsLive = priceIsLive,
			configured = Products.isConfigured(product),
			owned = data ~= nil and (data.premium.inventory[product.id] or 0) or 0,
			usableInCall = product.usableInCall == true,
			usableInOperation = product.usableInOperation == true,
			useLabel = product.useLabel,
		})
	end
	table.sort(products, function(a, b)
		return a.order < b.order
	end)

	return { passes = passes, products = products }
end

function MonetisationManager.start()
	MarketplaceService.ProcessReceipt = MonetisationManager.processReceipt

	-- Warm the cache in parallel. The kiosk still resolves a missing entry on
	-- demand, so an early interaction remains correct.
	for _, pass in ipairs(Products.GamePasses) do
		task.spawn(currentPrice, pass, Enum.InfoType.GamePass)
	end
	for _, product in ipairs(Products.DeveloperProducts) do
		task.spawn(currentPrice, product, Enum.InfoType.Product)
	end

	local function onJoin(player: Player)
		task.spawn(function()
			-- Wait for the profile so ownership has somewhere to land.
			local deadline = os.clock() + 20
			while not PlayerDataManager.get(player) and os.clock() < deadline do
				task.wait(0.25)
			end
			if PlayerDataManager.get(player) then
				MonetisationManager.refreshPasses(player)
			end
		end)
	end

	Players.PlayerAdded:Connect(onJoin)
	for _, player in ipairs(Players:GetPlayers()) do
		onJoin(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		passCache[player.UserId] = nil
	end)

	-- Re-check ownership right after a prompt closes, so a pass bought in-game
	-- takes effect without rejoining.
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, _assetId, wasPurchased)
		if wasPurchased then
			task.spawn(MonetisationManager.refreshPasses, player)
		end
	end)
end

return MonetisationManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX69">
				<Properties>
					<string name="Name">NPCGenerator</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- NPCGenerator
-- Rolls a fresh caller: personality, name, age, mood, backstory, starting meters.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Difficulty = require(Shared.Difficulty)
local Personalities = require(Shared.Personalities)
local NPCNames = require(Shared.NPCNames)

local NPCGenerator = {}

-- Portrait colours are picked deterministically from the name so the same NPC
-- always looks the same within a call.
local PORTRAIT_COLOURS = {
	Color3.fromRGB(226, 135, 67),
	Color3.fromRGB(105, 168, 233),
	Color3.fromRGB(148, 196, 121),
	Color3.fromRGB(214, 121, 168),
	Color3.fromRGB(233, 196, 106),
	Color3.fromRGB(151, 137, 220),
	Color3.fromRGB(102, 194, 189),
	Color3.fromRGB(224, 108, 108),
}

local function pickTier(difficultyKey: string, bonuses, random: Random): string
	local level = Difficulty.get(difficultyKey)
	local pool = {}
	for tier, weight in pairs(level.tiers) do
		local w = weight
		-- "easyChance" upgrades bias the roll toward the gentler tiers.
		if tier == "Easy" or tier == "Normal" then
			w += (bonuses.easyChance or 0) * 10
		end
		table.insert(pool, { tier = tier, weight = w })
	end
	local choice = Util.weightedPick(pool, random)
	return choice and choice.tier or "Normal"
end

-- One step down the tier ladder. Used by the Warm Lead item.
local TIER_ORDER = { "Easy", "Normal", "Hard", "Expert", "Nightmare" }
local function friendlierTier(tier: string): string
	for index, name in ipairs(TIER_ORDER) do
		if name == tier then
			return TIER_ORDER[math.max(1, index - 1)]
		end
	end
	return tier
end

-- options: { warmLead: boolean? }
function NPCGenerator.generate(difficultyKey: string, bonuses, seed: number?, options)
	local random = Util.newRandom(seed)
	local level = Difficulty.get(difficultyKey)
	bonuses = bonuses or {}
	options = options or {}

	local tier = pickTier(difficultyKey, bonuses, random)
	if options.warmLead then
		tier = friendlierTier(tier)
	end
	local pool = Personalities.ofTier(tier)
	if #pool == 0 then
		pool = Personalities.ofTier("Normal")
	end
	local personality = Util.pick(pool, random)

	local firstName = Util.pick(NPCNames.First, random)
	local lastName = Util.pick(NPCNames.Last, random)
	local mood = Util.pick(NPCNames.Moods, random)
	local town = Util.pick(NPCNames.Towns, random)
	local job = Util.pick(NPCNames.Jobs, random)
	local backstory = Util.pick(NPCNames.Backstories, random)

	local age = random:NextInteger(personality.ageRange[1], personality.ageRange[2])
	local tech = random:NextInteger(personality.techRange[1], personality.techRange[2])

	local startTrust = personality.base.trust + (bonuses.startTrust or 0)
	local startSuspicion = personality.base.suspicion + mood.suspicion + (bonuses.startSuspicion or 0)
	local startPatience = personality.base.patience + mood.patience + (bonuses.patienceBonus or 0)

	startTrust = Util.clamp(startTrust, 0, Config.Call.MaxTrust)
	startSuspicion = Util.clamp(startSuspicion, 0, 90)
	startPatience = Util.clamp(startPatience * level.patienceMul, 10, Config.Call.MaxPatience)

	local colour = PORTRAIT_COLOURS[(#firstName + #lastName + age) % #PORTRAIT_COLOURS + 1]

	return {
		personalityId = personality.id,
		personalityName = personality.name,
		blurb = personality.blurb,
		tier = tier,
		firstName = firstName,
		lastName = lastName,
		fullName = firstName .. " " .. lastName,
		initials = string.sub(firstName, 1, 1) .. string.sub(lastName, 1, 1),
		age = age,
		techKnowledge = tech,
		job = job,
		town = town,
		moodId = mood.id,
		moodLabel = mood.label,
		backstory = string.format("%s, %d, a %s from %s who %s.", firstName, age, job, town, backstory),
		portraitColour = colour,

		trust = startTrust,
		suspicion = startSuspicion,
		patience = startPatience,

		quirks = Util.deepCopy(personality.quirks or {}),
		rewardMul = personality.reward or 1,
		warmLead = options.warmLead == true,
		seed = seed or random:NextInteger(1, 2 ^ 30),
	}
end

-- Small helper used by the UI: a one-line "who am I talking to" summary.
function NPCGenerator.describe(npc): string
	return string.format("%s (%d) - %s", npc.fullName, npc.age, npc.personalityName)
end

return NPCGenerator
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX70">
				<Properties>
					<string name="Name">NPCPersonalitySystem</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- NPCPersonalitySystem
-- Turns "player picked choice X" into "the NPC feels Y and says Z".
--
-- Resolution order:
--   1. base deltas from the choice
--   2. personality like/dislike tag multipliers
--   3. difficulty multipliers and upgrade resistance
--   4. mood, call length and repetition penalties
--   5. quirk overrides (tech-savvy NPCs punish jargon, etc.)
--   6. pick a reaction category and a voice line for it

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Difficulty = require(Shared.Difficulty)
local Personalities = require(Shared.Personalities)

local NPCPersonalitySystem = {}

local function tagMultiplier(map, tags): number
	local mult = 1
	if not map then
		return mult
	end
	for _, tag in ipairs(tags) do
		if map[tag] then
			mult *= map[tag]
		end
	end
	return mult
end

local function hasTag(tags, wanted): boolean
	return Util.contains(tags, wanted)
end

-- Reaction categories map onto personality.voice keys.
local function chooseReaction(npc, personality, deltas, choice, random: Random): string
	local tags = choice.tags or {}

	-- Quirk: technically-minded callers call out jargon immediately.
	if personality.quirks and personality.quirks.exposesTechnical and hasTag(tags, "technical") then
		return "laugh"
	end
	if hasTag(tags, "aggressive") then
		return "angry"
	end
	if npc.suspicion >= 85 then
		return "accuse"
	end
	if npc.suspicion >= 60 then
		return random:NextNumber() < 0.5 and "nervous" or "question"
	end
	if personality.quirks and personality.quirks.pretendsToCooperate and npc.suspicion >= 30 then
		return "pretend"
	end
	if personality.quirks and personality.quirks.wastesTime and random:NextNumber() < 0.3 then
		return "waste"
	end
	if hasTag(tags, "absurd") or hasTag(tags, "humour") then
		if random:NextNumber() < 0.55 then
			return "laugh"
		end
	end
	if deltas.trust >= 10 then
		return "believe"
	end
	if deltas.trust <= 0 then
		return "question"
	end
	if npc.patience <= 25 then
		return "waste"
	end
	return random:NextNumber() < 0.5 and "believe" or "question"
end

local function voiceLine(personality, category: string, random: Random): string
	local lines = personality.voice and personality.voice[category]
	if not lines or #lines == 0 then
		lines = personality.voice and personality.voice.question
	end
	if not lines or #lines == 0 then
		return "..."
	end
	return Util.pick(lines, random)
end

-- callState fields used: elapsed, tagHistory, difficultyKey, bonuses, mistakes
function NPCPersonalitySystem.resolve(npc, choice, callState)
	local personality = Personalities.get(npc.personalityId)
	local level = Difficulty.get(callState.difficultyKey)
	local random = Util.newRandom()
	local tags = choice.tags or {}
	local bonuses = callState.bonuses or {}

	local trustDelta = choice.trust or 0
	local suspicionDelta = choice.suspicion or 0
	local patienceDelta = choice.patience or 0

	-- 2. personality affinity
	local likeMul = tagMultiplier(personality.likes, tags)
	local dislikeMul = tagMultiplier(personality.dislikes, tags)

	if trustDelta > 0 then
		trustDelta *= likeMul
		-- Disliked tags blunt good lines as well as adding suspicion.
		trustDelta /= math.max(1, dislikeMul * 0.6)
	else
		trustDelta *= dislikeMul
	end

	if suspicionDelta > 0 then
		suspicionDelta *= dislikeMul
		suspicionDelta /= math.max(1, likeMul * 0.5)
	else
		suspicionDelta *= likeMul
	end

	-- 3. difficulty + personality modifiers + upgrades
	trustDelta *= (personality.mods.trustMul or 1) * level.trustMul
	local suspicionMultiplier = ((personality.mods.suspicionMul or 1) * level.suspicionMul)
		^ Config.Call.SuspicionMultiplierSoftening
	suspicionDelta *= suspicionMultiplier
	if suspicionDelta > 0 then
		suspicionDelta *= (bonuses.suspicionResist or 1)
	end

	-- 4a. repetition: leaning on the same tag over and over stops working
	local repeats = 0
	for _, tag in ipairs(tags) do
		repeats = math.max(repeats, callState.tagHistory[tag] or 0)
	end
	if repeats >= 2 then
		local fatigue = math.min(0.6, (repeats - 1) * 0.15)
		if trustDelta > 0 then
			trustDelta *= (1 - fatigue)
		end
		suspicionDelta += level.repeatPenalty * (repeats - 1)
	end

	-- 4b. long calls make everyone twitchier
	local minutes = (callState.elapsed or 0) / 60
	if minutes > 3 then
		suspicionDelta += (minutes - 3) * 0.8
	end

	-- 4c. patience always drains a little per exchange
	patienceDelta -= 2 * (personality.mods.patienceDrain or 1)

	-- 5. quirks
	local exposed = false
	if personality.quirks then
		if personality.quirks.exposesTechnical and hasTag(tags, "technical") then
			suspicionDelta += 14
			trustDelta = math.min(trustDelta, 0)
		end
		if personality.quirks.knowsTheScript and (hasTag(tags, "urgency") or hasTag(tags, "authority")) then
			suspicionDelta += 8
		end
		-- One decisive "I've clocked you" roll per call, never per exchange, and
		-- only once the call has gone on long enough to be worth it.
		if personality.quirks.instantExposeChance
			and not callState.exposeRolled
			and callState.stage >= 3
			and random:NextNumber() < personality.quirks.instantExposeChance
		then
			callState.exposeRolled = true
			suspicionDelta += 35
			exposed = true
		end
		if personality.quirks.mirrorsPlayer then
			-- The rival call centre copies whatever you do back at you.
			trustDelta *= 0.5
			suspicionDelta *= 0.8
		end
	end

	-- Aggression is always punished, on top of everything above.
	local aggressive = hasTag(tags, "aggressive")
	if aggressive then
		suspicionDelta += 6
		patienceDelta -= 6
	end

	-- Global scaling. Without this a 14-exchange call always tops out at 100
	-- suspicion no matter how well it is played.
	trustDelta *= Config.Call.TrustScale
	if suspicionDelta > 0 then
		suspicionDelta *= Config.Call.SuspicionScale
	end

	-- A line that really lands buys back a little goodwill. Two routes into this,
	-- because a hostile personality's low trust multiplier would otherwise make
	-- the first route unreachable and leave the call mathematically unwinnable:
	--   1. the line landed hard in absolute terms
	--   2. the line hit tags this particular caller likes
	if trustDelta >= Config.Call.ReassureTrust then
		suspicionDelta -= Config.Call.ReassureAmount
	end
	if (choice.trust or 0) > 0 and likeMul > 1.2 then
		suspicionDelta -= Config.Call.ReassureAmount * math.min(2, likeMul - 1)
	end

	trustDelta = Util.round(trustDelta, 1)
	suspicionDelta = Util.round(suspicionDelta, 1)
	patienceDelta = Util.round(patienceDelta, 1)

	local deltas = { trust = trustDelta, suspicion = suspicionDelta, patience = patienceDelta }

	-- 6. reaction line
	local category = chooseReaction(npc, personality, deltas, choice, random)
	if exposed then
		category = "accuse"
	end
	local line = voiceLine(personality, category, random)

	return {
		deltas = deltas,
		category = category,
		line = line,
		exposed = exposed,
		aggressive = aggressive,
		mistake = suspicionDelta > 12 or trustDelta < 0,
	}
end

-- Line used when the NPC finally walks away.
function NPCPersonalitySystem.exitLine(npc, outcome: string): string
	local personality = Personalities.get(npc.personalityId)
	local random = Util.newRandom()
	if outcome == "success" then
		return voiceLine(personality, "believe", random)
	elseif outcome == "exposed" then
		return voiceLine(personality, "accuse", random)
	elseif outcome == "bored" then
		return voiceLine(personality, "waste", random)
	end
	return voiceLine(personality, "hangup", random)
end

function NPCPersonalitySystem.greeting(npc): string
	local personality = Personalities.get(npc.personalityId)
	return voiceLine(personality, "greet", Util.newRandom())
end

-- True when this personality can never be convinced (baiters, police, rivals).
function NPCPersonalitySystem.canSucceed(npc): boolean
	local personality = Personalities.get(npc.personalityId)
	return not (personality.quirks and personality.quirks.neverSucceeds)
end

return NPCPersonalitySystem
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX71">
				<Properties>
					<string name="Name">OfficeManager</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Physical presentation of the existing saved operation; never computes rewards.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared")
local Operation = require(Shared.Operation)
local Util = require(Shared.Util)
local Environment = require(script.Parent.EnvironmentBuilder)
local Data = require(script.Parent.PlayerDataManager)
local Access = require(script.Parent.TerminalAccess)
local Sessions = require(script.Parent.OfficeSessions)
local OfficeManager = {}
local offices, slots = {}, {}
local policy = Sessions.new()
local removing = setmetatable({}, { __mode = "k" })
local initialized = setmetatable({}, { __mode = "k" })
local onTerminal
OfficeManager.SessionChanged = Instance.new("BindableEvent")
OfficeManager.Travelling = Instance.new("BindableEvent")
local cyan = Color3.fromRGB(30, 225, 235)
local gold = Color3.fromRGB(255, 191, 60)
local pink = Color3.fromRGB(244, 75, 175)
local purple = Color3.fromRGB(133, 92, 235)

local function block(parent, name, size, cf, colour, material)
	return Environment.part({ Name = name, Size = size, CFrame = cf, Color = colour,
		Material = material or Enum.Material.SmoothPlastic, Parent = parent })
end

local function sign(parent, name, cf, text, colour, width)
	local board = block(parent, name, Vector3.new(width or 10, 3, 0.3), cf, Color3.fromRGB(22, 28, 55))
	return Environment.label(board, text, Enum.NormalId.Back, colour)
end

local function terminal(office, kind, title, x, z, colour, canUse)
	local cf = office.origin * CFrame.new(x, 0, z)
	local desk = Environment.buildDesk(office.model, cf, title)
	desk:SetAttribute("OwnerUserId", office.player.UserId)
	desk:SetAttribute("TerminalKind", kind)
	desk.Screen.Color = colour
	sign(desk, "TerminalSign", cf * CFrame.new(0, 7, -1), title, colour, 8)
	local anchor = desk.Screen
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Use Computer"
	prompt.ObjectText = title
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false -- server raycast is authoritative
	prompt.HoldDuration = 0.2
	prompt.Parent = anchor
	local spec = { kind = kind, anchor = anchor, model = desk, owner = office.player.UserId,
		canAccess = function(player) return OfficeManager.canEnter(player, office.player.UserId) end,
		canUse = function(player)
			return (player.UserId == office.player.UserId or kind == "workstation" or kind == "management")
				and (not canUse or canUse(player))
		end,
		canAct = function(player, action)
			if player.UserId == office.player.UserId then return true end
			-- Invited helpers make calls and inspect access controls; spending remains host-only.
			return kind == "workstation" and (action == "StartCall" or action == "ChooseOption" or action == "SetDifficulty")
		end,
	}
	prompt.Triggered:Connect(function(player)
		if Access.throttle(player, "prompt", 0.4) and Access.near(player, spec) then onTerminal(player, spec) end
	end)
	return desk
end

local function create(player)
	local slot = 1
	while slots[slot] do slot += 1 end
	slots[slot] = player
	local model = Instance.new("Model")
	model.Name = "Office_" .. player.UserId
	model:SetAttribute("OwnerUserId", player.UserId)
	model.Parent = Environment.getRoot()
	local office = { player = player, model = model, slot = slot,
		origin = CFrame.new(240 + ((slot - 1) % 4) * 220, 0, math.floor((slot - 1) / 4) * 240) }
	offices[player] = office
	-- Terminals are stable while the floor expands, so an upgrade cannot strand a session.
	office.desk = terminal(office, "workstation", "CALLS + CAMPAIGNS", -12, 0, cyan)
	terminal(office, "hr", "HR / RECRUITMENT", 0, 0, pink)
	terminal(office, "management", "OFFICE MANAGEMENT", 12, 0, gold)
	terminal(office, "security", "SECURITY / POLICE", -12, 13, Color3.fromRGB(255, 95, 95))
	terminal(office, "premium", "PREMIUM KIOSK", 12, 13, purple)
	office.status = sign(model, "SuspicionBoard", office.origin * CFrame.new(0, 11, -3), "POLICE HEAT: 0", cyan, 23)
	office.upgrades = sign(model, "UpgradeBoard", office.origin * CFrame.new(0, 15, -3), "BACK ROOM", gold, 25)
	local exit = block(model, "LobbyLift", Vector3.new(6, 0.2, 5), office.origin * CFrame.new(0, 0.1, 20), purple, Enum.Material.Neon)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Visit Leaderboards"
	prompt.ObjectText = "Lobby Lift"
	prompt.MaxActivationDistance = 8
	prompt.Parent = exit
	prompt.Triggered:Connect(function(visitor)
		if OfficeManager.canEnter(visitor, player.UserId) and Access.near(visitor, { anchor = exit, distance = 8 }) and Access.throttle(visitor, "travel", 2) then
			OfficeManager.visitLobby(visitor)
		end
	end)
	return office
end

function OfficeManager.sessionHost(player)
	return policy:host(player.UserId)
end

function OfficeManager.canEnter(player, ownerId)
	local record = policy:get(player.UserId)
	return record ~= nil and record.player == player and not removing[player] and policy:canEnter(player.UserId, ownerId)
end

local function travel(player, cf)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	OfficeManager.Travelling:Fire(player)
	Access.close(player)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	character:PivotTo(cf)
	return true
end

function OfficeManager.teleport(player)
	local host = OfficeManager.sessionHost(player)
	local office = host and offices[host]
	if not office or not OfficeManager.canEnter(player, host.UserId) then return false end
	return travel(player, office.origin * CFrame.new(0, 4, 9))
end

function OfficeManager.visitLobby(player)
	return travel(player, CFrame.new(0, 4, 44))
end

function OfficeManager.canManageAccess(player)
	local current = Access.current(player)
	return OfficeManager.sessionHost(player) == player and current ~= nil and Access.valid(player)
		and current.terminal.kind == "management" and current.terminal.owner == player.UserId
end

function OfficeManager.sessionView(player)
	if not initialized[player] then return nil end
	local view = policy:view(player.UserId)
	if not view then return nil end
	view.preference = Data.getOfficeMode(player)
	view.canManageAccess = OfficeManager.canManageAccess(player)
	view.candidates = {}
	if view.canManageAccess then
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= player and not OfficeManager.canEnter(other, player.UserId) then
				table.insert(view.candidates, { userId = other.UserId, name = other.DisplayName })
			end
		end
	end
	return view
end

local function changed(ids)
	for _, id in ipairs(ids) do
		local record = policy:get(id)
		if record then
			if record.player.SetAttribute then
				record.player:SetAttribute("OfficeHostUserId", record.hostUserId)
				record.player:SetAttribute("OfficeMode", record.mode or "pending")
			end
			OfficeManager.SessionChanged:Fire(record.player, OfficeManager.sessionView(record.player))
		end
	end
end

local function initializePreference(player)
	if initialized[player] or removing[player] or not Data.get(player) then return false end
	local record = policy:get(player.UserId)
	if not record or record.player ~= player then return false end
	initialized[player] = true
	local preference = Data.getOfficeMode(player)
	if preference then policy:choose(player.UserId, preference == "host_coop" and "coop" or "solo") end
	changed({ player.UserId })
	return preference ~= nil
end

function OfficeManager.chooseMode(player, mode)
	if not initialized[player] then return false, "Your profile is still loading." end
	local record = policy:get(player.UserId)
	if not record then return false, "Your office session is unavailable." end
	-- The first onboarding choice is made from the lobby. Once a preference
	-- exists, changing it requires the owner's physical Management computer.
	if not record.needsChoice and not OfficeManager.canManageAccess(player) then
		return false, "Use your own management computer to change Office Mode."
	end
	local ok, message = policy:choose(player.UserId, mode)
	if ok then
		Data.setOfficeMode(player, mode == "coop" and "host_coop" or "solo")
		changed({ player.UserId })
		OfficeManager.teleport(player)
	end
	return ok, message
end

function OfficeManager.invite(player, targetId)
	if not OfficeManager.canManageAccess(player) then return false, "Use your own management computer to invite." end
	local ok, message = policy:invite(player.UserId, targetId)
	if ok then changed({ player.UserId, targetId }) end
	return ok, message
end

function OfficeManager.respondInvite(player, id, accept)
	local ok, message, ids = policy:respond(player.UserId, id, accept)
	if ok and accept then OfficeManager.teleport(player) end
	changed(ids or { player.UserId })
	return ok, message
end

function OfficeManager.revokeGuest(player, targetId)
	if not OfficeManager.canManageAccess(player) then return false, "Use your own management computer to remove guests." end
	local guest = policy:get(targetId)
	local wasMember = guest and guest.hostUserId == player.UserId
	local ok, message, ids = policy:revoke(player.UserId, targetId)
	if ok and wasMember then
		if not OfficeManager.teleport(guest.player) then OfficeManager.visitLobby(guest.player) end
	end
	changed(ids or {})
	return ok, message
end

function OfficeManager.leaveSession(player)
	local ok, message, ids = policy:leave(player.UserId)
	if ok then
		if not OfficeManager.teleport(player) then OfficeManager.visitLobby(player) end
	end
	changed(ids or {})
	return ok, message
end

-- World entry is authorised separately from prompts. This also catches players
-- pushed, flown or teleported across a plot wall without using a lift.
function OfficeManager.enforce(player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local position = root.Position
	if not (math.abs(position.X) < math.huge and math.abs(position.Y) < math.huge and math.abs(position.Z) < math.huge) then
		OfficeManager.visitLobby(player)
		return
	end
	for owner, office in pairs(offices) do
		local p = office.origin:PointToObjectSpace(position)
		-- A fixed envelope covers the largest office and its exterior at every tier.
		if math.abs(p.X) <= 104 and p.Z >= -90 and p.Z <= 144 then
			if not OfficeManager.canEnter(player, owner.UserId) then
				if not OfficeManager.teleport(player) then OfficeManager.visitLobby(player) end
			end
			return
		end
	end
end

function OfficeManager.remove(player)
	removing[player] = true
	OfficeManager.Travelling:Fire(player)
	Access.remove(player)
	local departing = policy:get(player.UserId)
	local isCurrent = departing and departing.player == player
	local wasHost = isCurrent and departing.hostUserId == player.UserId
	local affected = isCurrent and policy:remove(player.UserId) or {}
	for _, id in ipairs(affected) do
		local record = policy:get(id)
		-- Guests of a disconnected host now belong to their own solo office.
		-- A guest disconnect must not relocate the surviving host or cancel their call.
		if wasHost and record and record.hostUserId == id then
			if not OfficeManager.teleport(record.player) then OfficeManager.visitLobby(record.player) end
		end
	end
	local office = offices[player]
	if office then
		Environment.removeEmployees(office.model)
		office.model:Destroy()
		slots[office.slot], offices[player] = nil, nil
	end
	initialized[player] = nil
	changed(affected)
end

function OfficeManager.update(player, view)
	if not view or removing[player] then return end
	policy:add(player)
	initializePreference(player)
	local firstVisit = offices[player] == nil
	local office = offices[player] or create(player)
	local profile = Data.get(player)
	if not profile then return end
	local facility = Operation.FacilityById[view.facility]
	local tier = facility.index
	local upgrades = 0
	for _, owned in pairs(profile.upgrades or {}) do if owned then upgrades += 1 end end
	office.upgrades.Text = string.format("%s | %s\n%d / %d DESKS  |  %d UPGRADES", player.DisplayName, facility.name, view.summary.headcount, facility.desks, upgrades)
	local paused = view.shutdownRemaining > 0 or view.layLowRemaining > 0
	office.status.Text = string.format("POLICE HEAT  %d / 100\n%s  |  SECURITY %d", math.floor(view.heat),
		paused and "FLOOR PAUSED" or ("+" .. Util.formatNumber(view.summary.netIncome) .. " / SEC"), view.summary.securityRating)
	office.status.TextColor3 = view.heat >= 70 and Color3.fromRGB(255, 85, 95) or cyan
	local signature = view.facility .. ":" .. upgrades .. ":" .. view.summary.securityRating
	if signature ~= office.signature then
		office.signature = signature
		if office.shell then office.shell:Destroy() end
		local shell = Instance.new("Model")
		shell.Name = "Premises"
		shell.Parent = office.model
		office.shell = shell
		local columns = math.min(9, math.max(3, math.ceil(math.sqrt(facility.desks))))
		local rows = math.ceil(facility.desks / columns)
		local width = math.max(44, columns * 11 + 8)
		local depth = 40 + rows * 10
		local centerZ = (depth - 12) / 2
		local floorColour = tier <= 2 and Color3.fromRGB(112, 74, 107) or Color3.fromRGB(30, 61, 85)
		block(shell, "Floor", Vector3.new(width, 1, depth), office.origin * CFrame.new(0, -0.5, centerZ), floorColour,
			tier <= 2 and Enum.Material.WoodPlanks or Enum.Material.Marble)
		block(shell, "Ceiling", Vector3.new(width, 0.6, depth), office.origin * CFrame.new(0, 19, centerZ), Color3.fromRGB(55, 46, 80))
		block(shell, "FrontWall", Vector3.new(width, 19, 1), office.origin * CFrame.new(0, 9.5, -6), Color3.fromRGB(77, 47, 105))
		block(shell, "BackWall", Vector3.new(width, 19, 1), office.origin * CFrame.new(0, 9.5, depth - 6), Color3.fromRGB(43, 88, 110))
		for _, side in ipairs({ -1, 1 }) do
			local glass = block(shell, "CityWindows", Vector3.new(0.5, 19, depth), office.origin * CFrame.new(side * width / 2, 9.5, centerZ), cyan, Enum.Material.Glass)
			glass.Transparency = tier >= 3 and 0.65 or 0.3
			block(shell, "NeonRail", Vector3.new(0.4, 0.4, depth), office.origin * CFrame.new(side * (width / 2 - 0.4), 1, centerZ), side == 1 and pink or cyan, Enum.Material.Neon)
			for z = 0, depth - 10, 16 do
				block(shell, "WindowFrame", Vector3.new(0.8, 19, 0.5), office.origin * CFrame.new(side * width / 2, 9.5, z), gold)
				local height = 22 + ((z * 7 + tier * 13) % 40)
				local tower = block(shell, "Skyline", Vector3.new(12, height, 12), office.origin * CFrame.new(side * (width / 2 + 25), height / 2 - 10, z), Color3.fromRGB(34, 44, 78))
				for y = 0, height - 5, 8 do
					block(shell, "CityLights", Vector3.new(12.2, 1.5, 12.2), tower.CFrame * CFrame.new(0, y - height / 2 + 3, 0), gold, Enum.Material.Neon)
				end
			end
		end
		for z = 10, depth - 10, 24 do
			local lamp = block(shell, "WarmLight", Vector3.new(width - 8, 0.2, 1), office.origin * CFrame.new(0, 18.5, z), gold, Enum.Material.Neon)
			local light = Instance.new("PointLight")
			light.Color = Color3.fromRGB(255, 210, 155)
			light.Brightness = 0.7
			light.Range = 32
			light.Parent = lamp
		end
		for index = 1, facility.desks do
			local x = ((index - 1) % columns - (columns - 1) / 2) * 11
			local z = 32 + math.floor((index - 1) / columns) * 10
			local desk = Environment.buildDesk(shell, office.origin * CFrame.new(x, 0, z), "StaffDesk_" .. index)
			desk.Screen.Color = index % 2 == 0 and cyan or purple
		end
		if tier >= 4 then
			for _, x in ipairs({ -width / 2 + 4, width / 2 - 4 }) do
				block(shell, "Planter", Vector3.new(3, 2, 3), office.origin * CFrame.new(x, 1, 18), gold)
				block(shell, "Topiary", Vector3.new(3, 5, 3), office.origin * CFrame.new(x, 4, 18), Color3.fromRGB(57, 198, 124))
			end
		end
		for index = 1, math.min(8, view.summary.securityRating) do
			block(shell, "SecurityCamera", Vector3.new(0.8, 0.6, 1.5), office.origin * CFrame.new(-width / 2 + 2, 14, index * 8), cyan)
		end
		office.desk.PrimaryPart.Material = upgrades >= 4 and Enum.Material.Metal or Enum.Material.Wood
		office.desk.PrimaryPart.Color = upgrades >= 4 and Color3.fromRGB(35, 39, 70) or Color3.fromRGB(150, 98, 64)
		office.desk.Screen.Size = Vector3.new(2.3 + math.min(upgrades, 10) * 0.12, 1.4, 0.1)
		office.columns = columns
	end
	-- Rebuild workers only when the roster changes, not every income tick.
	local roster = { view.facility }
	for _, employee in ipairs(view.staff) do table.insert(roster, employee.id .. ":" .. employee.held) end
	local rosterKey = table.concat(roster, "|")
	if rosterKey ~= office.rosterKey then
		office.rosterKey = rosterKey
		if office.staff then Environment.removeEmployees(office.staff); office.staff:Destroy() end
		local staff = Instance.new("Model")
		staff.Name = "HiredEmployees"
		staff.Parent = office.model
		office.staff = staff
		local index = 0
		for _, employee in ipairs(view.staff) do
			for _ = 1, employee.held do
				index += 1
				local x = ((index - 1) % office.columns - (office.columns - 1) / 2) * 11
				local z = 35 + math.floor((index - 1) / office.columns) * 10
				local npc = Environment.buildEmployee(staff, office.origin * CFrame.new(x, 0, z), employee.name)
				npc:SetAttribute("EmployeeId", employee.id)
				npc:SetAttribute("OwnerUserId", player.UserId)
				npc.Torso.Color = Color3.fromHSV((employee.tier - 1) / 7, 0.7, 0.95)
				for _, p in ipairs(npc:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
			end
		end
	end
	office.staff:SetAttribute("Paused", paused)
	if firstVisit then
		changed({ player.UserId })
		if OfficeManager.sessionHost(player) == player then OfficeManager.teleport(player) end
	end
end

function OfficeManager.start(callback)
	onTerminal = callback
	local lobby = Environment.getRoot()
	local lift = block(lobby, "OfficeLift", Vector3.new(8, 1, 6), CFrame.new(0, 0.5, 44), purple, Enum.Material.Neon)
	-- Keep the control above/in front of arriving avatars, not inside the pad.
	local anchor = block(lift, "ReturnPromptAnchor", Vector3.new(2, 1.5, 0.5), CFrame.new(0, 5, 40), purple, Enum.Material.Neon)
	anchor.CanCollide, anchor.CanTouch, anchor.CanQuery = false, false, false
	sign(lobby, "OfficeLiftSign", CFrame.new(0, 9, 38), "YOUR OFFICE\nUSE THE LIFT", gold)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ReturnToOfficePrompt"
	prompt.ActionText = "Return to My Office"
	prompt.ObjectText = "Office Return Lift"
	prompt.RequiresLineOfSight = false
	prompt.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.Parent = anchor
	prompt.Triggered:Connect(function(player)
		-- This public travel control must remain usable in a crowd. Terminals still
		-- require server raycasts; the lift retains health, distance and rate checks.
		if Access.near(player, { anchor = anchor, distance = 12, requiresLineOfSight = false })
			and Access.throttle(player, "travel", 2) then OfficeManager.teleport(player) end
	end)
	local function joined(player)
		removing[player] = nil
		policy:add(player)
		local function respawned(character)
			task.spawn(function()
				local root = character:WaitForChild("HumanoidRootPart", 15)
				if root and player.Character == character and not removing[player] then
					if not OfficeManager.teleport(player) then OfficeManager.visitLobby(player) end
					changed({ player.UserId })
				end
			end)
		end
		player.CharacterAdded:Connect(respawned)
		if player.Character then respawned(player.Character) end
	end
	Data.DataChanged.Event:Connect(function(player)
		local restored = initializePreference(player)
		if restored then OfficeManager.teleport(player) end
	end)
	Players.PlayerAdded:Connect(joined)
	for _, player in ipairs(Players:GetPlayers()) do joined(player) end
	Players.PlayerRemoving:Connect(OfficeManager.remove)
	local elapsed, expiryElapsed = 0, 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		expiryElapsed += dt
		if elapsed >= 0.1 then
			elapsed = 0
			for _, player in ipairs(Players:GetPlayers()) do OfficeManager.enforce(player) end
		end
		if expiryElapsed >= 1 then expiryElapsed = 0; changed(policy:expire()) end
	end)
end

return OfficeManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX72">
				<Properties>
					<string name="Name">OfficeSessions</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Ephemeral consent policy. No profile tables or DataStores belong here.
local OfficeSessions = {}
local LIMIT, INVITE_SECONDS = 8, 90

function OfficeSessions.new(now)
	now = now or os.clock
	local records, invitations = {}, {}
	local serial = 0
	local self = {}
	local function members(hostId)
		local ids = {}
		for id, record in pairs(records) do
			if record.hostUserId == hostId then table.insert(ids, id) end
		end
		table.sort(ids)
		return ids
	end
	local function clearInvites(id)
		for token, invite in pairs(invitations) do
			if invite.hostUserId == id or invite.targetUserId == id then invitations[token] = nil end
		end
	end
	function self:get(id) return records[id] end
	function self:host(id)
		local record = records[id]
		local host = record and records[record.hostUserId]
		return host and host.player or nil
	end
	function self:remove(id)
		local record = records[id]
		if not record then return {} end
		local affected = members(record.hostUserId)
		if record.hostUserId == id then
			for _, guestId in ipairs(affected) do
				if guestId ~= id then
					local guest = records[guestId]
					guest.hostUserId, guest.mode, guest.needsChoice = guestId, "solo", false
				end
			end
		end
		clearInvites(id)
		records[id] = nil
		local out = {}
		for _, uid in ipairs(affected) do if uid ~= id then table.insert(out, uid) end end
		return out
	end
	function self:add(player)
		if records[player.UserId] and records[player.UserId].player == player then return records[player.UserId] end
		self:remove(player.UserId)
		local record = { player = player, userId = player.UserId, hostUserId = player.UserId, mode = nil, needsChoice = true }
		records[player.UserId] = record
		return record
	end
	function self:choose(id, mode)
		local record = records[id]
		if not record or (mode ~= "solo" and mode ~= "coop") then return false, "Choose Solo or Co-op." end
		if record.hostUserId ~= id then return false, "Leave your host's session first." end
		if mode == "solo" and #members(id) > 1 then return false, "Remove guests before switching to Solo." end
		record.mode, record.needsChoice = mode, false
		return true, mode == "solo" and "Your office is private. You can invite friends later." or "Co-op is invite-only. Invite from Office Management."
	end
	function self:canEnter(id, ownerId)
		local record, owner = records[id], records[ownerId]
		return record ~= nil and owner ~= nil and not record.needsChoice and not owner.needsChoice
			and owner.hostUserId == ownerId and record.hostUserId == ownerId
	end
	function self:invite(hostId, targetId)
		local host, target = records[hostId], records[targetId]
		if not host or host.needsChoice or host.hostUserId ~= hostId then return false, "Only the office host can invite." end
		if not target or targetId == hostId then return false, "Choose another player in this server." end
		if target.hostUserId == hostId then return false, "That player is already a member." end
		if #members(hostId) >= LIMIT then return false, "The party is full (8 players)." end
		-- Reinviting replaces the prior offer, so old accept clicks cannot be replayed.
		for token, invite in pairs(invitations) do
			if invite.hostUserId == hostId and invite.targetUserId == targetId then invitations[token] = nil end
		end
		serial += 1
		local invite = { id = tostring(serial), hostUserId = hostId, targetUserId = targetId,
			hostPlayer = host.player, targetPlayer = target.player, expires = now() + INVITE_SECONDS }
		invitations[invite.id] = invite
		return true, "Invitation sent. Entry unlocks only after acceptance.", invite
	end
	function self:respond(id, token, accept)
		local invite = invitations[token]
		local target = records[id]
		local host = invite and records[invite.hostUserId]
		if type(accept) ~= "boolean" or not invite or invite.targetUserId ~= id or not target
			or target.player ~= invite.targetPlayer or not host or host.player ~= invite.hostPlayer
			or host.hostUserId ~= invite.hostUserId or invite.expires <= now() then
			return false, "This invitation is no longer valid.", {}
		end
		invitations[token] = nil
		if not accept then return true, "Invitation declined.", { id, invite.hostUserId } end
		if target.hostUserId == id and #members(id) > 1 then return false, "Remove your guests before joining another host.", { id } end
		if #members(invite.hostUserId) >= LIMIT then return false, "That party is now full.", { id } end
		local affected = members(target.hostUserId)
		clearInvites(id)
		target.hostUserId, target.mode, target.needsChoice = invite.hostUserId, "coop", false
		host.mode = "coop"
		for _, uid in ipairs(members(invite.hostUserId)) do if not table.find(affected, uid) then table.insert(affected, uid) end end
		return true, "Joined " .. host.player.DisplayName .. "'s office. Calls benefit the host; your save stays separate.", affected
	end
	function self:revoke(hostId, guestId)
		local host, guest = records[hostId], records[guestId]
		if not host or host.hostUserId ~= hostId or hostId == guestId then return false, "Only the host can remove guests.", {} end
		-- Also cancels a pending invitation for this player.
		local pending = false
		for token, invite in pairs(invitations) do
			if invite.hostUserId == hostId and invite.targetUserId == guestId then invitations[token] = nil; pending = true end
		end
		if not guest or guest.hostUserId ~= hostId then return pending, pending and "Invitation cancelled." or "That player is not a guest.", { hostId, guestId } end
		local affected = members(hostId)
		guest.hostUserId, guest.mode, guest.needsChoice = guestId, "solo", false
		return true, "Guest access revoked.", affected
	end
	function self:leave(id)
		local record = records[id]
		if not record or record.hostUserId == id then return false, "You are already in your own office.", {} end
		return self:revoke(record.hostUserId, id)
	end
	function self:expire()
		local affected = {}
		for token, invite in pairs(invitations) do
			if invite.expires <= now() then
				invitations[token] = nil
				table.insert(affected, invite.targetUserId)
			end
		end
		return affected
	end
	function self:view(id)
		local record = records[id]
		if not record then return nil end
		local host = records[record.hostUserId]
		local view = { needsChoice = record.needsChoice, mode = host.mode, hostUserId = record.hostUserId,
			hostName = host.player.DisplayName, isHost = id == record.hostUserId, members = {}, invitations = {},
			maxMembers = LIMIT }
		for _, uid in ipairs(members(record.hostUserId)) do
			table.insert(view.members, { userId = uid, name = records[uid].player.DisplayName })
		end
		for _, invite in pairs(invitations) do
			local inviter = records[invite.hostUserId]
			if invite.targetUserId == id and inviter and invite.expires > now() then
				table.insert(view.invitations, { id = invite.id, hostUserId = invite.hostUserId,
					hostName = inviter.player.DisplayName, expiresIn = math.ceil(invite.expires - now()) })
			end
		end
		table.sort(view.invitations, function(a, b) return tonumber(a.id) < tonumber(b.id) end)
		return view
	end
	return self
end

return OfficeSessions
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX73">
				<Properties>
					<string name="Name">OperationManager</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- OperationManager
-- The tycoon layer's server side: purchases, headcount, passive income,
-- offline earnings, and the once-a-second tick that drives both income and
-- police heat.
--
-- Rank and the earnings leaderboard are deliberately NOT fed by passive income.
-- Ranks come from calls, and method tiers require ranks, so the active game is
-- what unlocks the idle game rather than being replaced by it.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared")
local Operation = require(Shared.Operation)
local Products = require(Shared.Products)
local Ranks = require(Shared.Ranks)
local Util = require(Shared.Util)

local PlayerDataManager = require(script.Parent.PlayerDataManager)
local HeatManager = require(script.Parent.HeatManager)

local OperationManager = {}

OperationManager.Changed = Instance.new("BindableEvent") -- (player, view)
OperationManager.Raided = Instance.new("BindableEvent") -- (player, outcome)
OperationManager.OfflineEarnings = Instance.new("BindableEvent") -- (player, amount, seconds)

local TICK_SECONDS = 1

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------

local function state(player: Player)
	local profile = PlayerDataManager.get(player)
	return profile and profile.operation or nil
end

local function offlineCap(player: Player): number
	if PlayerDataManager.ownsPass(player, "night_shift") then
		return Operation.Offline.PassCapSeconds
	end
	return Operation.Offline.CapSeconds
end

function OperationManager.summary(player: Player)
	local operation = state(player)
	if not operation then
		return nil
	end
	return Operation.summarise(operation, { offlineCapSeconds = offlineCap(player) })
end

-- The multiplier the rest of the game applies to call payouts. A more
-- sophisticated operation makes every call worth more, which is what keeps the
-- call game relevant at the top end.
function OperationManager.callMultiplier(player: Player): number
	local summary = OperationManager.summary(player)
	return summary and summary.incomeMul or 1
end

function OperationManager.notify(player: Player)
	OperationManager.Changed:Fire(player, OperationManager.view(player))
end

--------------------------------------------------------------------------------
-- Purchases
--------------------------------------------------------------------------------

local function charge(player: Player, cost: number): boolean
	return PlayerDataManager.spendCredits(player, cost)
end

function OperationManager.setMethod(player: Player, methodId: string): (boolean, string)
	local operation = state(player)
	local profile = PlayerDataManager.get(player)
	local method = Operation.MethodById[methodId]
	if not operation or not method then
		return false, "Unknown method."
	end
	if operation.method == methodId then
		return false, "Already running that."
	end

	local current = Operation.MethodById[operation.method]
	-- Stepping back down is always free; you are giving up income.
	if method.index < current.index then
		operation.method = methodId
		OperationManager.notify(player)
		return true, "Scaled back to " .. method.name .. "."
	end

	if method.index > current.index + 1 then
		return false, "Unlock the tiers in order."
	end
	if profile.rankIndex < method.requiresRank then
		return false, method.name .. " needs the rank of " .. Ranks.get(method.requiresRank).name .. "."
	end
	if not operation.unlockedMethods[methodId] then
		if not charge(player, method.cost) then
			return false, "Not enough Credits."
		end
		operation.unlockedMethods[methodId] = true
	end
	operation.method = methodId
	OperationManager.notify(player)
	return true, "Now running " .. method.name .. ". Expect attention."
end

function OperationManager.buyFacility(player: Player, facilityId: string): (boolean, string)
	local operation = state(player)
	local facility = Operation.FacilityById[facilityId]
	if not operation or not facility then
		return false, "Unknown facility."
	end
	local current = Operation.FacilityById[operation.facility]
	if facility.index <= current.index then
		return false, "You already have that."
	end
	if facility.index > current.index + 1 then
		return false, "One move at a time."
	end
	if not charge(player, facility.cost) then
		return false, "Not enough Credits."
	end
	operation.facility = facilityId
	OperationManager.notify(player)
	return true, "Moved into " .. facility.name .. "."
end

function OperationManager.buySecurity(player: Player, itemId: string): (boolean, string)
	local operation = state(player)
	local item = Operation.SecurityById[itemId]
	if not operation or not item then
		return false, "Unknown security upgrade."
	end
	if operation.security[itemId] then
		return false, "Already installed."
	end
	if not charge(player, item.cost) then
		return false, "Not enough Credits."
	end
	operation.security[itemId] = true
	OperationManager.notify(player)
	return true, item.name .. " installed."
end

function OperationManager.buyTradecraft(player: Player, itemId: string): (boolean, string)
	local operation = state(player)
	local item = Operation.TradecraftById[itemId]
	if not operation or not item then
		return false, "Unknown upgrade."
	end
	if operation.tradecraft[itemId] then
		return false, "Already trained."
	end
	local method = Operation.MethodById[operation.method]
	if method.index < item.requiresMethod then
		return false, "Needs " .. Operation.Methods[item.requiresMethod].name .. " or better."
	end
	if not charge(player, item.cost) then
		return false, "Not enough Credits."
	end
	operation.tradecraft[itemId] = true
	OperationManager.notify(player)
	return true, item.name .. " sorted."
end

function OperationManager.hire(player: Player, employeeId: string, count: number): (boolean, string)
	local operation = state(player)
	local employee = Operation.EmployeeById[employeeId]
	if not operation or not employee then
		return false, "Nobody by that name."
	end
	count = math.clamp(math.floor(count or 1), 1, 25)

	local summary = OperationManager.summary(player)
	local room = summary.deskCap - summary.headcount
	if room <= 0 then
		return false, "No free desks. Upgrade the office."
	end
	count = math.min(count, room)

	local held = operation.staff[employeeId] or 0
	local total = 0
	for index = 0, count - 1 do
		total += Operation.hireCost(employee, held + index)
	end

	if not charge(player, total) then
		return false, "Not enough Credits."
	end
	operation.staff[employeeId] = held + count
	OperationManager.notify(player)
	return true, string.format("Hired %d x %s for %s Credits.", count, employee.name, Util.formatNumber(total))
end

function OperationManager.fire(player: Player, employeeId: string, count: number): (boolean, string)
	local operation = state(player)
	local employee = Operation.EmployeeById[employeeId]
	if not operation or not employee then
		return false, "Nobody by that name."
	end
	local held = operation.staff[employeeId] or 0
	if held <= 0 then
		return false, "You have none of those."
	end
	count = math.clamp(math.floor(count or 1), 1, held)

	local refund = 0
	for index = 0, count - 1 do
		refund += Operation.severance(employee, held - index)
	end
	local left = held - count
	operation.staff[employeeId] = left > 0 and left or nil
	PlayerDataManager.addCredits(player, refund, false)
	OperationManager.notify(player)
	return true, string.format("Let %d go. %s Credits back in severance.", count, Util.formatNumber(refund))
end

function OperationManager.layLow(player: Player): (boolean, string)
	local operation = state(player)
	if not operation then
		return false, "Still loading."
	end
	local ok, message = HeatManager.layLow(operation)
	if ok then
		OperationManager.notify(player)
	end
	return ok, message
end

-- Robux consumables that act on the operation rather than on a live call.
function OperationManager.useItem(player: Player, productId: string): (boolean, string)
	local product = Products.ProductById[productId]
	if not product or not product.usableInOperation then
		return false, "That cannot be used here."
	end
	local operation = state(player)
	if not operation then
		return false, "Still loading."
	end
	if product.use.clearHeat and (operation.heat or 0) <= 0 then
		return false, "Nobody is looking at you right now."
	end
	if not PlayerDataManager.consumeItem(player, productId) then
		return false, "You have none left."
	end

	local message = product.name .. " used."
	if product.use.clearHeat then
		operation.heat = 0
		operation.shutdownUntil = 0
		message = "The investigation has been dropped. Heat is at zero."
	end
	OperationManager.notify(player)
	return true, message
end

--------------------------------------------------------------------------------
-- Offline earnings
--------------------------------------------------------------------------------

function OperationManager.applyOffline(player: Player)
	local profile = PlayerDataManager.get(player)
	if not profile then
		return 0, 0
	end
	local operation = profile.operation
	local away = math.max(0, math.floor(profile.awaySeconds or 0))
	profile.awaySeconds = 0
	if away < 60 then
		return 0, 0
	end

	local summary = OperationManager.summary(player)
	local counted = math.min(away, summary.offlineCapSeconds)

	-- Heat bleeds off while nobody is there, but never builds.
	if Operation.Offline.DecayWhileAway then
		operation.heat = math.max(0, (operation.heat or 0) - summary.heatDecay * away)
	end
	operation.shutdownUntil = 0
	operation.layLowUntil = 0

	local earned = math.floor(summary.netIncome * counted * Operation.Offline.Efficiency)
	if earned > 0 then
		OperationManager.creditPassive(player, earned)
		OperationManager.OfflineEarnings:Fire(player, earned, counted)
	end
	return earned, counted
end

-- Passive income is credited, tracked, and kept out of lifetime earnings so it
-- cannot buy rank.
function OperationManager.creditPassive(player: Player, amount: number)
	if amount <= 0 then
		return
	end
	local profile = PlayerDataManager.get(player)
	if not profile then
		return
	end
	profile.stats.passiveEarned += amount
	profile.operation.passiveEarned += amount
	-- Silent: the per-second tick must not fire a remote per player per second.
	PlayerDataManager.addCredits(player, amount, false, true)
end

--------------------------------------------------------------------------------
-- Client view
--------------------------------------------------------------------------------

function OperationManager.view(player: Player)
	local profile = PlayerDataManager.get(player)
	local operation = profile and profile.operation
	if not operation then
		return nil
	end
	local summary = OperationManager.summary(player)

	local methods = {}
	for _, method in ipairs(Operation.Methods) do
		local current = Operation.MethodById[operation.method]
		table.insert(methods, {
			id = method.id,
			index = method.index,
			name = method.name,
			blurb = method.blurb,
			cost = method.cost,
			incomeMul = method.incomeMul,
			heatPerSecond = method.heatPerSecond,
			requiresRank = method.requiresRank,
			requiresRankName = Ranks.get(method.requiresRank).name,
			unlocked = operation.unlockedMethods[method.id] == true,
			active = operation.method == method.id,
			available = method.index <= current.index + 1 and profile.rankIndex >= method.requiresRank,
		})
	end

	local staff = {}
	for _, employee in ipairs(Operation.Employees) do
		local held = operation.staff[employee.id] or 0
		table.insert(staff, {
			id = employee.id,
			tier = employee.tier,
			name = employee.name,
			blurb = employee.blurb,
			held = held,
			hireCost = Operation.hireCost(employee, held),
			severance = Operation.severance(employee, held),
			incomePerSecond = employee.incomePerSecond,
			wagePerSecond = employee.wagePerSecond,
			heatPerSecond = employee.heatPerSecond,
			suspicious = employee.suspicious == true,
		})
	end

	local function listOf(source, owned, extra)
		local out = {}
		for _, item in ipairs(source) do
			local entry = {
				id = item.id,
				name = item.name,
				blurb = item.blurb,
				cost = item.cost,
				order = item.order,
				owned = owned[item.id] == true,
			}
			if extra then
				extra(entry, item)
			end
			table.insert(out, entry)
		end
		return out
	end

	local currentFacility = Operation.FacilityById[operation.facility]
	local facilities = {}
	for _, facility in ipairs(Operation.Facilities) do
		table.insert(facilities, {
			id = facility.id,
			index = facility.index,
			name = facility.name,
			blurb = facility.blurb,
			cost = facility.cost,
			desks = facility.desks,
			incomeMul = facility.incomeMul,
			owned = facility.index <= currentFacility.index,
			available = facility.index == currentFacility.index + 1,
		})
	end

	return {
		method = operation.method,
		facility = operation.facility,
		heat = operation.heat,
		heatMax = Operation.Heat.Max,
		layLowRemaining = math.max(0, (operation.layLowUntil or 0) - os.time()),
		shutdownRemaining = math.max(0, (operation.shutdownUntil or 0) - os.time()),
		raidsSurvived = operation.raidsSurvived,
		raidsLost = operation.raidsLost,
		passiveEarned = operation.passiveEarned,
		summary = {
			netIncome = summary.netIncome,
			income = summary.income,
			wages = summary.wages,
			incomeMul = summary.incomeMul,
			headcount = summary.headcount,
			deskCap = summary.deskCap,
			suspiciousCount = summary.suspiciousCount,
			heatGain = summary.heatGain,
			heatDecay = summary.heatDecay,
			heatRate = summary.heatRate,
			notoriety = summary.notoriety,
			securityRating = summary.securityRating,
			escapeChance = summary.escapeChance,
			offlineCapSeconds = summary.offlineCapSeconds,
		},
		methods = methods,
		staff = staff,
		facilities = facilities,
		security = listOf(Operation.Security, operation.security, function(entry, item)
			entry.rating = item.rating
			entry.heatMul = item.heatMul
			entry.decayBonus = item.decayBonus
		end),
		tradecraft = listOf(Operation.Tradecraft, operation.tradecraft, function(entry, item)
			entry.heatMul = item.heatMul
			entry.incomeMul = item.incomeMul
			entry.requiresMethod = item.requiresMethod
			entry.requiresMethodName = Operation.Methods[item.requiresMethod].name
		end),
	}
end

--------------------------------------------------------------------------------
-- Tick
--------------------------------------------------------------------------------

function OperationManager.step(player: Player, dt: number)
	local profile = PlayerDataManager.get(player)
	if not profile then
		return
	end
	local operation = profile.operation
	local summary = OperationManager.summary(player)

	local running = not HeatManager.isLayingLow(operation) and not HeatManager.isShutDown(operation)
	if running and summary.netIncome > 0 then
		OperationManager.creditPassive(player, summary.netIncome * dt)
	end

	local function spendFraction(fraction: number): number
		local amount = math.floor(profile.credits * fraction)
		if amount > 0 then
			PlayerDataManager.spendCredits(player, amount)
		end
		return amount
	end

	local outcome = HeatManager.tick(player, operation, summary, dt, spendFraction)
	if outcome then
		OperationManager.Raided:Fire(player, outcome)
	end
end

function OperationManager.start()
	local function onJoin(player: Player)
		task.spawn(function()
			local deadline = os.clock() + 25
			while not PlayerDataManager.get(player) and os.clock() < deadline do
				task.wait(0.25)
			end
			if PlayerDataManager.get(player) then
				OperationManager.applyOffline(player)
				OperationManager.notify(player)
			end
		end)
	end

	Players.PlayerAdded:Connect(onJoin)
	for _, player in ipairs(Players:GetPlayers()) do
		onJoin(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		HeatManager.reset(player)
	end)

	task.spawn(function()
		while true do
			local dt = task.wait(TICK_SECONDS)
			for _, player in ipairs(Players:GetPlayers()) do
				if PlayerDataManager.get(player) then
					local ok, err = pcall(OperationManager.step, player, dt)
					if not ok then
						warn("[OperationManager] tick failed for " .. player.Name .. ": " .. tostring(err))
					end
				end
			end
		end
	end)

	-- Push a fresh view to clients a few times a minute so the meters move
	-- without spamming a remote every tick.
	task.spawn(function()
		while true do
			task.wait(5)
			for _, player in ipairs(Players:GetPlayers()) do
				if PlayerDataManager.get(player) then
					OperationManager.notify(player)
					-- Catches up the credit total and the player-list stats that
					-- the silent passive ticks deliberately skipped.
					PlayerDataManager.notify(player)
				end
			end
		end
	end)
end

return OperationManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX74">
				<Properties>
					<string name="Name">PlayerDataManager</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- PlayerDataManager
-- Owns every player's saved profile. Nothing else touches DataStoreService.
--
-- Safety rules used here:
--   * every DataStore call is wrapped in pcall with bounded retries
--   * a failed load never overwrites: the profile is flagged `loadFailed` and
--     saving is disabled for that session so we cannot wipe real progress
--   * autosave on a timer, save on leave, and a BindToClose flush

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared")
local Config = require(Shared.Config)
local Ranks = require(Shared.Ranks)
local Upgrades = require(Shared.Upgrades)
local Products = require(Shared.Products)
local Operation = require(Shared.Operation)

local PlayerDataManager = {}

local store: DataStore? = nil
local profiles: { [number]: any } = {}
local lastSave: { [number]: number } = {}

PlayerDataManager.DataChanged = Instance.new("BindableEvent")

local function defaultProfile()
	return {
		version = 2,
		credits = 0,
		rankIndex = 1,
		upgrades = {},
		achievements = {},
		stats = {
			successfulCalls = 0,
			failedCalls = 0,
			totalCalls = 0,
			lifetimeEarnings = 0,
			highestDifficulty = "",
			highestDifficultyOrder = 0,
			failStreak = 0,
			bestStreak = 0,
			successStreak = 0,
			bestSuccessStreak = 0,
			timesOnHold = 0,
			totalCallSeconds = 0,
			bestSingleReward = 0,
			-- Successful calls per difficulty. These drive the global boards and
			-- are deliberately immune to any paid reward multiplier.
			successByDifficulty = {},
			-- Passive income is tracked separately and never counted as
			-- lifetime earnings, so the tycoon layer cannot buy rank.
			passiveEarned = 0,
		},
		operation = Operation.defaultState(),
		settings = {
			difficulty = "Normal",
			-- Intentionally absent for a first-time player. Once chosen, this is
			-- "solo" or "host_coop"; invitations and guests are never persisted.
		},
		premium = {
			passes = {}, -- [passId] = true
			inventory = {}, -- [productId] = count
			boostExpires = 0,
			boostMultiplier = 0,
			alias = "",
			-- Developer Product receipt ids already granted, newest last. Bounded
			-- so a long-lived profile cannot grow without limit.
			receipts = {},
		},
		createdAt = os.time(),
		lastSeen = os.time(),
	}
end

-- Fill in anything missing after a schema change.
local function reconcile(profile)
	-- Nested-but-dynamic tables reconcile explicitly; the generic pass below
	-- only walks one level deep.
	if typeof(profile.stats) == "table" and typeof(profile.stats.successByDifficulty) ~= "table" then
		profile.stats.successByDifficulty = {}
	end
	if typeof(profile.premium) == "table" then
		profile.premium.passes = profile.premium.passes or {}
		profile.premium.inventory = profile.premium.inventory or {}
		profile.premium.receipts = profile.premium.receipts or {}
	end
	if typeof(profile.settings) ~= "table" then profile.settings = {} end
	if profile.settings.officeMode ~= "solo" and profile.settings.officeMode ~= "host_coop" then
		profile.settings.officeMode = nil
	end
	if typeof(profile.operation) ~= "table" then
		profile.operation = Operation.defaultState()
	else
		local defaults = Operation.defaultState()
		for key, value in pairs(defaults) do
			if profile.operation[key] == nil then
				profile.operation[key] = value
			end
		end
		-- A saved method or facility that no longer exists falls back safely.
		if not Operation.MethodById[profile.operation.method] then
			profile.operation.method = Operation.StartingMethod
		end
		if not Operation.FacilityById[profile.operation.facility] then
			profile.operation.facility = Operation.StartingFacility
		end
		profile.operation.unlockedMethods[Operation.StartingMethod] = true
	end
	local base = defaultProfile()
	for key, value in pairs(base) do
		if profile[key] == nil then
			profile[key] = value
		elseif typeof(value) == "table" and typeof(profile[key]) == "table" then
			for subKey, subValue in pairs(value) do
				if profile[key][subKey] == nil then
					profile[key][subKey] = subValue
				end
			end
		end
	end
	profile.version = 2
	return profile
end

local function getStore(): DataStore?
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStore.Key)
	end)
	if ok then
		store = result
		return store
	end
	warn("[PlayerDataManager] DataStore unavailable: " .. tostring(result))
	return nil
end

-- Retry wrapper with exponential backoff.
local function retry(label: string, fn)
	local delayTime = Config.DataStore.RetryBaseDelay
	for attempt = 1, Config.DataStore.MaxRetries do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn(string.format("[PlayerDataManager] %s attempt %d failed: %s", label, attempt, tostring(result)))
		if attempt < Config.DataStore.MaxRetries then
			task.wait(delayTime)
			delayTime *= 2
		end
	end
	return false, nil
end

local function keyFor(player: Player): string
	return "player_" .. tostring(player.UserId)
end

function PlayerDataManager.load(player: Player)
	local profile = defaultProfile()
	local ds = getStore()

	if ds then
		local ok, saved = retry("load", function()
			return ds:GetAsync(keyFor(player))
		end)
		if ok then
			if typeof(saved) == "table" then
				local previousSeen = saved.lastSeen
				profile = reconcile(saved)
				-- Captured before lastSeen is refreshed below, so the tycoon
				-- layer can pay out offline earnings.
				profile.awaySeconds = previousSeen and math.max(0, os.time() - previousSeen) or 0
			end
		else
			-- Could not read. Run in memory only so we never clobber real data.
			profile.loadFailed = true
			warn("[PlayerDataManager] Load failed for " .. player.Name .. "; saving disabled this session.")
		end
	else
		-- No DataStore at all: either API services are off, or the place has
		-- never been published (DataStores need a published place). Running in
		-- memory is fine, but it used to do so silently, which reads exactly
		-- like the game losing your progress.
		profile.saveUnavailable = true
		if not Config.DataStore.StudioFallbackToMemory then
			profile.loadFailed = true
		end
		warn("[PlayerDataManager] No DataStore access -- progress will not save. "
			.. "Publish the place, then turn on Game Settings > Security > "
			.. "Studio Access to API Services.")
	end

	profile.lastSeen = os.time()
	profiles[player.UserId] = profile
	lastSave[player.UserId] = os.clock()
	PlayerDataManager.recalculateRank(player)
	return profile
end

function PlayerDataManager.get(player: Player)
	return profiles[player.UserId]
end

function PlayerDataManager.save(player: Player, isFinal: boolean?): boolean
	local profile = profiles[player.UserId]
	if not profile then
		return false
	end
	if profile.loadFailed then
		return false
	end
	local ds = getStore()
	if not ds then
		return false
	end

	profile.lastSeen = os.time()
	local payload = profile

	local ok = retry(isFinal and "final save" or "save", function()
		ds:UpdateAsync(keyFor(player), function()
			return payload
		end)
		return true
	end)
	if ok then
		lastSave[player.UserId] = os.clock()
	end
	return ok
end

function PlayerDataManager.release(player: Player)
	PlayerDataManager.save(player, true)
	profiles[player.UserId] = nil
	lastSave[player.UserId] = nil
end

--------------------------------------------------------------------------------
-- Mutators. Everything that changes a profile goes through here so the client
-- update fires exactly once per change.
--------------------------------------------------------------------------------

-- `silent` skips the client update. Passive income uses it: it ticks every
-- second, and firing a remote per player per second to move a number the client
-- is already interpolating is pure waste. OperationManager pushes a real
-- update every few seconds instead.
function PlayerDataManager.addCredits(player: Player, amount: number, countAsEarnings: boolean?, silent: boolean?)
	local profile = profiles[player.UserId]
	if not profile then
		return
	end
	profile.credits = math.max(0, profile.credits + amount)
	if countAsEarnings and amount > 0 then
		profile.stats.lifetimeEarnings += amount
		if amount > profile.stats.bestSingleReward then
			profile.stats.bestSingleReward = amount
		end
	end
	PlayerDataManager.recalculateRank(player)
	if not silent then
		PlayerDataManager.notify(player)
	end
end

function PlayerDataManager.spendCredits(player: Player, amount: number): boolean
	local profile = profiles[player.UserId]
	if not profile or profile.credits < amount then
		return false
	end
	profile.credits -= amount
	PlayerDataManager.notify(player)
	return true
end

function PlayerDataManager.grantUpgrade(player: Player, upgradeId: string)
	local profile = profiles[player.UserId]
	if not profile then
		return
	end
	profile.upgrades[upgradeId] = true
	PlayerDataManager.notify(player)
end

function PlayerDataManager.grantAchievement(player: Player, achievementId: string): boolean
	local profile = profiles[player.UserId]
	if not profile or profile.achievements[achievementId] then
		return false
	end
	profile.achievements[achievementId] = true
	PlayerDataManager.notify(player)
	return true
end

function PlayerDataManager.recordCall(player: Player, result)
	local profile = profiles[player.UserId]
	if not profile then
		return
	end
	local stats = profile.stats
	stats.totalCalls += 1
	stats.totalCallSeconds += math.floor(result.duration or 0)

	if result.outcome == "success" then
		stats.successfulCalls += 1
		stats.failStreak = 0
		stats.successStreak += 1
		if stats.successStreak > stats.bestSuccessStreak then
			stats.bestSuccessStreak = stats.successStreak
		end
		if result.difficulty then
			stats.successByDifficulty[result.difficulty] = (stats.successByDifficulty[result.difficulty] or 0) + 1
		end
		if (result.difficultyOrder or 0) > stats.highestDifficultyOrder then
			stats.highestDifficultyOrder = result.difficultyOrder
			stats.highestDifficulty = result.difficulty
		end
	else
		stats.failedCalls += 1
		stats.successStreak = 0
		stats.failStreak += 1
		if stats.failStreak > stats.bestStreak then
			stats.bestStreak = stats.failStreak
		end
	end

	if result.timesOnHold then
		stats.timesOnHold += result.timesOnHold
	end

	PlayerDataManager.recalculateRank(player)
	PlayerDataManager.notify(player)
end

-- Returns the new rank index, and the old one if it changed.
function PlayerDataManager.recalculateRank(player: Player): (number, number?)
	local profile = profiles[player.UserId]
	if not profile then
		return 1, nil
	end
	local newIndex = Ranks.evaluate(profile.stats.lifetimeEarnings, profile.stats.successfulCalls)
	local old = profile.rankIndex
	if newIndex ~= old then
		profile.rankIndex = newIndex
		return newIndex, old
	end
	return newIndex, nil
end

function PlayerDataManager.getBonuses(player: Player)
	local profile = profiles[player.UserId]
	if not profile then
		return Upgrades.aggregate({})
	end
	return Products.applyBonuses(Upgrades.aggregate(profile.upgrades), profile.premium)
end

-- The trimmed profile the client is allowed to see.
function PlayerDataManager.publicView(player: Player)
	local profile = profiles[player.UserId]
	if not profile then
		return nil
	end
	local rank = Ranks.get(profile.rankIndex)
	local nextRank = Ranks.next(profile.rankIndex)
	return {
		credits = profile.credits,
		rankIndex = profile.rankIndex,
		rankName = rank.name,
		rankPerks = rank.perks,
		dialogueLevel = rank.dialogueLevel,
		nextRank = nextRank and {
			name = nextRank.name,
			lifetime = nextRank.lifetime,
			calls = nextRank.calls,
		} or nil,
		upgrades = profile.upgrades,
		achievements = profile.achievements,
		stats = profile.stats,
		settings = profile.settings,
		bonuses = PlayerDataManager.getBonuses(player),
		saveDisabled = profile.loadFailed == true or profile.saveUnavailable == true,
		saveNote = profile.saveUnavailable and "not saving - no API access"
			or (profile.loadFailed and "not saving - load failed" or nil),
		operation = {
			method = profile.operation.method,
			facility = profile.operation.facility,
			heat = profile.operation.heat,
		},
		premium = {
			passes = profile.premium.passes,
			inventory = profile.premium.inventory,
			alias = profile.premium.alias,
			boostRemaining = math.max(0, (profile.premium.boostExpires or 0) - os.time()),
		},
	}
end

function PlayerDataManager.notify(player: Player)
	PlayerDataManager.DataChanged:Fire(player, PlayerDataManager.publicView(player))
end

function PlayerDataManager.setDifficulty(player: Player, key: string)
	local profile = profiles[player.UserId]
	if not profile then
		return
	end
	profile.settings.difficulty = key
	PlayerDataManager.notify(player)
end

function PlayerDataManager.getOfficeMode(player: Player): string?
	local profile = profiles[player.UserId]
	local mode = profile and profile.settings and profile.settings.officeMode
	return (mode == "solo" or mode == "host_coop") and mode or nil
end

function PlayerDataManager.setOfficeMode(player: Player, mode: string): boolean
	if mode ~= "solo" and mode ~= "host_coop" then return false end
	local profile = profiles[player.UserId]
	if not profile then return false end
	profile.settings.officeMode = mode
	PlayerDataManager.notify(player)
	-- Mode changes are rare and affect the next join, so persist promptly in
	-- addition to the normal autosave/final-save lifecycle.
	if not profile.loadFailed and not profile.saveUnavailable then
		task.spawn(PlayerDataManager.save, player, false)
	end
	return true
end

--------------------------------------------------------------------------------
-- Premium state (Robux purchases). MonetisationManager owns the policy; this
-- module only owns the storage.
--------------------------------------------------------------------------------

local MAX_RECEIPTS = 60

function PlayerDataManager.setPassOwned(player: Player, passId: string, owned: boolean)
	local profile = profiles[player.UserId]
	if not profile then
		return
	end
	if profile.premium.passes[passId] == owned or (not owned and profile.premium.passes[passId] == nil) then
		return
	end
	profile.premium.passes[passId] = owned or nil
	PlayerDataManager.notify(player)
end

function PlayerDataManager.ownsPass(player: Player, passId: string): boolean
	local profile = profiles[player.UserId]
	return profile ~= nil and profile.premium.passes[passId] == true
end

-- Returns false if this receipt was already granted, so ProcessReceipt can be
-- replayed by Roblox without double-granting.
function PlayerDataManager.claimReceipt(player: Player, receiptId: string): boolean
	local profile = profiles[player.UserId]
	if not profile then
		return false
	end
	for _, seen in ipairs(profile.premium.receipts) do
		if seen == receiptId then
			return false
		end
	end
	table.insert(profile.premium.receipts, receiptId)
	while #profile.premium.receipts > MAX_RECEIPTS do
		table.remove(profile.premium.receipts, 1)
	end
	return true
end

function PlayerDataManager.addItem(player: Player, productId: string, amount: number)
	local profile = profiles[player.UserId]
	if not profile then
		return
	end
	profile.premium.inventory[productId] = (profile.premium.inventory[productId] or 0) + amount
	PlayerDataManager.notify(player)
end

-- Spends one of an item. Returns false when the player has none.
function PlayerDataManager.consumeItem(player: Player, productId: string): boolean
	local profile = profiles[player.UserId]
	if not profile then
		return false
	end
	local count = profile.premium.inventory[productId] or 0
	if count <= 0 then
		return false
	end
	count -= 1
	profile.premium.inventory[productId] = count > 0 and count or nil
	PlayerDataManager.notify(player)
	return true
end

function PlayerDataManager.addBoost(player: Player, seconds: number, multiplier: number)
	local profile = profiles[player.UserId]
	if not profile then
		return
	end
	local now = os.time()
	local base = math.max(profile.premium.boostExpires or 0, now)
	profile.premium.boostExpires = base + seconds
	profile.premium.boostMultiplier = multiplier
	PlayerDataManager.notify(player)
end

function PlayerDataManager.setAlias(player: Player, alias: string)
	local profile = profiles[player.UserId]
	if not profile then
		return
	end
	profile.premium.alias = alias
	PlayerDataManager.notify(player)
end

function PlayerDataManager.getAlias(player: Player): string?
	local profile = profiles[player.UserId]
	if not profile or profile.premium.alias == "" then
		return nil
	end
	if not profile.premium.passes.alias_licence then
		return nil
	end
	return profile.premium.alias
end

--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------

function PlayerDataManager.start()
	Players.PlayerAdded:Connect(function(player)
		PlayerDataManager.load(player)
		PlayerDataManager.notify(player)
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		if not profiles[player.UserId] then
			task.spawn(function()
				PlayerDataManager.load(player)
				PlayerDataManager.notify(player)
			end)
		end
	end

	Players.PlayerRemoving:Connect(function(player)
		PlayerDataManager.release(player)
	end)

	-- Autosave loop.
	task.spawn(function()
		while true do
			task.wait(Config.DataStore.AutosaveSeconds)
			for _, player in ipairs(Players:GetPlayers()) do
				if profiles[player.UserId] then
					task.spawn(PlayerDataManager.save, player, false)
				end
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() then
			return
		end
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			pending += 1
			task.spawn(function()
				PlayerDataManager.save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 20
		while pending > 0 and os.clock() < deadline do
			task.wait(0.2)
		end
	end)
end

return PlayerDataManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX75">
				<Properties>
					<string name="Name">RandomEventManager</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- RandomEventManager
-- Decides when an interruption fires and hands back an event the player must
-- answer. Events use the same choice shape as normal dialogue.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Difficulty = require(Shared.Difficulty)
local RandomEvents = require(Shared.RandomEvents)

local RandomEventManager = {}

function RandomEventManager.shouldFire(callState): boolean
	if callState.eventCooldown > 0 then
		return false
	end
	local level = Difficulty.get(callState.difficultyKey)
	local chance = Config.Events.BaseChance * level.eventChanceMul * (callState.bonuses.eventResist or 1)
	-- Late in the call, interruptions get more likely.
	chance += math.min(0.1, (callState.elapsed or 0) / 6000)
	return Util.newRandom():NextNumber() < chance
end

function RandomEventManager.pick(npc, callState)
	local random = Util.newRandom()
	local candidates = {}
	for _, event in ipairs(RandomEvents.List) do
		local stageOk = callState.stage >= (event.minStage or 1) and callState.stage <= (event.maxStage or 7)
		local whitelistOk = not event.personalities or Util.contains(event.personalities, npc.personalityId)
		local blacklistOk = not event.excludes or not Util.contains(event.excludes, npc.personalityId)
		local unused = not callState.usedEvents[event.id]
		if stageOk and whitelistOk and blacklistOk and unused then
			local weight = event.weight or 1
			if event.personalities then
				weight *= 4
			end
			table.insert(candidates, { event = event, weight = weight })
		end
	end
	if #candidates == 0 then
		return nil
	end
	local picked = Util.weightedPick(candidates, random)
	return picked and picked.event or nil
end

function RandomEventManager.buildView(event, callState)
	local random = Util.newRandom()
	local choices = {}
	for index, choice in ipairs(event.choices) do
		local locked = (choice.minLevel or 1) > callState.dialogueLevel
		table.insert(choices, {
			index = index,
			text = choice.text,
			locked = locked,
			lockReason = locked and ("Unlocks at dialogue level " .. tostring(choice.minLevel)) or nil,
		})
	end
	-- Same reason as DialogueManager: never let position give the answer away.
	Util.shuffle(choices, random)

	return {
		situationId = event.id,
		isEvent = true,
		eventTitle = event.title,
		prompt = Util.pick(event.prompt, random),
		choices = choices,
	}
end

function RandomEventManager.count(): number
	return RandomEvents.count()
end

return RandomEventManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX76">
				<Properties>
					<string name="Name">RewardManager</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- RewardManager
-- Works out what a finished call is worth and writes it to the profile.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Ranks = require(Shared.Ranks)
local Difficulty = require(Shared.Difficulty)
local Operation = require(Shared.Operation)

local PlayerDataManager = require(script.Parent.PlayerDataManager)

local RewardManager = {}

-- result: { outcome, npc, trust, suspicion, duration, perfect, difficultyKey, bonuses }
function RewardManager.calculate(player: Player, result)
	local random = Util.newRandom()
	local data = PlayerDataManager.get(player)
	local level = Difficulty.get(result.difficultyKey)
	local rank = Ranks.get(data and data.rankIndex or 1)
	local bonuses = result.bonuses or {}
	local breakdown = {}

	if result.outcome ~= "success" then
		local band = Config.Rewards.FailureConsolation
		local amount = random:NextInteger(band.min, band.max)
		table.insert(breakdown, { label = "Attendance (failed call)", amount = amount })
		return amount, breakdown
	end

	local band = Config.Rewards.TierBase[result.npc.tier] or Config.Rewards.TierBase.Normal
	local base = random:NextInteger(band.min, band.max)
	base = math.floor(base * (result.npc.rewardMul or 1))
	table.insert(breakdown, { label = result.npc.tier .. " caller", amount = base })

	local total = base
	local bonusMult = 0

	local b = Config.Rewards.Bonuses
	if result.suspicion <= b.LowSuspicion.threshold then
		bonusMult += b.LowSuspicion.mult
		table.insert(breakdown, { label = b.LowSuspicion.label, amount = math.floor(base * b.LowSuspicion.mult) })
	end
	if result.trust >= b.HighTrust.threshold then
		bonusMult += b.HighTrust.mult
		table.insert(breakdown, { label = b.HighTrust.label, amount = math.floor(base * b.HighTrust.mult) })
	end
	local fastWindow = Config.Call.FastCallSeconds + (bonuses.timeBonus or 0)
	if result.duration <= fastWindow then
		bonusMult += b.FastCall.mult
		table.insert(breakdown, { label = b.FastCall.label, amount = math.floor(base * b.FastCall.mult) })
	end
	if result.perfect then
		bonusMult += b.PerfectRun.mult
		table.insert(breakdown, { label = b.PerfectRun.label, amount = math.floor(base * b.PerfectRun.mult) })
	end
	if result.npc.tier == "Hard" or result.npc.tier == "Expert" or result.npc.tier == "Nightmare" then
		bonusMult += b.HardNPC.mult
		table.insert(breakdown, { label = b.HardNPC.label, amount = math.floor(base * b.HardNPC.mult) })
	end

	-- The streak counts the calls before this one, so a first win pays no bonus.
	local streak = data and data.stats.successStreak or 0
	if streak > 0 then
		local streakMult = math.min(b.Streak.max, streak * b.Streak.perCall)
		bonusMult += streakMult
		table.insert(breakdown, {
			label = string.format("%s x%d", b.Streak.label, streak + 1),
			amount = math.floor(base * streakMult),
		})
	end

	total = base * (1 + bonusMult)

	-- A more sophisticated operation makes every call worth more. This is what
	-- keeps the call game relevant once the tycoon layer is running.
	local operationMul = 1
	if data and data.operation then
		operationMul = Operation.summarise(data.operation).incomeMul
	end

	-- Multipliers from difficulty, rank, upgrades and the operation.
	local multipliers = level.rewardMul * rank.rewardMul * (bonuses.rewardMul or 1) * operationMul
	local beforeMultipliers = total
	total = math.floor(total * multipliers)
	if total ~= math.floor(beforeMultipliers) then
		table.insert(breakdown, {
			label = string.format(
				"Difficulty x%.2f / Rank x%.2f / Desk x%.2f / Operation x%.2f",
				level.rewardMul,
				rank.rewardMul,
				bonuses.rewardMul or 1,
				operationMul
			),
			amount = total - math.floor(beforeMultipliers),
		})
	end

	return total, breakdown
end

-- Applies the payout and the call statistics, returning the amount awarded.
function RewardManager.award(player: Player, result): (number, any)
	local amount, breakdown = RewardManager.calculate(player, result)
	local level = Difficulty.get(result.difficultyKey)

	PlayerDataManager.recordCall(player, {
		outcome = result.outcome,
		duration = result.duration,
		difficulty = result.difficultyKey,
		difficultyOrder = level.order,
		timesOnHold = result.timesOnHold,
	})
	PlayerDataManager.addCredits(player, amount, true)

	return amount, breakdown
end

return RewardManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX77">
				<Properties>
					<string name="Name">TerminalAccess</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Server-owned interaction sessions. ProximityPrompt events are untrusted too.
local TerminalAccess = {}
local sessions = {}
local cooldowns = {}

local permissions = {
	workstation = { StartCall = true, ChooseOption = true, UseItem = true, SetDifficulty = true, setMethod = true },
	hr = { hire = true, fire = true },
	management = { PurchaseUpgrade = true, buyFacility = true, buyTradecraft = true },
	security = { buySecurity = true, layLow = true, useItem = true },
	premium = { PromptPurchase = true },
}

function TerminalAccess.near(player, terminal): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
	local anchor = terminal and terminal.anchor
	if not root or not humanoid or humanoid.Health <= 0 or not anchor or not anchor:IsDescendantOf(workspace) then
		return false
	end
	local position = root.Position
	if not (math.abs(position.X) < math.huge and math.abs(position.Y) < math.huge and math.abs(position.Z) < math.huge) then return false end
	if terminal.canAccess then
		if not terminal.canAccess(player) then return false end
	elseif terminal.owner and terminal.owner ~= player.UserId then return false end
	if terminal.canUse and not terminal.canUse(player) then return false end
	if (root.Position - anchor.Position).Magnitude > (terminal.distance or 10) then return false end
	-- Explicit opt-out for the public return lift only; computers remain occlusion-checked.
	if terminal.requiresLineOfSight == false then return true end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, terminal.model or anchor }
	return workspace:Raycast(root.Position, anchor.Position - root.Position, params) == nil
end

function TerminalAccess.throttle(player, key, seconds): boolean
	local bucket = cooldowns[player] or {}
	cooldowns[player] = bucket
	local now = os.clock()
	if now < (bucket[key] or 0) then return false end
	bucket[key] = now + seconds
	return true
end

function TerminalAccess.open(player, terminal): boolean
	if not permissions[terminal.kind] or not TerminalAccess.near(player, terminal) then return false end
	sessions[player] = { terminal = terminal, character = player.Character, expires = os.clock() + 1800 }
	return true
end

function TerminalAccess.valid(player): boolean
	local session = sessions[player]
	return session ~= nil and session.character == player.Character and session.expires > os.clock()
		and TerminalAccess.near(player, session.terminal)
end

function TerminalAccess.authorize(player, action): boolean
	if not TerminalAccess.valid(player) then return false end
	local session = sessions[player]
	if not permissions[session.terminal.kind][action] then return false end
	if session.terminal.canAct and not session.terminal.canAct(player, action) then return false end
	if not TerminalAccess.throttle(player, "action", 0.2) then return false end
	session.expires = os.clock() + 1800
	return true
end

function TerminalAccess.current(player)
	return sessions[player]
end

function TerminalAccess.close(player)
	sessions[player] = nil
end

function TerminalAccess.remove(player)
	sessions[player] = nil
	cooldowns[player] = nil
end

function TerminalAccess.finiteInteger(value, minimum, maximum): boolean
	return typeof(value) == "number" and value == value and value > -math.huge and value < math.huge
		and value % 1 == 0 and value >= minimum and value <= maximum
end

return TerminalAccess
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX78">
				<Properties>
					<string name="Name">UpgradeManager</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- UpgradeManager
-- Validates and applies desk upgrade purchases.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared")
local Upgrades = require(Shared.Upgrades)

local PlayerDataManager = require(script.Parent.PlayerDataManager)

local UpgradeManager = {}

UpgradeManager.Purchased = Instance.new("BindableEvent")

function UpgradeManager.purchase(player: Player, upgradeId: string): (boolean, string)
	local data = PlayerDataManager.get(player)
	if not data then
		return false, "Profile still loading."
	end
	local def = Upgrades.ById[upgradeId]
	local ok, reason = Upgrades.canPurchase(def, data)
	if not ok then
		return false, reason
	end

	if not PlayerDataManager.spendCredits(player, def.cost) then
		return false, "Not enough Credits."
	end
	PlayerDataManager.grantUpgrade(player, def.id)
	UpgradeManager.Purchased:Fire(player, def)
	return true, def.name .. " installed at your desk."
end

-- Catalog view for the shop UI (cost, ownership and lock state per player).
function UpgradeManager.catalog(player: Player)
	local data = PlayerDataManager.get(player)
	local out = {}
	for _, def in ipairs(Upgrades.List) do
		local owned = data ~= nil and data.upgrades[def.id] == true
		local canBuy, reason = false, "Profile loading."
		if data then
			canBuy, reason = Upgrades.canPurchase(def, data)
		end
		local effects = {}
		for key, value in pairs(def.effects) do
			table.insert(effects, { key = key, value = value })
		end
		table.sort(effects, function(a, b)
			return a.key < b.key
		end)
		table.insert(out, {
			id = def.id,
			name = def.name,
			blurb = def.blurb,
			cost = def.cost,
			order = def.order,
			requiresRank = def.requiresRank or 1,
			requires = def.requires,
			effects = effects,
			owned = owned,
			canBuy = canBuy,
			reason = reason,
		})
	end
	table.sort(out, function(a, b)
		return a.order < b.order
	end)
	return out
end

return UpgradeManager
