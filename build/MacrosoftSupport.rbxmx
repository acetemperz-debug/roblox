			<Item class="ModuleScript" referent="RBX81">
				<Properties>
					<string name="Name">Juice</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Juice
-- Feedback effects: floating numbers, screen flashes, shakes, confetti, a
-- count-up and the server-wide ticker. None of it changes what happens in the
-- game; all of it changes how it feels to play.
--
-- Sounds are wired but silent: drop asset ids into Juice.Sounds and they start
-- playing. Nothing here references an asset id it cannot verify.

local SoundService = game:GetService("SoundService")

local UIKit = require(script.Parent.UIKit)

local Juice = {}
local T = UIKit.Theme

-- Fill these in with your own asset ids ("rbxassetid://123") to add audio.
Juice.Sounds = {
	choice = "",
	good = "",
	bad = "",
	success = "",
	fail = "",
	cash = "",
	rankUp = "",
	alarm = "",
}

local layers = {
	popups = nil,
	flash = nil,
	confetti = nil,
	ticker = nil,
}

local soundCache = {}

function Juice.play(name: string, volume: number?)
	local id = Juice.Sounds[name]
	if not id or id == "" then
		return
	end
	local sound = soundCache[name]
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = "Juice_" .. name
		sound.SoundId = id
		sound.Parent = SoundService
		soundCache[name] = sound
	end
	sound.Volume = volume or 0.5
	sound:Play()
end

function Juice.init(gui: ScreenGui)
	layers.popups = UIKit.new("Frame", {
		Name = "JuicePopups",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 50,
		Active = false,
		Parent = gui,
	})

	layers.confetti = UIKit.new("Frame", {
		Name = "JuiceConfetti",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 49,
		Active = false,
		Parent = gui,
	})

	layers.flash = UIKit.new("Frame", {
		Name = "JuiceFlash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 48,
		Active = false,
		Parent = gui,
	})
	return layers
end

--------------------------------------------------------------------------------
-- Floating numbers
--------------------------------------------------------------------------------

-- anchor: a GuiObject to appear next to, or nil for the centre of the screen.
function Juice.popup(text: string, colour: Color3, anchor: GuiObject?, options)
	if not layers.popups then
		return
	end
	options = options or {}

	local x, y
	if anchor and anchor.AbsoluteSize.X > 0 then
		x = anchor.AbsolutePosition.X + anchor.AbsoluteSize.X / 2
		y = anchor.AbsolutePosition.Y
	else
		x = layers.popups.AbsoluteSize.X / 2
		y = layers.popups.AbsoluteSize.Y * 0.4
	end
	x += (options.offsetX or 0)
	y += (options.offsetY or 0)

	local label = UIKit.label({
		Text = text,
		Font = Enum.Font.FredokaOne,
		TextSize = options.size or 28,
		TextColor3 = colour,
		TextStrokeTransparency = 0.2,
		TextStrokeColor3 = Color3.fromRGB(12, 12, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(260, 40),
		ZIndex = 51,
		Parent = layers.popups,
	})

	-- Small random drift so a burst of popups does not stack into one blob.
	local drift = math.random(-26, 26)
	local rise = options.rise or 70
	UIKit.tween(label, {
		Position = UDim2.fromOffset(x + drift, y - rise),
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}, options.duration or 0.9, Enum.EasingStyle.Quad)

	-- A quick punch on the way in.
	label.TextSize = (options.size or 28) * 1.6
	UIKit.tween(label, { TextSize = options.size or 28 }, 0.18, Enum.EasingStyle.Back)

	task.delay((options.duration or 0.9) + 0.1, function()
		label:Destroy()
	end)
	return label
end

--------------------------------------------------------------------------------
-- Screen effects
--------------------------------------------------------------------------------

function Juice.flash(colour: Color3, strength: number?, duration: number?)
	if not layers.flash then
		return
	end
	layers.flash.BackgroundColor3 = colour
	layers.flash.BackgroundTransparency = 1 - (strength or 0.35)
	UIKit.tween(layers.flash, { BackgroundTransparency = 1 }, duration or 0.45)
end

-- Shakes a GuiObject around wherever it currently sits.
function Juice.shake(object: GuiObject, intensity: number?, duration: number?)
	if not object then
		return
	end
	local home = object:GetAttribute("JuiceHome")
	if not home then
		object:SetAttribute("JuiceHome", true)
	end
	local base = object.Position
	local power = intensity or 8
	local finish = os.clock() + (duration or 0.3)

	task.spawn(function()
		while os.clock() < finish do
			object.Position = base + UDim2.fromOffset(math.random(-power, power), math.random(-power, power))
			task.wait(0.03)
		end
		object.Position = base
	end)
end

function Juice.pulse(object: GuiObject, amount: number?)
	if not object then
		return
	end
	local base = object.Size
	local grow = amount or 0.06
	local target = UDim2.new(
		base.X.Scale * (1 + grow),
		base.X.Offset * (1 + grow),
		base.Y.Scale * (1 + grow),
		base.Y.Offset * (1 + grow)
	)
	UIKit.tween(object, { Size = target }, 0.09, Enum.EasingStyle.Quad)
	task.delay(0.1, function()
		UIKit.tween(object, { Size = base }, 0.14, Enum.EasingStyle.Back)
	end)
end

function Juice.confetti(count: number?)
	if not layers.confetti then
		return
	end
	local colours = {
		Color3.fromRGB(255, 92, 132),
		Color3.fromRGB(96, 220, 255),
		Color3.fromRGB(255, 214, 92),
		Color3.fromRGB(140, 255, 160),
		Color3.fromRGB(196, 140, 255),
	}
	local width = math.max(1, layers.confetti.AbsoluteSize.X)

	for _ = 1, (count or 40) do
		local piece = UIKit.new("Frame", {
			Size = UDim2.fromOffset(math.random(6, 14), math.random(8, 18)),
			Position = UDim2.fromOffset(math.random(0, width), math.random(-120, -20)),
			BackgroundColor3 = colours[math.random(1, #colours)],
			BorderSizePixel = 0,
			Rotation = math.random(0, 360),
			ZIndex = 49,
			Parent = layers.confetti,
		})
		UIKit.corner(3).Parent = piece

		local fall = math.random(12, 22) / 10
		UIKit.tween(piece, {
			Position = piece.Position + UDim2.fromOffset(math.random(-160, 160), layers.confetti.AbsoluteSize.Y + 200),
			Rotation = piece.Rotation + math.random(-540, 540),
			BackgroundTransparency = 1,
		}, fall, Enum.EasingStyle.Linear)

		task.delay(fall + 0.1, function()
			piece:Destroy()
		end)
	end
end

--------------------------------------------------------------------------------
-- Count-up, for reward numbers
--------------------------------------------------------------------------------

local countTokens = {}

function Juice.countUp(label: TextLabel, from: number, to: number, format, duration: number?)
	countTokens[label] = (countTokens[label] or 0) + 1
	local token = countTokens[label]
	local time = duration or 0.8

	task.spawn(function()
		local start = os.clock()
		while true do
			if countTokens[label] ~= token or not label.Parent then
				return
			end
			local alpha = math.min(1, (os.clock() - start) / time)
			-- Ease out, so it races up then settles.
			local eased = 1 - (1 - alpha) ^ 3
			label.Text = format(math.floor(from + (to - from) * eased))
			if alpha >= 1 then
				return
			end
			task.wait(0.03)
		end
	end)
end

--------------------------------------------------------------------------------
-- Ticker: one line at a time, showing what everyone else is up to.
--------------------------------------------------------------------------------

local tickerQueue = {}
local tickerBusy = false

function Juice.attachTicker(frame: Frame, label: TextLabel)
	layers.ticker = { frame = frame, label = label }
end

local function runTicker()
	if tickerBusy or not layers.ticker then
		return
	end
	local entry = table.remove(tickerQueue, 1)
	if not entry then
		return
	end
	tickerBusy = true

	local frame = layers.ticker.frame
	local label = layers.ticker.label
	label.Text = entry.text
	label.TextColor3 = entry.colour or T.Text

	frame.Visible = true
	frame.BackgroundTransparency = 1
	label.TextTransparency = 1
	UIKit.tween(frame, { BackgroundTransparency = 0.15 }, 0.2)
	UIKit.tween(label, { TextTransparency = 0 }, 0.2)

	task.delay(entry.hold or 3.4, function()
		UIKit.tween(frame, { BackgroundTransparency = 1 }, 0.3)
		UIKit.tween(label, { TextTransparency = 1 }, 0.3)
		task.delay(0.35, function()
			frame.Visible = #tickerQueue > 0
			tickerBusy = false
			runTicker()
		end)
	end)
end

function Juice.ticker(text: string, colour: Color3?, hold: number?)
	table.insert(tickerQueue, { text = text, colour = colour, hold = hold })
	-- Never let a burst of events build an unbounded backlog.
	while #tickerQueue > 6 do
		table.remove(tickerQueue, 1)
	end
	runTicker()
end

--------------------------------------------------------------------------------

-- Mood faces for the caller portrait. Reaction category -> face.
Juice.Faces = {
	greet = "🙂",
	believe = "😊",
	question = "🤨",
	nervous = "😰",
	angry = "😡",
	laugh = "😂",
	accuse = "🤬",
	pretend = "😏",
	waste = "🥱",
	hangup = "📵",
}

function Juice.face(reaction: string?): string
	return Juice.Faces[reaction or "greet"] or "🙂"
end

return Juice
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX82">
				<Properties>
					<string name="Name">MacrosoftClient</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- MacrosoftClient (LocalScript)
-- Wires the generated interface to the server. Lives in StarterPlayerScripts.


local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared")
local MarketplaceService = game:GetService("MarketplaceService")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(Shared.Net)

local UIKit = require(script.Parent.UIKit)
local Interface = require(script.Parent.Interface)
local Juice = require(script.Parent.Juice)

local T = UIKit.Theme
local LIVE_PRICE_TTL = 300
local FAILED_PRICE_TTL = 30
local livePriceCache = {}

local ui = Interface.build()
require(script.Parent.OfficeSessionUI).init(ui)
Juice.init(ui.gui)
Juice.attachTicker(ui.ticker.frame, ui.ticker.label)

local state = {
	data = nil,
	catalog = nil,
	difficulty = "Normal",
	inCall = false,
	elapsed = 0,
	typing = nil,
	lastView = nil,
	store = nil,
	operation = nil,
	terminal = nil,
	terminalGuest = false,
	officeData = nil,
}

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------

-- Forward declarations. enterCall needs the mid-call consumable buttons, and
-- applyData needs to re-pull the store while its panel is open; both are
-- defined further down.
local renderItemRow
local refreshStore
local renderOperation

local function toast(title: string, body: string, kind: string?)
	local colour = T.Accent
	if kind == "success" then
		colour = T.Success
	elseif kind == "warn" then
		colour = T.Danger
	elseif kind == "gold" then
		colour = T.Gold
	end

	local card = UIKit.panel({
		Size = UDim2.new(1, 0, 0, 62),
		BackgroundColor3 = T.Panel,
		Parent = ui.toasts,
	})
	UIKit.stroke(colour, 2).Parent = card
	UIKit.padding(10).Parent = card

	UIKit.label({
		Text = title,
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		TextColor3 = colour,
		Size = UDim2.new(1, 0, 0, 18),
		Parent = card,
	})
	UIKit.label({
		Text = body,
		TextSize = 13,
		TextColor3 = T.SubText,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.new(0, 0, 0, 20),
		Size = UDim2.new(1, 0, 0, 24),
		Parent = card,
	})

	card.BackgroundTransparency = 1
	UIKit.tween(card, { BackgroundTransparency = 0 }, 0.2)
	task.delay(4.5, function()
		if card.Parent then
			UIKit.tween(card, { BackgroundTransparency = 1 }, 0.3)
			task.wait(0.32)
			card:Destroy()
		end
	end)
end

-- Reveals text one character at a time; cancelled by the next call.
local function typewrite(label: TextLabel, text: string)
	state.typing = (state.typing or 0) + 1
	local token = state.typing
	label.Text = ""
	task.spawn(function()
		for index = 1, #text do
			if state.typing ~= token then
				return
			end
			label.Text = string.sub(text, 1, index)
			task.wait(Config.UI.TypewriterSpeed)
		end
	end)
end

local function skipTypewriter(label: TextLabel, text: string)
	state.typing = (state.typing or 0) + 1
	label.Text = text
end

--------------------------------------------------------------------------------
-- Home / difficulty
--------------------------------------------------------------------------------

local difficultyButtons = {}

local function refreshDifficultyButtons()
	for key, entry in pairs(difficultyButtons) do
		local account = state.officeData or state.data
		local unlocked = account ~= nil and account.rankIndex >= entry.info.minRankIndex
		local selected = state.difficulty == key
		entry.button.Active = unlocked
		entry.button.AutoButtonColor = false
		entry.button.BackgroundColor3 = selected and T.Accent or (unlocked and T.PanelLight or T.Background)
		entry.button.TextColor3 = unlocked and T.Text or T.SubText
		entry.sub.Text = unlocked and string.format("x%.2f pay", entry.info.rewardMul) or ("Locked - " .. entry.info.minRankName)
	end
	local info = difficultyButtons[state.difficulty]
	ui.home.blurb.Text = info and info.info.blurb or ""
end

local function buildDifficultyButtons()
	if not state.catalog then
		return
	end
	for _, child in ipairs(ui.home.difficultyRow:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	table.clear(difficultyButtons)

	for _, info in ipairs(state.catalog.difficulties) do
		local button = UIKit.button({
			Text = "",
			Size = UDim2.new(0, 132, 1, 0),
			LayoutOrder = info.order,
			Parent = ui.home.difficultyRow,
		})
		UIKit.label({
			Text = info.label,
			Font = Enum.Font.GothamBold,
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 0, 0, 10),
			Size = UDim2.new(1, 0, 0, 20),
			Parent = button,
		})
		local sub = UIKit.label({
			Text = "",
			TextSize = 12,
			TextColor3 = T.SubText,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 0, 0, 32),
			Size = UDim2.new(1, 0, 0, 18),
			Parent = button,
		})

		difficultyButtons[info.key] = { button = button, sub = sub, info = info }

		button.MouseButton1Click:Connect(function()
			if not button.Active then
				toast("Locked", info.label .. " unlocks at " .. info.minRankName .. ".", "warn")
				return
			end
			state.difficulty = info.key
			Net.event("SetDifficulty"):FireServer(info.key)
			refreshDifficultyButtons()
		end)
	end
	refreshDifficultyButtons()
end

--------------------------------------------------------------------------------
-- Call rendering
--------------------------------------------------------------------------------

local function renderChoices(view)
	for index, button in ipairs(ui.call.choiceButtons) do
		local choice = view.choices and view.choices[index]
		if choice then
			button.Visible = true
			button.Text = string.char(64 + index) .. ".  " .. choice.text
			button.Active = not choice.locked
			button.BackgroundColor3 = choice.locked and T.Background or T.PanelLight
			button.TextColor3 = choice.locked and T.SubText or T.Text
			button:SetAttribute("ChoiceIndex", choice.index)
			button:SetAttribute("Locked", choice.locked == true)
			button:SetAttribute("LockReason", choice.lockReason or "")
		else
			button.Visible = false
		end
	end
end

local function renderCall(view, animate: boolean)
	state.lastView = view

	ui.call.initials.Text = view.npc.initials
	ui.call.portrait.BackgroundColor3 = view.npc.portraitColour or T.Accent
	ui.call.name.Text = view.npc.fullName
	ui.call.sub.Text = string.format("%d - %s - %s", view.npc.age, view.npc.personalityName, view.npc.moodLabel)
	ui.call.backstory.Text = view.npc.backstory

	ui.call.stageLabel.Text = string.format("Stage %d of %d - %s", view.stage, view.stageCount, view.stageLabel)
	UIKit.tween(ui.call.stageFill, {
		Size = UDim2.new(math.clamp((view.stage - 1 + view.stageProgress) / view.stageCount, 0, 1), 0, 1, 0),
	}, 0.3)

	UIKit.setMeter(ui.call.meters.trust, view.meters.trust)
	UIKit.setMeter(ui.call.meters.suspicion, view.meters.suspicion)
	UIKit.setMeter(ui.call.meters.patience, view.meters.patience)

	if view.isEvent then
		ui.call.eventBanner.Visible = true
		ui.call.eventText.Text = "INTERRUPTION: " .. (view.eventTitle or "")
	else
		ui.call.eventBanner.Visible = false
	end

	local line = view.line or ""
	if animate then
		typewrite(ui.call.npcLine, line)
	else
		skipTypewriter(ui.call.npcLine, line)
	end

	ui.call.prompt.Text = view.prompt or ""

	ui.call.face.Text = Juice.face(view.reaction)

	if view.feedback then
		local parts = {}
		if view.feedback.trust then
			table.insert(parts, string.format("Trust %+.0f", view.feedback.trust))
		end
		if view.feedback.suspicion then
			table.insert(parts, string.format("Suspicion %+.0f", view.feedback.suspicion))
		end
		ui.call.feedback.Text = table.concat(parts, "   ")
		ui.call.feedback.TextColor3 = (view.feedback.suspicion or 0) > 0 and T.Suspicion or T.Trust

		-- Floating numbers next to the meter they belong to.
		if animate then
			local trust = view.feedback.trust or 0
			local suspicion = view.feedback.suspicion or 0
			if math.abs(trust) >= 1 then
				Juice.popup(
					string.format("%+.0f TRUST", trust),
					trust > 0 and T.Trust or T.Suspicion,
					ui.call.meters.trust.track,
					{ offsetX = 150, size = 24 }
				)
			end
			if math.abs(suspicion) >= 1 then
				Juice.popup(
					string.format("%+.0f SUS", suspicion),
					suspicion > 0 and T.Suspicion or T.Trust,
					ui.call.meters.suspicion.track,
					{ offsetX = 150, size = 24, offsetY = 10 }
				)
			end
			if suspicion >= 15 then
				Juice.shake(ui.call.frame, 10, 0.25)
				Juice.flash(T.Suspicion, 0.2, 0.35)
				Juice.play("bad")
			elseif trust >= 12 then
				Juice.play("good")
			end
		end
	else
		ui.call.feedback.Text = ""
	end

	-- Even with the meters hidden, the caller losing their temper should land.
	if animate and (view.reaction == "angry" or view.reaction == "accuse") then
		Juice.shake(ui.call.portrait, 6, 0.3)
	end

	renderChoices(view)
end

local function enterCall(view)
	state.inCall = true
	state.elapsed = 0
	ui.home.frame.Visible = false
	ui.call.frame.Visible = true
	ui.result.frame.Visible = false
	ui.operation.frame.Visible = false
	ui.terminal.frame.Visible = false
	renderCall(view, true)
	renderItemRow()
end

local function exitCall()
	state.inCall = false
	ui.call.frame.Visible = false
	ui.home.frame.Visible = state.terminal == "workstation"
	ui.terminal.frame.Visible = state.terminal ~= nil
end

--------------------------------------------------------------------------------
-- Result screen
--------------------------------------------------------------------------------

local function renderResult(payload)
	for _, child in ipairs(ui.result.breakdown:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	for _, child in ipairs(ui.result.achievements:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	local success = payload.outcome == "success"
	ui.result.outcome.Text = payload.title
	ui.result.outcome.TextColor3 = success and T.Success or T.Danger
	ui.result.line.Text = "\"" .. (payload.closingLine or "") .. "\""
	ui.result.detail.Text = string.format(
		"%s was a %s.\nReached stage %d (%s) in %s.  Trust %d  Suspicion %d.%s",
		payload.npc.fullName,
		payload.revealedPersonality or "caller",
		payload.stage,
		payload.stageLabel,
		Util.formatTime(payload.duration),
		payload.trust,
		payload.suspicion,
		payload.perfect and "\nNo choice raised suspicion - perfect run." or ""
	)
	Juice.countUp(ui.result.reward, 0, payload.reward, function(value)
		return string.format("+%s Credits", Util.formatNumber(value))
	end, 0.9)

	if success then
		Juice.confetti(55)
		Juice.flash(T.Success, 0.22, 0.5)
		Juice.play("success")
		Juice.play("cash")
	else
		Juice.flash(T.Danger, 0.25, 0.5)
		Juice.shake(ui.result.frame, 8, 0.3)
		Juice.play("fail")
	end

	for index, entry in ipairs(payload.breakdown or {}) do
		UIKit.label({
			Text = string.format("%s: +%s", entry.label, Util.formatNumber(entry.amount)),
			TextSize = 14,
			TextColor3 = T.SubText,
			Size = UDim2.new(1, 0, 0, 20),
			LayoutOrder = index,
			Parent = ui.result.breakdown,
		})
	end

	for index, achievement in ipairs(payload.achievements or {}) do
		local card = UIKit.panel({
			Size = UDim2.new(1, 0, 0, 46),
			BackgroundColor3 = T.PanelLight,
			LayoutOrder = index,
			Parent = ui.result.achievements,
		})
		UIKit.stroke(T.Gold, 2).Parent = card
		UIKit.padding(8).Parent = card
		UIKit.label({
			Text = "ACHIEVEMENT: " .. achievement.name,
			Font = Enum.Font.GothamBold,
			TextSize = 14,
			TextColor3 = T.Gold,
			Size = UDim2.new(1, 0, 0, 16),
			Parent = card,
		})
		UIKit.label({
			Text = achievement.blurb .. "  (+" .. Util.formatNumber(achievement.reward) .. ")",
			TextSize = 12,
			TextColor3 = T.SubText,
			TextWrapped = true,
			Position = UDim2.new(0, 0, 0, 18),
			Size = UDim2.new(1, 0, 0, 20),
			Parent = card,
		})
	end

	ui.result.frame.Visible = true
end

--------------------------------------------------------------------------------
-- Shop and career panels
--------------------------------------------------------------------------------

local EFFECT_LABELS = {
	startTrust = "Starting Trust",
	startSuspicion = "Starting Suspicion",
	suspicionResist = "Suspicion Gain",
	rewardMul = "Call Rewards",
	patienceBonus = "NPC Patience",
	easyChance = "Easier Caller Chance",
	timeBonus = "Fast-Call Window",
	eventResist = "Interruption Chance",
}

local function describeEffect(effect): string
	local name = EFFECT_LABELS[effect.key] or effect.key
	if effect.key == "suspicionResist" or effect.key == "eventResist" then
		return string.format("%s -%d%%", name, math.floor((1 - effect.value) * 100 + 0.5))
	elseif effect.key == "rewardMul" or effect.key == "easyChance" then
		return string.format("%s +%d%%", name, math.floor(effect.value * 100 + 0.5))
	end
	return string.format("%s +%d", name, effect.value)
end

local function renderShop()
	for _, child in ipairs(ui.shop.body:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	if not state.catalog then
		return
	end
	ui.shop.credits.Text = Util.formatNumber(state.data and state.data.credits or 0) .. " Credits"

	for index, upgrade in ipairs(state.catalog.upgrades) do
		local card = UIKit.panel({
			Size = UDim2.new(1, -8, 0, 92),
			BackgroundColor3 = T.PanelLight,
			LayoutOrder = index,
			Parent = ui.shop.body,
		})
		UIKit.padding(12).Parent = card
		UIKit.stroke(upgrade.owned and T.Success or T.Panel, 2).Parent = card

		UIKit.label({
			Text = upgrade.name,
			Font = Enum.Font.GothamBold,
			TextSize = 16,
			Size = UDim2.new(1, -140, 0, 20),
			Parent = card,
		})
		UIKit.label({
			Text = upgrade.blurb,
			TextSize = 13,
			TextColor3 = T.SubText,
			TextWrapped = true,
			Position = UDim2.new(0, 0, 0, 22),
			Size = UDim2.new(1, -140, 0, 30),
			Parent = card,
		})

		local effects = {}
		for _, effect in ipairs(upgrade.effects) do
			table.insert(effects, describeEffect(effect))
		end
		UIKit.label({
			Text = table.concat(effects, "   |   "),
			TextSize = 12,
			TextColor3 = T.Accent,
			TextWrapped = true,
			Position = UDim2.new(0, 0, 0, 54),
			Size = UDim2.new(1, -140, 0, 18),
			Parent = card,
		})

		local buy = UIKit.button({
			Text = upgrade.owned and "Owned" or (Util.formatNumber(upgrade.cost) .. " Cr"),
			Font = Enum.Font.GothamBold,
			TextSize = 15,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.new(0, 120, 0, 40),
			BackgroundColor3 = upgrade.owned and T.Success or (upgrade.canBuy and T.Accent or T.Background),
			TextColor3 = (upgrade.owned or upgrade.canBuy) and T.Text or T.SubText,
			Parent = card,
		})
		buy.Active = upgrade.canBuy

		if not upgrade.owned then
			UIKit.label({
				Text = upgrade.canBuy and "" or upgrade.reason,
				TextSize = 11,
				TextColor3 = T.Danger,
				TextXAlignment = Enum.TextXAlignment.Right,
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, 0, 1, 4),
				Size = UDim2.new(0, 180, 0, 14),
				Parent = card,
			})
		end

		buy.MouseButton1Click:Connect(function()
			if upgrade.owned then
				return
			end
			if not upgrade.canBuy then
				toast("Cannot Buy", upgrade.reason, "warn")
				return
			end
			Net.event("PurchaseUpgrade"):FireServer(upgrade.id)
		end)
	end
end

local function renderStore()
	for _, child in ipairs(ui.store.body:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	if not state.store then
		return
	end

	local order = 0
	local function nextOrder()
		order += 1
		return order
	end

	local function heading(text: string, subtitle: string)
		UIKit.label({
			Text = text,
			Font = Enum.Font.GothamBold,
			TextSize = 17,
			TextColor3 = T.Gold,
			Size = UDim2.new(1, 0, 0, 24),
			LayoutOrder = nextOrder(),
			Parent = ui.store.body,
		})
		UIKit.label({
			Text = subtitle,
			TextSize = 12,
			TextColor3 = T.SubText,
			TextWrapped = true,
			Size = UDim2.new(1, 0, 0, 18),
			LayoutOrder = nextOrder(),
			Parent = ui.store.body,
		})
	end

	local function card(item, kind: string)
		local frame = UIKit.panel({
			Size = UDim2.new(1, -8, 0, 86),
			BackgroundColor3 = T.PanelLight,
			LayoutOrder = nextOrder(),
			Parent = ui.store.body,
		})
		UIKit.padding(12).Parent = frame
		local owned = kind == "pass" and item.owned == true
		UIKit.stroke(owned and T.Success or T.Panel, 2).Parent = frame

		UIKit.label({
			Text = item.name,
			Font = Enum.Font.GothamBold,
			TextSize = 16,
			Size = UDim2.new(1, -150, 0, 20),
			Parent = frame,
		})
		UIKit.label({
			Text = item.blurb,
			TextSize = 13,
			TextColor3 = T.SubText,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.new(0, 0, 0, 22),
			Size = UDim2.new(1, -150, 0, 40),
			Parent = frame,
		})

		local label
		if not item.configured then
			label = "Unavailable"
		elseif owned then
			label = "Owned"
		elseif kind == "product" and item.owned > 0 then
			label = string.format("Buy (%d held)", item.owned)
		else
			label = "Buy"
		end

		local buy = UIKit.button({
			Text = label,
			Font = Enum.Font.GothamBold,
			TextSize = 15,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.new(0, 130, 0, 40),
			BackgroundColor3 = owned and T.Success or (item.configured and T.Gold or T.Background),
			TextColor3 = item.configured and Color3.fromRGB(30, 26, 12) or T.SubText,
			Parent = frame,
		})
		buy.Active = item.configured and not owned

		if item.robux then
			UIKit.label({
				Text = (item.priceIsLive and "" or "suggested ") .. item.robux .. " R$",
				TextSize = 11,
				TextColor3 = T.SubText,
				TextXAlignment = Enum.TextXAlignment.Right,
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, 0, 1, 2),
				Size = UDim2.new(0, 140, 0, 14),
				Parent = frame,
			})
		end

		buy.MouseButton1Click:Connect(function()
			if not item.configured then
				toast("Not Set Up", item.name .. " has no asset id yet. See docs/SETUP.md.", "warn")
				return
			end
			if owned then
				return
			end
			Net.event("PromptPurchase"):FireServer(kind, item.id)
		end)
	end

	local configured = 0
	for _, pass in ipairs(state.store.passes) do
		configured += pass.configured and 1 or 0
	end
	for _, product in ipairs(state.store.products) do
		configured += product.configured and 1 or 0
	end
	if configured == 0 then
		local banner = UIKit.panel({
			Size = UDim2.new(1, -8, 0, 66),
			BackgroundColor3 = Color3.fromRGB(62, 48, 20),
			LayoutOrder = nextOrder(),
			Parent = ui.store.body,
		})
		UIKit.padding(10).Parent = banner
		UIKit.stroke(T.Gold, 2).Parent = banner
		UIKit.label({
			Text = "⚠ Nothing here is set up yet",
			Font = Enum.Font.GothamBold,
			TextSize = 15,
			TextColor3 = T.Gold,
			Size = UDim2.new(1, 0, 0, 18),
			Parent = banner,
		})
		UIKit.label({
			Text = "Create each item on the Roblox Creator Dashboard, then paste its id into Products.luau (step 8 of docs/SETUP.md). Expected on a fresh install -- the rest of the game works without it.",
			TextSize = 12,
			TextColor3 = T.SubText,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.new(0, 0, 0, 20),
			Size = UDim2.new(1, 0, 0, 34),
			Parent = banner,
		})
	end

	heading("Passes", "Bought once, kept forever.")
	for _, pass in ipairs(state.store.passes) do
		card(pass, "pass")
	end

	heading("Consumables", "Bought as often as you like. Used from the call screen.")
	for _, product in ipairs(state.store.products) do
		card(product, "product")
	end
end

function renderItemRow()
	for _, child in ipairs(ui.call.itemRow:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	if not state.store or not state.data then
		return
	end
	local inventory = state.data.premium and state.data.premium.inventory or {}

	for index, product in ipairs(state.store.products) do
		local held = inventory[product.id] or 0
		if product.usableInCall and held > 0 then
			local button = UIKit.button({
				Text = string.format("%s (%d)", product.useLabel or product.name, held),
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.new(0, 132, 1, 0),
				LayoutOrder = index,
				BackgroundColor3 = T.Gold,
				TextColor3 = Color3.fromRGB(32, 26, 10),
				Parent = ui.call.itemRow,
			})
			button.MouseButton1Click:Connect(function()
				Net.event("UseItem"):FireServer(product.id)
			end)
		end
	end
end

-- Escalating labels, because a bare number is not a reason to keep going.
local STREAK_LABELS = {
	{ at = 12, text = "CERTIFIED MENACE" },
	{ at = 8, text = "UNHINGED" },
	{ at = 5, text = "ON FIRE" },
	{ at = 3, text = "COOKING" },
	{ at = 2, text = "WARM" },
}

local function streakLabel(streak: number): string
	for _, entry in ipairs(STREAK_LABELS) do
		if streak >= entry.at then
			return entry.text
		end
	end
	return "STREAK"
end

local function formatRate(value: number): string
	if value >= 100 then
		return Util.formatNumber(math.floor(value))
	end
	return string.format("%.1f", value)
end

local function renderOperationHud()
	local hud = ui.operation.hud
	local view = state.operation
	if not view then
		return
	end

	local method
	for _, entry in ipairs(view.methods) do
		if entry.active then
			method = entry
		end
	end
	hud.method.Text = method and method.name or "Cold Calling"

	local shutdown = view.shutdownRemaining or 0
	local layLow = view.layLowRemaining or 0
	if shutdown > 0 then
		hud.income.Text = "SHUT DOWN " .. Util.formatTime(shutdown)
		hud.income.TextColor3 = T.Danger
	elseif layLow > 0 then
		hud.income.Text = "LYING LOW " .. Util.formatTime(layLow)
		hud.income.TextColor3 = T.Patience
	else
		hud.income.Text = "+" .. formatRate(view.summary.netIncome) .. " /sec"
		hud.income.TextColor3 = T.Success
	end

	hud.staff.Text = string.format("%d / %d desks", view.summary.headcount, view.summary.deskCap)

	UIKit.setMeter(hud.heat, {
		mode = "full",
		label = string.format("%d / %d", math.floor(view.heat), view.heatMax),
		ratio = view.heat / view.heatMax,
	})

	local rate = view.summary.heatRate
	if layLow > 0 then
		rate = -(view.summary.heatDecay * 8)
	end
	if rate > 0 then
		local seconds = (view.heatMax - view.heat) / rate
		hud.heatRate.Text = string.format("+%.2f/s - raid in %s", rate, Util.formatTime(seconds))
		hud.heatRate.TextColor3 = T.Suspicion
	else
		hud.heatRate.Text = string.format("%.2f/s - cooling off", rate)
		hud.heatRate.TextColor3 = T.Success
	end

	hud.layLow.Active = layLow <= 0 and shutdown <= 0
	hud.layLow.BackgroundColor3 = hud.layLow.Active and T.PanelLight or T.Background
end

function renderOperation()
	renderOperationHud()

	for _, child in ipairs(ui.operation.body:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local view = state.operation
	if not view then
		return
	end

	local order = 0
	local function nextOrder()
		order += 1
		return order
	end

	ui.operation.summary.Text = string.format(
		"+%s/sec net  -  %d staff  -  security %d  -  escape chance %d%%  -  offline cap %dh",
		formatRate(view.summary.netIncome),
		view.summary.headcount,
		view.summary.securityRating,
		math.floor(view.summary.escapeChance * 100),
		math.floor(view.summary.offlineCapSeconds / 3600)
	)

	local function heading(text: string, subtitle: string?)
		UIKit.label({
			Text = text,
			Font = Enum.Font.GothamBold,
			TextSize = 17,
			TextColor3 = T.Accent,
			Size = UDim2.new(1, 0, 0, 24),
			LayoutOrder = nextOrder(),
			Parent = ui.operation.body,
		})
		if subtitle then
			UIKit.label({
				Text = subtitle,
				TextSize = 12,
				TextColor3 = T.SubText,
				TextWrapped = true,
				Size = UDim2.new(1, 0, 0, 18),
				LayoutOrder = nextOrder(),
				Parent = ui.operation.body,
			})
		end
	end

	-- One row shape reused by every section.
	local function row(opts)
		local card = UIKit.panel({
			Size = UDim2.new(1, -8, 0, opts.height or 74),
			BackgroundColor3 = T.PanelLight,
			LayoutOrder = nextOrder(),
			Parent = ui.operation.body,
		})
		UIKit.padding(12).Parent = card
		UIKit.stroke(opts.strokeColour or T.Panel, 2).Parent = card

		UIKit.label({
			Text = opts.title,
			Font = Enum.Font.GothamBold,
			TextSize = 16,
			TextColor3 = opts.titleColour or T.Text,
			Size = UDim2.new(1, -230, 0, 20),
			Parent = card,
		})
		UIKit.label({
			Text = opts.blurb or "",
			TextSize = 12,
			TextColor3 = T.SubText,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.new(0, 0, 0, 21),
			Size = UDim2.new(1, -230, 0, 30),
			Parent = card,
		})
		if opts.stats then
			UIKit.label({
				Text = opts.stats,
				TextSize = 12,
				TextColor3 = T.Accent,
				TextWrapped = true,
				Position = UDim2.new(0, 0, 0, 52),
				Size = UDim2.new(1, -230, 0, 16),
				Parent = card,
			})
		end
		return card
	end

	local function actionButton(card, opts)
		local button = UIKit.button({
			Text = opts.text,
			Font = Enum.Font.GothamBold,
			TextSize = 14,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, opts.offsetX or 0, 0.5, 0),
			Size = UDim2.new(0, opts.width or 150, 0, 38),
			BackgroundColor3 = opts.colour or T.Accent,
			TextColor3 = opts.textColour or T.Text,
			Parent = card,
		})
		button.Active = opts.enabled ~= false
		if not button.Active then
			button.BackgroundColor3 = T.Background
			button.TextColor3 = T.SubText
		end
		button.MouseButton1Click:Connect(function()
			if not button.Active then
				if opts.disabledReason then
					toast("Not Yet", opts.disabledReason, "warn")
				end
				return
			end
			opts.onClick()
		end)
		return button
	end

	local function act(action: string, a: string?, b: number?)
		Net.event("OperationAction"):FireServer(action, a, b)
	end

	----------------------------------------------------------------------------
	if state.terminal == "workstation" then
	heading("Method", "How the operation makes its money. Every step up pays more and draws more attention.")
	for _, method in ipairs(view.methods) do
		local card = row({
			title = string.format("%d. %s", method.index, method.name),
			titleColour = method.active and T.Success or T.Text,
			strokeColour = method.active and T.Success or T.Panel,
			blurb = method.blurb,
			stats = string.format("income x%.1f  -  heat %.2f/s  -  needs %s", method.incomeMul, method.heatPerSecond, method.requiresRankName),
		})
		if method.active then
			actionButton(card, { text = "RUNNING", colour = T.Success, enabled = false })
		elseif method.unlocked then
			actionButton(card, { text = "SWITCH TO", onClick = function()
				act("setMethod", method.id)
			end })
		else
			actionButton(card, {
				text = Util.formatNumber(method.cost) .. " Cr",
				colour = T.Gold,
				textColour = Color3.fromRGB(30, 26, 12),
				enabled = method.available,
				disabledReason = "Unlock the tier below it first, and reach " .. method.requiresRankName .. ".",
				onClick = function()
					act("setMethod", method.id)
				end,
			})
		end
	end

	----------------------------------------------------------------------------
	end
	if state.terminal == "hr" then
	heading("Staff", "Passive income, minus wages. The cheap ones draw more attention and are the first out of the window in a raid.")
	for _, employee in ipairs(view.staff) do
		local card = row({
			title = string.format("%s  x%d", employee.name, employee.held),
			blurb = employee.blurb,
			stats = string.format(
				"%s+%.0f/s each, wage %.0f/s, heat %.3f/s",
				employee.suspicious and "SUSPICIOUS - " or "",
				employee.incomePerSecond,
				employee.wagePerSecond,
				employee.heatPerSecond
			),
			height = 80,
		})
		actionButton(card, {
			text = "HIRE  " .. Util.formatNumber(employee.hireCost),
			width = 150,
			onClick = function()
				act("hire", employee.id, 1)
			end,
		})
		actionButton(card, {
			text = "FIRE",
			width = 64,
			offsetX = -156,
			colour = T.Danger,
			enabled = employee.held > 0,
			onClick = function()
				act("fire", employee.id, 1)
			end,
		})
	end

	----------------------------------------------------------------------------
	end
	if state.terminal == "management" then
	heading("Premises", "More desks, and a multiplier on everything the floor earns.")
	for _, facility in ipairs(view.facilities) do
		local card = row({
			title = string.format("%d. %s", facility.index, facility.name),
			titleColour = facility.id == view.facility and T.Success or T.Text,
			strokeColour = facility.id == view.facility and T.Success or T.Panel,
			blurb = facility.blurb,
			stats = string.format("%d desks  -  income x%.2f", facility.desks, facility.incomeMul),
		})
		if facility.id == view.facility then
			actionButton(card, { text = "CURRENT", colour = T.Success, enabled = false })
		elseif facility.owned then
			actionButton(card, { text = "OUTGROWN", enabled = false })
		else
			actionButton(card, {
				text = Util.formatNumber(facility.cost) .. " Cr",
				colour = T.Gold,
				textColour = Color3.fromRGB(30, 26, 12),
				enabled = facility.available,
				disabledReason = "Move in one step at a time.",
				onClick = function()
					act("buyFacility", facility.id)
				end,
			})
		end
	end

	----------------------------------------------------------------------------
	end
	if state.terminal == "security" then
	heading("Police Response", "Pause the floor to cool suspicion before a raid.")
	local riskCard = row({ title = "LAY LOW", blurb = "Halt income for three minutes and cool heat eight times faster." })
	actionButton(riskCard, { text = "LAY LOW", enabled = view.layLowRemaining <= 0 and view.shutdownRemaining <= 0,
		onClick = function() act("layLow") end })
	heading("Security", "Slows heat, speeds cooling, and decides how a raid goes.")
	for _, item in ipairs(view.security) do
		local card = row({
			title = item.name,
			blurb = item.blurb,
			stats = string.format("heat x%.2f  -  cooling +%.2f/s  -  escape +%d", item.heatMul, item.decayBonus, item.rating),
			strokeColour = item.owned and T.Success or T.Panel,
		})
		actionButton(card, {
			text = item.owned and "INSTALLED" or (Util.formatNumber(item.cost) .. " Cr"),
			colour = item.owned and T.Success or T.Gold,
			textColour = item.owned and T.Text or Color3.fromRGB(30, 26, 12),
			enabled = not item.owned,
			onClick = function()
				act("buySecurity", item.id)
			end,
		})
	end

	----------------------------------------------------------------------------
	end
	if state.terminal == "management" then
	heading("Tradecraft", "Makes whatever you are already doing look less obviously dodgy.")
	for _, item in ipairs(view.tradecraft) do
		local card = row({
			title = item.name,
			blurb = item.blurb,
			stats = string.format("heat x%.2f  -  income +%d%%  -  needs %s", item.heatMul, math.floor(item.incomeMul * 100), item.requiresMethodName),
			strokeColour = item.owned and T.Success or T.Panel,
		})
		actionButton(card, {
			text = item.owned and "TRAINED" or (Util.formatNumber(item.cost) .. " Cr"),
			colour = item.owned and T.Success or T.Gold,
			textColour = item.owned and T.Text or Color3.fromRGB(30, 26, 12),
			enabled = not item.owned,
			onClick = function()
				act("buyTradecraft", item.id)
			end,
		})
	end

	----------------------------------------------------------------------------
	end
	local inventory = state.data and state.data.premium and state.data.premium.inventory or {}
	local hasOperationItems = false
	if state.store then
		for _, product in ipairs(state.store.products) do
			if product.usableInOperation and (inventory[product.id] or 0) > 0 then
				hasOperationItems = true
			end
		end
	end
	if hasOperationItems and state.terminal == "security" then
		heading("In Your Drawer", "Bought items you can use on the operation right now.")
		for _, product in ipairs(state.store.products) do
			local held = inventory[product.id] or 0
			if product.usableInOperation and held > 0 then
				local card = row({
					title = string.format("%s  x%d", product.name, held),
					blurb = product.blurb,
				})
				actionButton(card, {
					text = "USE",
					colour = T.Gold,
					textColour = Color3.fromRGB(30, 26, 12),
					onClick = function()
						act("useItem", product.id)
					end,
				})
			end
		end
	end
end

local function renderCareer()
	for _, child in ipairs(ui.career.body:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	if not state.data or not state.catalog then
		return
	end
	local order = 0
	local function nextOrder()
		order += 1
		return order
	end

	local stats = state.data.stats
	local statLines = {
		{ "Rank", state.data.rankName },
		{ "Credits", Util.formatNumber(state.data.credits) },
		{ "Lifetime earnings", Util.formatNumber(stats.lifetimeEarnings) },
		{ "Successful calls", tostring(stats.successfulCalls) },
		{ "Failed calls", tostring(stats.failedCalls) },
		{ "Best single payout", Util.formatNumber(stats.bestSingleReward) },
		{ "Highest difficulty cleared", stats.highestDifficulty ~= "" and stats.highestDifficulty or "None yet" },
		{ "Time on calls", Util.formatTime(stats.totalCallSeconds) },
		{ "Times put on hold", tostring(stats.timesOnHold) },
	}

	UIKit.label({
		Text = "STATISTICS",
		Font = Enum.Font.GothamBold,
		TextSize = 17,
		TextColor3 = T.Accent,
		Size = UDim2.new(1, 0, 0, 24),
		LayoutOrder = nextOrder(),
		Parent = ui.career.body,
	})
	for _, entry in ipairs(statLines) do
		local row = UIKit.new("Frame", {
			Size = UDim2.new(1, -8, 0, 20),
			BackgroundTransparency = 1,
			LayoutOrder = nextOrder(),
			Parent = ui.career.body,
		})
		UIKit.label({ Text = entry[1], TextSize = 14, TextColor3 = T.SubText, Size = UDim2.new(0.6, 0, 1, 0), Parent = row })
		UIKit.label({
			Text = entry[2],
			TextSize = 14,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Right,
			Position = UDim2.new(0.6, 0, 0, 0),
			Size = UDim2.new(0.4, 0, 1, 0),
			Parent = row,
		})
	end

	if state.data.nextRank then
		UIKit.label({
			Text = string.format(
				"Next rank: %s (needs %s lifetime earnings and %d successful calls)",
				state.data.nextRank.name,
				Util.formatNumber(state.data.nextRank.lifetime),
				state.data.nextRank.calls
			),
			TextSize = 13,
			TextColor3 = T.Gold,
			TextWrapped = true,
			Size = UDim2.new(1, -8, 0, 34),
			LayoutOrder = nextOrder(),
			Parent = ui.career.body,
		})
	end

	-- Alias Licence editor, shown to everyone so the pass is discoverable.
	local ownsAlias = state.data.premium and state.data.premium.passes and state.data.premium.passes.alias_licence == true
	UIKit.label({
		Text = "TECHNICIAN NAME",
		Font = Enum.Font.GothamBold,
		TextSize = 17,
		TextColor3 = T.Accent,
		Size = UDim2.new(1, 0, 0, 26),
		LayoutOrder = nextOrder(),
		Parent = ui.career.body,
	})

	local aliasRow = UIKit.new("Frame", {
		Size = UDim2.new(1, -8, 0, 36),
		BackgroundTransparency = 1,
		LayoutOrder = nextOrder(),
		Parent = ui.career.body,
	})

	local aliasBox = UIKit.new("TextBox", {
		Size = UDim2.new(1, -140, 1, 0),
		BackgroundColor3 = T.PanelLight,
		BorderSizePixel = 0,
		Font = Enum.Font.Gotham,
		TextSize = 15,
		TextColor3 = ownsAlias and T.Text or T.SubText,
		PlaceholderText = ownsAlias and "Two to sixteen letters" or "Requires the Alias Licence pass",
		Text = (state.data.premium and state.data.premium.alias) or "",
		ClearTextOnFocus = false,
		TextEditable = ownsAlias,
		Parent = aliasRow,
	})
	UIKit.corner(8).Parent = aliasBox
	UIKit.padding(8).Parent = aliasBox

	local aliasSave = UIKit.button({
		Text = ownsAlias and "Save" or "Locked",
		Font = Enum.Font.GothamBold,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 130, 1, 0),
		BackgroundColor3 = ownsAlias and T.Accent or T.Background,
		TextColor3 = ownsAlias and T.Text or T.SubText,
		Parent = aliasRow,
	})
	aliasSave.Active = ownsAlias
	aliasSave.MouseButton1Click:Connect(function()
		if not ownsAlias then
			toast("Locked", "The Alias Licence pass is in the Store.", "warn")
			return
		end
		Net.event("SetAlias"):FireServer(aliasBox.Text)
	end)

	UIKit.label({
		Text = "RANKS",
		Font = Enum.Font.GothamBold,
		TextSize = 17,
		TextColor3 = T.Accent,
		Size = UDim2.new(1, 0, 0, 26),
		LayoutOrder = nextOrder(),
		Parent = ui.career.body,
	})
	for _, rank in ipairs(state.catalog.ranks) do
		local reached = state.data.rankIndex >= rank.index
		UIKit.label({
			Text = string.format("%s%s  -  %s Cr / %d calls  -  %s",
				reached and "[x] " or "[ ] ",
				rank.name,
				Util.formatNumber(rank.lifetime),
				rank.calls,
				table.concat(rank.perks, ", ")
			),
			TextSize = 13,
			TextColor3 = reached and T.Text or T.SubText,
			TextWrapped = true,
			Size = UDim2.new(1, -8, 0, 32),
			LayoutOrder = nextOrder(),
			Parent = ui.career.body,
		})
	end

	UIKit.label({
		Text = "ACHIEVEMENTS",
		Font = Enum.Font.GothamBold,
		TextSize = 17,
		TextColor3 = T.Accent,
		Size = UDim2.new(1, 0, 0, 26),
		LayoutOrder = nextOrder(),
		Parent = ui.career.body,
	})
	for _, achievement in ipairs(state.catalog.achievements) do
		local unlocked = state.data.achievements[achievement.id] == true
		UIKit.label({
			Text = string.format("%s%s  -  %s  (+%s)",
				unlocked and "[x] " or "[ ] ",
				achievement.name,
				achievement.blurb,
				Util.formatNumber(achievement.reward)
			),
			TextSize = 13,
			TextColor3 = unlocked and T.Gold or T.SubText,
			TextWrapped = true,
			Size = UDim2.new(1, -8, 0, 32),
			LayoutOrder = nextOrder(),
			Parent = ui.career.body,
		})
	end

	local content = state.catalog.content
	UIKit.label({
		Text = string.format(
			"Content loaded: %d personalities, %d dialogue situations, %d random events, %d upgrades. Version %s.",
			content.personalities, content.situations, content.events, content.upgrades, state.catalog.version
		),
		TextSize = 12,
		TextColor3 = T.SubText,
		TextWrapped = true,
		Size = UDim2.new(1, -8, 0, 30),
		LayoutOrder = nextOrder(),
		Parent = ui.career.body,
	})
end

--------------------------------------------------------------------------------
-- Data plumbing
--------------------------------------------------------------------------------

local function applyData(data)
	if not data then
		return
	end
	state.data = data
	if not state.officeData or state.officeData.hostUserId == game:GetService("Players").LocalPlayer.UserId then
		state.difficulty = data.settings.difficulty or state.difficulty
	end
	ui.topBar.credits.Text = Util.formatNumber(data.credits) .. " Credits"
	ui.topBar.rank.Text = data.rankName .. (data.saveDisabled and ("   ⚠ " .. (data.saveNote or "not saving")) or "")
	ui.topBar.rank.TextColor3 = data.saveDisabled and T.Danger or T.SubText

	local streak = data.stats and data.stats.successStreak or 0
	ui.topBar.streakPill.Visible = streak >= 2
	if streak >= 2 then
		ui.topBar.streakLabel.Text = string.format("🔥 %s x%d", streakLabel(streak), streak)
	end

	local boostRemaining = data.premium and data.premium.boostRemaining or 0
	ui.topBar.boost.Visible = boostRemaining > 0
	if boostRemaining > 0 then
		ui.topBar.boost.Text = "Double Shift active - " .. Util.formatTime(boostRemaining)
	end

	refreshDifficultyButtons()
	renderItemRow()
	if ui.store.frame.Visible then
		task.spawn(function()
			refreshStore()
			renderStore()
		end)
	end
	if ui.shop.frame.Visible then
		task.spawn(function()
			state.catalog = Net.func("GetCatalog"):InvokeServer()
			renderShop()
		end)
	end
	if ui.career.frame.Visible then
		renderCareer()
	end
	if state.officeData and state.officeData.hostUserId ~= game:GetService("Players").LocalPlayer.UserId then
		ui.topBar.credits.Text = Util.formatNumber(state.officeData.credits) .. " Office Cr"
		ui.topBar.rank.Text = "Host: " .. state.officeData.hostName .. " | " .. state.officeData.rankName
		ui.topBar.boost.Visible = false
	end
end

Net.event("OfficeDataUpdated").OnClientEvent:Connect(function(view)
	if not view then return end
	state.officeData = view
	ui.topBar.credits.Text = Util.formatNumber(view.credits) .. " Office Cr"
	ui.topBar.rank.Text = (view.hostUserId ~= game:GetService("Players").LocalPlayer.UserId and ("Host: " .. view.hostName .. " | ") or "")
		.. view.rankName .. (view.saveDisabled and " | Saving unavailable" or "")
	refreshDifficultyButtons()
end)

local function refreshCatalog()
	local ok, catalog = pcall(function()
		return Net.func("GetCatalog"):InvokeServer()
	end)
	if ok and catalog then
		state.catalog = catalog
		buildDifficultyButtons()
	end
end

local function refreshOperation()
	local ok, view = pcall(function()
		return Net.func("GetOperation"):InvokeServer()
	end)
	if ok and view then
		state.operation = view
		renderOperation()
	end
	return ok
end

function refreshStore()
	local ok, store = pcall(function()
		return Net.func("GetStore"):InvokeServer()
	end)
	if ok and store then
		state.store = store
		renderItemRow()

		-- Resolve prices on the client so Managed Pricing can use this player's
		-- economic location. Run the requests together so Roblox can batch them;
		-- the server/suggested values remain visible if any lookup fails.
		task.spawn(function()
			local remaining = 0
			local function fetchPrice(item, infoType)
				if not item.configured or not item.assetId then
					return
				end
				local cacheKey = tostring(item.assetId)
				local cached = livePriceCache[cacheKey]
				if cached and cached.expiresAt > os.clock() then
					if cached.robux ~= nil then
						item.robux = cached.robux
						item.priceIsLive = true
					end
					return
				end
				remaining += 1
				task.spawn(function()
					local priceOk, info = pcall(function()
						return MarketplaceService:GetProductInfoAsync(item.assetId, infoType)
					end)
					local price = priceOk and type(info) == "table" and tonumber(info.PriceInRobux) or nil
					if price and price >= 0 then
						item.robux = math.floor(price)
						item.priceIsLive = true
						livePriceCache[cacheKey] = { robux = item.robux, expiresAt = os.clock() + LIVE_PRICE_TTL }
					else
						livePriceCache[cacheKey] = { expiresAt = os.clock() + FAILED_PRICE_TTL }
					end
					remaining -= 1
				end)
			end

			for _, pass in ipairs(store.passes) do
				fetchPrice(pass, Enum.InfoType.GamePass)
			end
			for _, product in ipairs(store.products) do
				fetchPrice(product, Enum.InfoType.Product)
			end
			while remaining > 0 do
				task.wait()
			end
			if state.store == store and ui.store.frame.Visible then
				renderStore()
			end
		end)
	end
	return ok
end

local terminalRevision = 0
local function hideTerminalPanels()
	ui.home.frame.Visible = false
	ui.operation.frame.Visible = false
	ui.shop.frame.Visible = false
	ui.store.frame.Visible = false
end

local function leaveTerminal()
	terminalRevision += 1
	state.terminal = nil
	hideTerminalPanels()
	ui.terminal.frame.Visible = false
	Net.event("CloseTerminal"):FireServer()
end

local function showTerminalPage(secondary)
	terminalRevision += 1
	local revision = terminalRevision
	local kind = state.terminal
	if not kind or state.inCall then return end
	hideTerminalPanels()
	if state.terminalGuest and kind ~= "workstation" then return end
	if kind == "workstation" and not secondary then
		ui.home.frame.Visible = true
		return
	end
	task.spawn(function()
		if kind == "premium" then
			refreshStore()
			if revision ~= terminalRevision then return end
			renderStore()
			ui.store.frame.Visible = true
		elseif kind == "management" and secondary then
			refreshCatalog()
			if revision ~= terminalRevision then return end
			renderShop()
			ui.shop.frame.Visible = true
		else
			refreshOperation()
			if revision ~= terminalRevision then return end
			renderOperation()
			ui.operation.frame.Visible = true
		end
	end)
end

Net.event("TerminalOpened").OnClientEvent:Connect(function(payload)
	terminalRevision += 1
	state.terminal = payload.kind
	state.terminalGuest = payload.isGuest == true
	ui.terminal.frame.Visible = true
	ui.terminal.title.Text = string.upper(payload.kind) .. " COMPUTER"
	ui.terminal.primary.Visible = payload.kind == "workstation" or payload.kind == "management"
	ui.terminal.secondary.Visible = ui.terminal.primary.Visible
	if state.terminalGuest then ui.terminal.primary.Visible = false; ui.terminal.secondary.Visible = false end
	ui.terminal.primary.Text = payload.kind == "workstation" and "Calls" or "Premises"
	ui.terminal.secondary.Text = payload.kind == "workstation" and "Campaigns" or "Desk Upgrades"
	showTerminalPage(false)
end)

Net.event("TerminalClosed").OnClientEvent:Connect(function()
	terminalRevision += 1
	state.terminal = nil
	hideTerminalPanels()
	ui.terminal.frame.Visible = false
end)

Net.event("LeaderboardRank").OnClientEvent:Connect(function(payload)
	local centre = workspace:FindFirstChild("CallCentre")
	local boards = centre and centre:FindFirstChild("Leaderboards")
	local board = boards and boards:FindFirstChild(payload.board)
	local surface = board and board:FindFirstChild("Board")
	local own = surface and surface:FindFirstChild("YourRank")
	if own then own.Text = payload.text end -- local change: every visitor sees their own row
end)

ui.terminal.primary.Activated:Connect(function() showTerminalPage(false) end)
ui.terminal.secondary.Activated:Connect(function() showTerminalPage(true) end)
ui.terminal.close.Activated:Connect(leaveTerminal)

--------------------------------------------------------------------------------
-- Events
--------------------------------------------------------------------------------

Net.event("DataUpdated").OnClientEvent:Connect(applyData)

Net.event("OperationUpdated").OnClientEvent:Connect(function(view)
	-- Show what the floor earned since the last push, so idle income is visible
	-- rather than a number quietly ticking up.
	local previous = state.operation
	if previous and view.summary.netIncome > 0 and (view.shutdownRemaining or 0) <= 0 and (view.layLowRemaining or 0) <= 0 then
		local earned = math.floor(math.max(0, (view.passiveEarned or 0) - (previous.passiveEarned or 0)))
		if earned > 0 then
			Juice.popup("+" .. Util.formatNumber(earned), T.Gold, ui.operation.hud.panel, {
				offsetX = 40,
				offsetY = -10,
				size = 20,
				rise = 40,
				duration = 0.8,
			})
		end
	end

	state.operation = view
	if ui.operation.frame.Visible then
		renderOperation()
	else
		renderOperationHud()
	end
end)

Net.event("HeatWarning").OnClientEvent:Connect(function(warning)
	toast(warning.title, warning.body, "warn")
	Juice.flash(T.Suspicion, 0.18, 0.6)
	Juice.play("alarm")
end)

Net.event("RaidAlert").OnClientEvent:Connect(function(outcome)
	toast(outcome.title, outcome.body, outcome.escaped and "success" or "warn")
	if outcome.escaped then
		Juice.confetti(30)
		Juice.flash(T.Success, 0.25, 0.6)
	else
		Juice.flash(T.Danger, 0.45, 0.9)
		Juice.shake(ui.operation.hud.panel, 12, 0.8)
		Juice.popup("RAIDED", T.Danger, nil, { size = 54, rise = 40, duration = 1.4 })
	end
end)

Net.event("Broadcast").OnClientEvent:Connect(function(payload)
	local colour = T.Text
	if payload.kind == "success" then
		colour = T.Success
	elseif payload.kind == "warn" then
		colour = T.Danger
	elseif payload.kind == "gold" then
		colour = T.Gold
	end
	Juice.ticker(payload.text, colour)
end)

Net.event("OfflineEarnings").OnClientEvent:Connect(function(payload)
	toast(
		"While You Were Out",
		string.format(
			"The floor kept working for %s and made %s Credits.%s",
			Util.formatTime(payload.seconds),
			Util.formatNumber(payload.amount),
			payload.capped and " (offline cap reached)" or ""
		),
		"gold"
	)
end)

Net.event("CallStarted").OnClientEvent:Connect(function(view)
	enterCall(view)
end)

Net.event("CallUpdated").OnClientEvent:Connect(function(view)
	if not state.inCall then
		enterCall(view)
		return
	end
	renderCall(view, true)
end)

Net.event("CallEnded").OnClientEvent:Connect(function(payload)
	exitCall()
	renderResult(payload)
	if payload.accountOwnerUserId and payload.accountOwnerUserId ~= game:GetService("Players").LocalPlayer.UserId then
		toast("Host Office Progress", "This call's reward and progression went to " .. payload.accountOwnerName .. ".", "success")
	end
	task.spawn(function()
		refreshCatalog()
		refreshStore()
	end)
end)

Net.event("Notify").OnClientEvent:Connect(function(payload)
	toast(payload.title, payload.body, payload.kind)
end)

Net.event("CallCancelled").OnClientEvent:Connect(function()
	exitCall()
	ui.result.frame.Visible = false
	state.typing = (state.typing or 0) + 1
end)

Net.event("AchievementUnlocked").OnClientEvent:Connect(function(achievement)
	toast("Achievement: " .. achievement.name, achievement.blurb, "gold")
end)

Net.event("RankChanged").OnClientEvent:Connect(function(payload)
	toast("Promoted to " .. payload.to, "Unlocked: " .. table.concat(payload.perks or {}, ", "), "gold")
	Juice.confetti(70)
	Juice.flash(T.Gold, 0.3, 0.8)
	Juice.popup("PROMOTED", T.Gold, nil, { size = 52, rise = 50, duration = 1.5 })
	Juice.play("rankUp")
end)

--------------------------------------------------------------------------------
-- Buttons
--------------------------------------------------------------------------------

ui.home.startButton.MouseButton1Click:Connect(function()
	Net.event("StartCall"):FireServer(state.difficulty)
end)

ui.call.hangUp.MouseButton1Click:Connect(function()
	Net.event("HangUp"):FireServer()
end)

for _, button in ipairs(ui.call.choiceButtons) do
	button.MouseButton1Click:Connect(function()
		if button:GetAttribute("Locked") then
			toast("Locked", button:GetAttribute("LockReason"), "warn")
			return
		end
		local index = button:GetAttribute("ChoiceIndex")
		if not index then
			return
		end
		Juice.pulse(button, 0.05)
		Juice.play("choice")
		for _, other in ipairs(ui.call.choiceButtons) do
			other.Visible = false
		end
		Net.event("ChooseOption"):FireServer(index)
	end)
end

ui.operation.close.Activated:Connect(leaveTerminal)

ui.topBar.statsButton.MouseButton1Click:Connect(function()
	task.spawn(function()
		refreshCatalog()
		renderCareer()
		ui.career.frame.Visible = true
	end)
end)

ui.topBar.helpButton.MouseButton1Click:Connect(function()
	ui.help.frame.Visible = true
end)

ui.shop.close.Activated:Connect(leaveTerminal)
ui.store.close.Activated:Connect(leaveTerminal)
ui.career.close.MouseButton1Click:Connect(function()
	ui.career.frame.Visible = false
end)
ui.help.close.MouseButton1Click:Connect(function()
	ui.help.frame.Visible = false
end)
ui.result.close.MouseButton1Click:Connect(function()
	ui.result.frame.Visible = false
end)

--------------------------------------------------------------------------------
-- Timer
--------------------------------------------------------------------------------

task.spawn(function()
	while true do
		task.wait(0.25)
		if ui.topBar.boost.Visible and state.data and state.data.premium then
			state.data.premium.boostRemaining = math.max(0, (state.data.premium.boostRemaining or 0) - 0.25)
			if state.data.premium.boostRemaining <= 0 then
				ui.topBar.boost.Visible = false
			else
				ui.topBar.boost.Text = "Double Shift active - " .. Util.formatTime(state.data.premium.boostRemaining)
			end
		end

		-- The server pushes the operation view every few seconds; between pushes
		-- the client advances heat and credits itself so the meters move
		-- smoothly instead of stepping.
		local view = state.operation
		if view then
			local running = (view.shutdownRemaining or 0) <= 0
			local rate = view.summary.heatRate
			if (view.layLowRemaining or 0) > 0 then
				rate = -(view.summary.heatDecay * 8)
				view.layLowRemaining = math.max(0, view.layLowRemaining - 0.25)
			end
			if (view.shutdownRemaining or 0) > 0 then
				view.shutdownRemaining = math.max(0, view.shutdownRemaining - 0.25)
				rate = -view.summary.heatDecay
			end
			view.heat = math.clamp(view.heat + rate * 0.25, 0, view.heatMax)
			local wallet = state.officeData or state.data
			if running and wallet and (view.layLowRemaining or 0) <= 0 then
				wallet.credits += view.summary.netIncome * 0.25
				ui.topBar.credits.Text = Util.formatNumber(wallet.credits) .. " Office Cr"
			end
			renderOperationHud()
		end

		if state.inCall then
			state.elapsed += 0.25
			ui.call.timer.Text = Util.formatTime(state.elapsed)
			if state.elapsed > Config.Call.FastCallSeconds then
				ui.call.timer.TextColor3 = T.Suspicion
			else
				ui.call.timer.TextColor3 = T.Trust
			end
		end
	end
end)

--------------------------------------------------------------------------------
-- Boot
--------------------------------------------------------------------------------

task.spawn(function()
	local ok, data = pcall(function()
		return Net.func("GetData"):InvokeServer()
	end)
	if ok and data then
		applyData(data)
	end
	refreshCatalog()
	refreshStore()
	refreshOperation()
	Net.event("RequestData"):FireServer()
	toast("Welcome to Your Office", "Use the cyan computer for calls, HR to hire, and the purple lift for leaderboards. Everything here is fictional satire.", "info")
end)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX83">
				<Properties>
					<string name="Name">OfficeSessionUI</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Consent UI and a management-computer access panel. No permanent HUD entry.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared")
local Net = require(Shared.Net)
local Kit = require(script.Parent.UIKit)
local T = Kit.Theme
local OfficeSessionUI = {}

function OfficeSessionUI.init(ui)
	local state, terminalKind = nil, nil
	local render
	local function label(parent, text, y, height)
		return Kit.label({ Text = text, Position = UDim2.new(0, 18, 0, y), Size = UDim2.new(1, -36, 0, height),
			TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, TextSize = 16, ZIndex = 82, Parent = parent })
	end
	local function button(parent, text, x, y, width, callback)
		local b = Kit.button({ Text = text, Position = UDim2.new(0, x, 0, y), Size = UDim2.new(0, width, 0, 42),
			TextSize = 16, BackgroundColor3 = T.AccentDark, ZIndex = 83, Parent = parent })
		b.Activated:Connect(callback)
		return b
	end
	local function panel(name, width, height)
		local backdrop = Kit.new("Frame", { Name = name, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.35, Visible = false, Active = true, ZIndex = 80, Parent = ui.gui })
		local body = Kit.panel({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(width, height), ZIndex = 81, Parent = backdrop })
		local scale = Kit.new("UIScale", { Parent = body })
		local function resize()
			local camera = workspace.CurrentCamera
			if camera then scale.Scale = math.min(1, (camera.ViewportSize.X - 24) / width, (camera.ViewportSize.Y - 40) / height) end
		end
		resize()
		if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resize) end
		return backdrop, body
	end
	local function act(action, a, b) Net.event("OfficeAction"):FireServer(action, a, b) end
	local chooser, choice = panel("OfficeModeChoice", 600, 286)
	label(choice, "YOUR CALL CENTRE", 18, 28).Font = Enum.Font.GothamBold
	label(choice, "Choose how to start this session. Your office is private until someone explicitly accepts your invitation.", 58, 58)
	button(choice, "SOLO", 18, 126, 272, function() act("choose", "solo") end)
	button(choice, "HOST CO-OP", 310, 126, 272, function() act("choose", "coop") end)
	label(choice, "Solo can invite later. Co-op uses the host's progression and save. Guests help with calls; their own money and purchases stay separate. Use Office Management to invite or remove players.", 190, 80)

	local access, accessBody = panel("OfficeAccess", 620, 470)
	label(accessBody, "OFFICE ACCESS", 18, 28).Font = Enum.Font.GothamBold
	button(accessBody, "Close", 500, 12, 100, function() access.Visible = false end)
	local summary = label(accessBody, "", 60, 72)
	local feedback = label(accessBody, "", 132, 26)
	feedback.TextSize = 13
	feedback.TextColor3 = T.Accent
	local list = Kit.new("ScrollingFrame", { Position = UDim2.fromOffset(18, 164), Size = UDim2.new(1, -36, 1, -182),
		BackgroundTransparency = 1, BorderSizePixel = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6, ZIndex = 82, Parent = accessBody })
	Kit.listLayout({ Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }).Parent = list
	local accessButton = button(ui.terminal.frame, "Invite / Access", 0, -50, 150, function()
		access.Visible = true
		task.spawn(function()
			local ok, view = pcall(function() return Net.func("GetOfficeSession"):InvokeServer() end)
			if ok and view then state = view; render() end
		end)
	end)
	accessButton.Visible = false

	local invitation, invitationBody = panel("OfficeInvitation", 560, 244)
	invitation.ZIndex = 90
	local invitationTitle = label(invitationBody, "", 18, 30)
	local invitationNote = label(invitationBody, "", 62, 104)
	local activeInvite
	button(invitationBody, "Accept invite", 18, 180, 250, function()
		if activeInvite then act("respond", activeInvite.id, true) end
	end)
	button(invitationBody, "Decline", 290, 180, 250, function()
		if activeInvite then act("respond", activeInvite.id, false) end
	end)

	render = function()
		if not state then return end
		chooser.Visible = state.needsChoice == true
		summary.Text = string.format("Host: %s | %s\nCalls benefit the host. Only the host spends office credits or uses paid items. Membership lasts for this server session.", state.hostName, state.mode == "coop" and "INVITE-ONLY CO-OP" or "PRIVATE SOLO")
		for _, child in ipairs(list:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
		local order = 0
		local function row(text, actionText, fn)
			order += 1
			local card = Kit.panel({ Size = UDim2.new(1, -8, 0, 52), LayoutOrder = order, ZIndex = 83, Parent = list })
			Kit.label({ Text = text, Position = UDim2.fromOffset(12, 4), Size = UDim2.new(1, -156, 1, -8),
				TextWrapped = true, TextSize = 15, ZIndex = 84, Parent = card })
			if fn then
				local b = button(card, actionText, 0, 5, 126, fn)
				b.AnchorPoint = Vector2.new(1, 0)
				b.Position = UDim2.new(1, -8, 0, 5)
				b.ZIndex = 85
			end
		end
		if state.isHost and state.canManageAccess then
			local isCoopDefault = state.preference == "host_coop"
			row("Office Mode default: " .. (isCoopDefault and "HOST CO-OP" or "SOLO")
				.. " (applies automatically on your next join)", isCoopDefault and "Use Solo" or "Use Co-op",
				function() act("choose", isCoopDefault and "solo" or "coop") end)
		end
		for _, member in ipairs(state.members or {}) do
			local canRemove = state.canManageAccess and member.userId ~= state.hostUserId
			row(member.name .. (member.userId == state.hostUserId and " (HOST)" or " (GUEST)"), "Remove", canRemove and function() act("revoke", member.userId) end or nil)
		end
		if not state.isHost then
			row("Return to your own private office. Your host's progress stays with them.", "Leave co-op", function() act("leave") end)
		elseif state.canManageAccess then
			for _, candidate in ipairs(state.candidates or {}) do
				row("Invite " .. candidate.name, "Invite", function() act("invite", candidate.userId) end)
			end
			if #(state.candidates or {}) == 0 then row("No other eligible players in this server.") end
		else
			row("Use your own physical Office Management computer to invite or revoke access.")
		end
		activeInvite = state.invitations and state.invitations[1]
		invitation.Visible = activeInvite ~= nil
		if activeInvite then
			invitationTitle.Text = activeInvite.hostName .. " invited you"
			invitationNote.Text = string.format("Join their office as a guest? Calls will earn progress for %s. Your own save and purchases will stay separate. You can leave at their management computer.\nInvitation expires in at most %d seconds.", activeInvite.hostName, activeInvite.expiresIn)
		end
	end
	Net.event("Notify").OnClientEvent:Connect(function(payload)
		if payload.title == "Office Access" then feedback.Text = payload.body end
	end)
	Net.event("OfficeSessionUpdated").OnClientEvent:Connect(function(view)
		if view then state = view; render() end
	end)
	Net.event("TerminalOpened").OnClientEvent:Connect(function(payload)
		terminalKind = payload.kind
		feedback.Text = ""
		accessButton.Visible = terminalKind == "management"
		access.Visible = payload.isGuest and terminalKind == "management"
		if accessButton.Visible then
			task.spawn(function()
				local ok, view = pcall(function() return Net.func("GetOfficeSession"):InvokeServer() end)
				if ok and view then state = view; render() end
			end)
		end
	end)
	Net.event("TerminalClosed").OnClientEvent:Connect(function()
		terminalKind = nil
		accessButton.Visible, access.Visible = false, false
	end)
	task.spawn(function()
		for _ = 1, 20 do
			local ok, view = pcall(function() return Net.func("GetOfficeSession"):InvokeServer() end)
			if ok and view then state = view; render(); return end
			task.wait(0.75)
		end
	end)
end

return OfficeSessionUI
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX84">
				<Properties>
					<string name="Name">UIKit</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- UIKit
-- Tiny declarative helpers so Interface.luau can build the whole GUI in code.
-- Nothing in this game needs to be laid out by hand in Studio.

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MacrosoftShared")
local Config = require(Shared.Config)

local UIKit = {}

UIKit.Theme = Config.UI.Theme

-- new("Frame", { Size = ... }, { childA, childB })
function UIKit.new(className: string, props, children)
	local instance = Instance.new(className)
	for key, value in pairs(props or {}) do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	if props and props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function UIKit.corner(radius: number)
	return UIKit.new("UICorner", { CornerRadius = UDim.new(0, radius) })
end

function UIKit.stroke(colour: Color3, thickness: number?, transparency: number?)
	return UIKit.new("UIStroke", {
		Color = colour,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UIKit.gradient(top: Color3, bottom: Color3, rotation: number?)
	return UIKit.new("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = rotation or 90,
	})
end

-- Chunky headline text. Used for anything that should read as a game rather
-- than a spreadsheet.
UIKit.HeadlineFont = Enum.Font.FredokaOne

function UIKit.padding(all: number, extra)
	extra = extra or {}
	return UIKit.new("UIPadding", {
		PaddingTop = UDim.new(0, extra.top or all),
		PaddingBottom = UDim.new(0, extra.bottom or all),
		PaddingLeft = UDim.new(0, extra.left or all),
		PaddingRight = UDim.new(0, extra.right or all),
	})
end

function UIKit.listLayout(props)
	return UIKit.new("UIListLayout", props or {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
	})
end

function UIKit.panel(props, children)
	local merged = {
		BackgroundColor3 = UIKit.Theme.Panel,
		BorderSizePixel = 0,
	}
	for key, value in pairs(props or {}) do
		merged[key] = value
	end
	local frame = UIKit.new("Frame", merged, children)
	UIKit.corner(props and props.CornerRadius or 14).Parent = frame
	return frame
end

function UIKit.label(props)
	local merged = {
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		TextColor3 = UIKit.Theme.Text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		RichText = false,
	}
	for key, value in pairs(props or {}) do
		merged[key] = value
	end
	return UIKit.new("TextLabel", merged)
end

function UIKit.button(props)
	local merged = {
		BackgroundColor3 = UIKit.Theme.PanelLight,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamMedium,
		TextColor3 = UIKit.Theme.Text,
		TextSize = 16,
		AutoButtonColor = false,
	}
	for key, value in pairs(props or {}) do
		merged[key] = value
	end
	local button = UIKit.new("TextButton", merged)
	UIKit.corner(12).Parent = button

	-- Hover reads the colour at hover time rather than at creation time, so a
	-- button that is later restyled (a selected difficulty, an owned upgrade)
	-- does not snap back to its original colour when the mouse leaves.
	local restoreColour: Color3? = nil
	button.MouseEnter:Connect(function()
		if not button.Active or restoreColour then
			return
		end
		restoreColour = button.BackgroundColor3
		UIKit.tween(button, { BackgroundColor3 = button.BackgroundColor3:Lerp(Color3.new(1, 1, 1), 0.12) }, 0.12)
	end)
	button.MouseLeave:Connect(function()
		if restoreColour then
			UIKit.tween(button, { BackgroundColor3 = restoreColour }, 0.12)
			restoreColour = nil
		end
	end)

	return button
end

function UIKit.tween(instance: Instance, goal, duration: number?, style: Enum.EasingStyle?)
	local info = TweenInfo.new(
		duration or Config.UI.TweenTime,
		style or Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	)
	local tween = TweenService:Create(instance, info, goal)
	tween:Play()
	return tween
end

-- A labelled meter with an animated fill.
function UIKit.meter(name: string, colour: Color3, layoutOrder: number)
	local holder = UIKit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		LayoutOrder = layoutOrder,
	})

	local title = UIKit.label({
		Name = "Title",
		Size = UDim2.new(1, 0, 0, 16),
		Text = name,
		TextSize = 13,
		TextColor3 = UIKit.Theme.SubText,
		Parent = holder,
	})

	local valueLabel = UIKit.label({
		Name = "Value",
		Size = UDim2.new(1, 0, 0, 16),
		Text = "0",
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = colour,
		Parent = holder,
	})

	local track = UIKit.new("Frame", {
		Name = "Track",
		Position = UDim2.new(0, 0, 0, 22),
		Size = UDim2.new(1, 0, 0, 12),
		BackgroundColor3 = UIKit.Theme.Background,
		BorderSizePixel = 0,
		Parent = holder,
	})
	UIKit.corner(6).Parent = track

	local fill = UIKit.new("Frame", {
		Name = "Fill",
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = colour,
		BorderSizePixel = 0,
		Parent = track,
	})
	UIKit.corner(6).Parent = fill

	return {
		holder = holder,
		title = title,
		value = valueLabel,
		fill = fill,
		track = track,
	}
end

function UIKit.setMeter(meter, view)
	if not view then
		return
	end
	if view.mode == "hidden" then
		meter.value.Text = "???"
		UIKit.tween(meter.fill, { Size = UDim2.new(1, 0, 1, 0) }, 0.3)
		meter.fill.BackgroundTransparency = 0.75
	elseif view.mode == "vague" then
		meter.value.Text = view.label
		meter.fill.BackgroundTransparency = 0.5
		UIKit.tween(meter.fill, { Size = UDim2.new(0.5, 0, 1, 0) }, 0.3)
	else
		meter.value.Text = view.label
		meter.fill.BackgroundTransparency = 0
		UIKit.tween(meter.fill, { Size = UDim2.new(math.clamp(view.ratio, 0, 1), 0, 1, 0) }, 0.3)
	end
end

-- Fades a frame in or out and flips Visible at the right moment.
function UIKit.setVisible(frame: GuiObject, visible: boolean, slide: boolean?)
	if visible then
		frame.Visible = true
		frame.BackgroundTransparency = frame:GetAttribute("BaseTransparency") or frame.BackgroundTransparency
		if slide then
			frame.Position = frame:GetAttribute("BasePosition") or frame.Position
		end
	else
		frame.Visible = false
	end
end

return UIKit
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
</roblox>
